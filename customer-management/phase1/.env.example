# Copy to .env. Use separate random passwords (at least 12 characters).
CRM_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
CRM_ADMIN_PASSWORD=
CRM_PORT=8087
# true for production HTTPS; false only for local HTTP development
CRM_SECURE_COOKIE=true
# 独立应用入口显式开启自带登录；统一后台部署不使用本 compose（见宝塔版上线手册）
CRM_STANDALONE_ENABLED=true
WECOM_CORP_ID=
WECOM_CONTACT_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=
