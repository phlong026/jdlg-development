page{background:#f8f5ef;color:#2f241a}.page{min-height:100vh;padding:28rpx 28rpx 120rpx;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.header{padding:22rpx 4rpx 30rpx}.step-label{display:block;color:#897b6e;font-size:24rpx;margin-top:12rpx}.title{font-size:42rpx;font-weight:650}.card{background:#fff;border:1rpx solid #e9dfd2;border-radius:24rpx;margin-bottom:24rpx;padding:28rpx;box-shadow:0 8rpx 28rpx rgba(73,48,25,.035)}.section-title,.row-title{display:block;font-size:29rpx;font-weight:600}.group-title{display:block;margin-top:24rpx;padding-bottom:8rpx;color:#9b7148;font-size:22rpx}.pick-row{display:flex;align-items:center;justify-content:space-between;width:100%;padding:24rpx 0;border-bottom:1rpx solid #eee7de;text-align:left;background:#fff}.pick-row:last-child{border-bottom:0}.pick-row.selected .row-title{color:#8b6035}.member-profile,.summary-member{display:flex;align-items:center;gap:16rpx}.member-avatar{width:64rpx;height:64rpx;border-radius:50%;background:#eee5d9;flex:none}.member-avatar.small{width:48rpx;height:48rpx}.avatar-placeholder{display:flex;align-items:center;justify-content:center;color:#875f38;font-size:23rpx;font-weight:600}.check{width:42rpx;height:42rpx;border:1rpx solid #cfb99e;border-radius:50%;color:#fff;text-align:center;line-height:42rpx}.selected .check{background:#9f7140;border-color:#9f7140}.meta{display:block;color:#897b6e;font-size:23rpx;margin-top:7rpx}.empty,.state{padding:70rpx 20rpx;text-align:center;color:#817469}.primary,.secondary,.text-button{margin-top:18rpx;padding:20rpx 24rpx;border-radius:14rpx;font-size:27rpx}.primary{background:#9f7140;color:#fff}.secondary{border:1rpx solid #b28a60;color:#80572f;background:#fff}.text-button{background:transparent;color:#8b6035}.summary-label{display:block;color:#9b7148;font-size:22rpx;margin:28rpx 0 6rpx}.summary-row{display:block;font-size:27rpx;line-height:1.8}.summary-member{padding:6rpx 0}.done{text-align:center;padding:64rpx 28rpx}.done-mark{display:block;width:86rpx;height:86rpx;line-height:86rpx;border-radius:50%;margin:0 auto 24rpx;background:#9f7140;color:#fff;font-size:44rpx}.notice{margin-top:20rpx;padding:20rpx 24rpx;border-radius:14rpx;background:#fff6e6;color:#855820;font-size:24rpx}.history{margin-top:30rpx}.history-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #eee7de}.history-row:last-of-type{border-bottom:0}.danger-link{flex:none;margin:0;padding:12rpx 8rpx;background:transparent;color:#a54d3d;font-size:24rpx}.status{flex:none;color:#8b8075;font-size:23rpx}

button{width:100%;box-sizing:border-box;margin-left:0;margin-right:0;font-weight:400;line-height:1.5}button::after{border:0}.pick-row{border-radius:0;white-space:normal;color:inherit}.pick-row>view:first-child{flex:1;min-width:0;padding-right:20rpx}.check{flex:none}.primary[disabled]{background:#e5ddd2;color:#8b8075}.empty-state{text-align:center;padding:80rpx 32rpx;color:#817469;font-size:28rpx}.empty-state .secondary{width:auto;display:inline-block;margin-top:28rpx}.empty-members{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:18rpx}.empty-members .text-button,.danger-link{width:auto;margin:0;flex:none}.header .title{display:block;font-size:36rpx;line-height:1.4;word-break:break-all}
