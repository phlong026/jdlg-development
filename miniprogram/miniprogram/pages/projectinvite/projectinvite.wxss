page{background:#f8f5ef;color:#2f241a}.page{min-height:100vh;padding:52rpx 28rpx;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.state{text-align:center;padding:220rpx 30rpx;color:#817469}.card{margin:100rpx auto 0;max-width:620rpx;padding:52rpx 38rpx;background:#fff;border:1rpx solid #e9dfd2;border-radius:28rpx;box-shadow:0 12rpx 34rpx rgba(73,48,25,.05);text-align:center}.mark{width:88rpx;height:88rpx;margin:0 auto 28rpx;border-radius:50%;background:#efe2d1;color:#8b6035;font-size:42rpx;line-height:88rpx;font-weight:600}.title,.done-title{display:block;font-size:38rpx;font-weight:650}.subtitle{display:block;margin-top:14rpx;color:#897b6e;font-size:25rpx}.primary{margin-top:42rpx;padding:22rpx 28rpx;border-radius:16rpx;background:#9f7140;color:#fff;font-size:28rpx}.state .primary{width:260rpx;margin:30rpx auto}.done-icon{display:block;width:70rpx;height:70rpx;margin:0 auto 24rpx;border-radius:50%;background:#9f7140;color:#fff;font-size:36rpx;line-height:70rpx}.error{display:block;margin-top:24rpx;color:#963d35;font-size:24rpx}
