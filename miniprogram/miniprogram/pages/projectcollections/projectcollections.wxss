.sort-actions .cover-on {
  background: #f1e4d2;
  color: #8b5c2d;
  border-color: #a87943;
}

.work-cover{flex:none;width:112rpx;height:96rpx;border-radius:12rpx;background:#eee7dd}
.work-title{display:block;font-size:28rpx;line-height:1.45;word-break:break-all}
.selected-row{padding:24rpx 0;border-top:1rpx solid #f0ebe4}
.selected-summary{display:flex;align-items:center;gap:16rpx}
.sort-actions{justify-content:flex-end;margin-top:18rpx;gap:10rpx}
.page .sort-actions button{padding:0 14rpx;background:transparent;color:#76685a}
.page .sort-actions button[disabled]{color:#c4bdb5}
.page .sort-actions .cover-on{background:#f1e8da;color:#8d683b}
.check{box-sizing:border-box;border:2rpx solid #d8c9b7;background:#fff;border-radius:10rpx}
.check.checked{background:#a87943;border-color:#a87943;color:#fff}
.preview-header{display:flex;align-items:center;justify-content:space-between;padding:26rpx 28rpx;font-size:28rpx;font-weight:600}
.preview-header .meta{margin:0;font-weight:400}
.preview-content{height:60vh}
.preview-hero{position:relative;margin:0 28rpx;min-height:320rpx;border-radius:20rpx;overflow:hidden;background:#eee7dd}
.preview-hero-image{position:absolute;inset:0;width:100%;height:100%}
.preview-hero-text{position:relative;min-height:320rpx;box-sizing:border-box;padding:160rpx 28rpx 28rpx;display:flex;flex-direction:column;justify-content:flex-end;color:#fff;background:linear-gradient(180deg,transparent 15%,rgba(38,29,20,.76))}
.preview-description{display:block;margin-top:12rpx;font-size:26rpx;line-height:1.6;word-break:break-all}
.no-cover{min-height:0;background:#fff;border:1rpx solid #eee7dd}
.no-cover .preview-hero-text{min-height:0;padding:30rpx 28rpx;color:#352e27;background:none}
.no-cover .preview-description{color:#7b6d5f}
.preview-directory{margin:20rpx 28rpx 28rpx;padding:0 24rpx;background:#fff;border:1rpx solid #eee7dd;border-radius:20rpx}
.preview-directory .preview-row:first-child{border-top:0}
