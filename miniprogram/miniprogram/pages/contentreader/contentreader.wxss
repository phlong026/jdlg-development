@import "../../components/content-presentation/content-presentation.wxss";

page {
  background: #f7f5f1;
  color: #2d231d;
}

.reader {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: 0 18px calc(env(safe-area-inset-bottom) + 112px);
  overflow-wrap: anywhere;
}

.reader-navigation {
  display: block;
  margin: 0 -18px 12px;
}

.article-header {
  padding: 24px 0 18px;
}

.title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 29px;
  font-weight: 600;
  line-height: 1.38;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 10px;
  margin-top: 10px;
  color: #897c70;
  font-size: 12px;
  line-height: 1.6;
}

.article-paper {
  padding: 1px 0;
  background: #fff;
}

.article-paper-video {
  margin: 0 -18px;
  padding: 0;
  background: transparent;
}

.article-paper-video .content-video {
  border-radius: 0;
}

.body {
  display: block;
  white-space: pre-wrap;
  font-size: 17px;
  line-height: 1.9;
  max-width: 100%;
}

.media-frame {
  width: 100%;
  margin: 20px 0;
}

.media-image, .media-video {
  display: block;
  width: 100%;
  background: #eee9e1;
}

.notice {
  padding: 15px;
  margin: 20px 0 0;
  border: 1px solid #e9dfd2;
  border-radius: 12px;
  background: #fffaf3;
  color: #66594d;
  font-size: 13px;
  line-height: 1.65;
}

.consent-settings {
  width: auto;
  min-height: 32px;
  margin: 14px 0 0 auto;
  padding: 0;
  background: transparent;
  color: #8c8177;
  font-size: 12px;
  line-height: 32px;
}

.notice-title {
  display: block;
  margin-bottom: 4px;
  color: #3d3229;
  font-weight: 600;
}

.notice-caption, .limits {
  display: block;
  margin-top: 10px;
  color: #8a7f74;
  font-size: 11px;
  line-height: 1.65;
}

.notice-actions {
  display: flex;
  gap: 10px;
}

.notice button {
  min-height: 36px;
  flex: 1;
  margin-top: 10px;
  font-size: 13px;
}

.state {
  padding: 60px 16px;
  text-align: center;
  line-height: 1.8;
}

.state button {
  margin: 18px auto 0;
}

.error {
  display: block;
  margin: 8px 0;
  color: #a83227;
  font-size: 14px;
}

.source-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-top: 28px;
  padding: 16px 0;
  border-top: 1px solid #ece4db;
  border-bottom: 1px solid #ece4db;
}

.source-card > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4px;
}

.source-label {
  color: #93877b;
  font-size: 12px;
}

.source-value {
  font-size: 14px;
}

.source-action {
  flex-shrink: 0;
  white-space: nowrap;
  min-width: 88px;
  width: auto;
  min-height: 34px;
  margin: 0;
  padding: 0 14px;
  border: 1px solid #d7c0a5;
  background: #fff;
  color: #94643a;
  font-size: 12px;
}

.reader-actions {
  position: fixed;
  z-index: 20;
  bottom: 0;
  display: flex;
  gap: 10px;
  left: 0;
  right: 0;
  margin: 0;
  padding: 12px 18px calc(12px + env(safe-area-inset-bottom));
  border-top: 1px solid #e8e0d8;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -5px 18px rgba(65, 43, 26, 0.08);
}

.reader-actions button {
  display: flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin: 0;
  border-radius: 10px;
  font-size: 14px;
}

.copy-action {
  flex: 1;
  border: 1px solid #a87943;
  background: #fff;
  color: #8c5e32;
}

.share-action {
  flex: 1.35;
  background: #a87943;
  color: #fff;
}

.poster-action {
  flex: .8;
  border: 1px solid #e2d5c7;
  background: #fff;
  color: #6f6257;
}

.more-action {
  flex: .8;
  border: 1px solid #e2d5c7;
  background: #fff;
  color: #6f6257;
}

.action-icon {
  font-size: 19px;
}

.primary {
  background: #a87943;
  color: #fff;
}

.secondary {
  border: 1px solid #a87943;
  background: #fff;
  color: #8c5e32;
}

button::after {
  border: 0;
}

.reader-guide {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 18px;
  padding: 12px 14px;
  border: 1px solid #e5ded4;
  border-radius: 12px;
  background: #faf6ef;
}

.reader-guide-text {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 3px;
}

.reader-guide-title {
  line-height: 1.6;
  color: #3d3226;
  font-size: 15px;
  font-weight: 600;
}

.reader-guide-sub {
  line-height: 1.6;
  color: #8a7d6d;
  font-size: 12px;
}

.reader-guide .reader-guide-cta {
  width: auto;
  flex-shrink: 0;
  min-height: 32px;
  margin: 0;
  padding: 0 16px;
  border-radius: 999px;
  background: #a87943;
  color: #fff;
  font-size: 13px;
  line-height: 32px;
}

.reader-guide .reader-guide-close {
  width: 32px;
  flex: none;
  min-height: 32px;
  margin: 0;
  padding: 0 8px;
  background: transparent;
  color: #b0a494;
  font-size: 15px;
  line-height: 32px;
}

.article-block {
  box-sizing: border-box;
  max-width: 100%;
  margin: 18px 0;
  font-size: 17px;
  line-height: 1.9;
  white-space: pre-wrap;
}

.article-layout {
  display: block;
  box-sizing: border-box;
  max-width: 100%;
  font-size: 17px;
  line-height: 1.9;
  overflow-wrap: anywhere;
}

.article-layout-native {
  box-sizing: border-box;
  max-width: 100%;
  margin: 18px 0;
}

.article-heading {
  margin-top: 30px;
  font-family: "Songti SC", "STSong", serif;
  font-size: 23px;
  font-weight: 600;
  line-height: 1.5;
  color: #36271e;
}

.article-heading-3 {
  font-size: 20px;
}

.article-heading.article-size-small {
  font-size: 19px;
}

.article-heading.article-size-large {
  font-size: 25px;
}

.article-quote {
  padding: 12px 16px;
  border-left: 3px solid #a87943;
  background: #f8f3ed;
  color: #5f574d;
}

.article-list-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin: 8px 0;
}

.article-list-marker {
  min-width: 18px;
  flex: none;
  color: #a87943;
}

.article-image, .article-video {
  width: 100%;
  margin: 22px 0;
}

.article-caption {
  display: block;
  margin-top: 8px;
  text-align: center;
  color: #716a61;
  font-size: 13px;
  line-height: 1.6;
}

.article-align-left {
  text-align: left;
}

.article-align-center {
  text-align: center;
}

.article-align-right {
  text-align: right;
}

.article-size-small {
  font-size: 14px;
}

.article-size-normal {
  font-size: 17px;
}

.article-size-large {
  font-size: 20px;
}

.article-border-left {
  padding-left: 14px;
  border-left: 3px solid #a87943;
}

.article-border-box {
  padding: 14px;
  border: 1px solid #d8cbb9;
  border-radius: 8px;
}

.poster-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.poster-canvas {
  pointer-events: none;
}

.annotate-hint { padding: 16rpx 24rpx; margin: 12rpx 0; background: #f8f0e2; border-radius: 10rpx; color: #9a6835; font-size: 24rpx; }

button:not([size='mini']) { width: auto; min-width: 0; box-sizing: border-box; }
.reader-actions { display: grid; grid-template-columns: 1fr 1.4fr 1fr; gap: 10rpx; }
.reader-actions-two { grid-template-columns: 1fr 1.4fr; }
.video-reader-actions { grid-template-columns: 1.25fr 1fr .75fr; }
.reader-actions button { width: 100%; min-height: 88rpx; margin: 0; padding: 12rpx 8rpx; font-size: 25rpx; line-height: 1.4; }
.reader-actions .action-icon { display: inline-block; flex:none; }
.article-header .meta { flex-wrap: wrap; }

/* Note controls live below the native capsule, in normal document flow. */
.note-toolbar {
  position:relative;
  z-index:20;
  display:flex;
  justify-content:flex-end;
  align-items:center;
  gap:8px;
  min-height:44px;
  margin:0 -18px;
  padding:0 16px;
  background:#fff
}


.reader .note-toolbar .note-toolbar-action {
  display:flex;
  flex:0 0 40px;
  width:40px;
  max-width:40px;
  min-width:40px;
  height:36px;
  min-height:36px;
  align-items:center;
  justify-content:center;
  margin:0;
  padding:0;
  border:0;
  border-radius:8px;
  background:transparent;
  color:#3b2c22;
  font-size:21px;
  letter-spacing:2px;
  line-height:1
}


.note-toolbar-action::after,.note-menu-item::after,.note-dock-action::after,.note-text-button::after,.note-comment-entry::after {
  border:0
}


.note-toolbar-action.is-active {
  background:#f0e2cf;
  color:#956936
}

.note-toolbar-icon {
  display:block;
  flex:none
}


.note-menu-dismiss {
  position:fixed;
  z-index:21;
  inset:0;
  background:transparent
}

.note-menu {
  position:absolute;
  z-index:22;
  right:16px;
  top:46px;
  width:214px;
  padding:8px 12px;
  border:1px solid #eee6dc;
  border-radius:13px;
  background:#fff;
  box-shadow:0 7px 26px rgba(48,35,23,.16)
}


.note-menu::before {
  position:absolute;
  right:13px;
  top:-6px;
  width:10px;
  height:10px;
  transform:rotate(45deg);
  background:#fff;
  border-top:1px solid #eee6dc;
  border-left:1px solid #eee6dc;
  content:''
}


.note-menu-item {
  display:flex;
  align-items:center;
  gap:17px;
  min-height:45px;
  width:100%;
  margin:0;
  padding:0 10px;
  border:0;
  border-radius:0;
  background:#fff;
  color:#2c2723;
  font-size:16px;
  line-height:1.4;
  text-align:left;
  white-space:nowrap
}

.note-menu-item.has-divider {
  margin-top:6px;
  padding-top:6px;
  border-top:1px solid #eee6dc
}

.note-menu-item.is-danger {
  color:#b3483e
}


.note-menu-icon {
  display:block;
  flex:none;
  color:#956936
}

.is-danger .note-menu-icon {
  color:#b3483e
}

.article-paper-gallery {
  margin:0 -18px
}

.article-paper-gallery .presentation-note-copy {
  padding:22px 18px 10px
}

.reader .presentation-title {
  font-family:inherit;
  font-size:23px;
  font-weight:650;
  line-height:1.5
}

.reader .presentation-body {
  font-size:16px;
  line-height:1.85;
  white-space:pre-wrap
}

.reader .presentation-meta {
  margin-top:9px;
  font-size:12px
}

.reader .presentation-gallery-count {
  top:auto;
  bottom:12px
}


.note-topics {
  display:flex;
  gap:12px;
  flex-wrap:wrap;
  padding:10px 0 19px;
  color:#a87943;
  font-size:14px
}

.note-comments {
  padding:21px 0 12px;
  border-top:1px solid #eee6dc;
  margin-top:18px
}

.note-comments-head,.note-sheet-head {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  font-size:17px;
  font-weight:600
}

.note-text-button {
  display:inline-flex;
  width:auto;
  min-height:34px;
  margin:0;
  padding:4px 8px;
  align-items:center;
  border:0;
  background:transparent;
  color:#8e744f;
  font-size:13px;
  line-height:1.4
}

.note-muted {
  display:block;
  padding:10px 0;
  color:#94877a;
  font-size:13px;
  line-height:1.6
}

.note-comment {
  display:flex;
  gap:11px;
  padding:18px 0;
  border-bottom:1px solid #f1ece6
}

.note-comment:last-child {
  border:0
}

.note-avatar {
  flex:none;
  width:36px;
  height:36px;
  border-radius:50%;
  background:#eee6dc
}

.note-avatar-placeholder {
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:14px;
  color:#8e744f
}

.note-comment-copy {
  min-width:0;
  flex:1
}

.note-comment-author {
  display:block;
  font-size:14px;
  font-weight:600;
  color:#695d52
}

.note-comment-text {
  display:block;
  margin-top:6px;
  white-space:pre-wrap;
  overflow-wrap:anywhere;
  font-size:15px;
  line-height:1.7
}

.note-comment-meta {
  display:flex;
  align-items:center;
  gap:8px;
  margin-top:6px;
  font-size:11px;
  color:#a4988d
}

.note-load-more {
  width:auto;
  min-height:38px;
  background:transparent;
  color:#9a7548;
  font-size:13px
}

.note-interaction-error {
  display:block;
  padding:8px 0;
  color:#a3463c;
  font-size:13px;
  line-height:1.6
}


.note-interaction-dock {
  position:fixed;
  z-index:25;
  left:0;
  right:0;
  bottom:0;
  display:flex;
  align-items:center;
  gap:14px;
  padding:10px 18px calc(10px + env(safe-area-inset-bottom));
  border-top:1px solid #eee6dc;
  background:rgba(255,255,255,.98)
}

.note-comment-entry {
  display:flex;
  align-items:center;
  gap:8px;
  flex:1;
  min-width:0;
  min-height:38px;
  margin:0;
  padding:8px 14px;
  border-radius:24px;
  background:#f3f0ec;
  color:#9d8f81;
  font-size:14px;
  text-align:left;
  line-height:1.5
}

.note-entry-icon {
  display:block;
  flex:none
}

.note-dock-action {
  display:flex;
  flex:none;
  min-width:36px;
  min-height:44px;
  margin:0;
  padding:0;
  align-items:center;
  flex-direction:column;
  justify-content:center;
  border:0;
  background:transparent;
  color:#332a24;
  font-size:10px;
  line-height:1.3
}

.note-dock-action.is-active {
  color:#a87943
}

.note-dock-action[disabled] {
  background:transparent;
  color:#a99d90
}

.note-dock-icon {
  display:block;
  flex:none;
  margin:2px 0 4px
}

.note-modal-mask {
  position:fixed;
  inset:0;
  z-index:40;
  display:flex;
  align-items:flex-end;
  background:rgba(35,27,20,.26)
}

.note-composer,.note-collection-sheet {
  width:100%;
  max-height:78vh;
  box-sizing:border-box;
  padding:20px 20px calc(20px + env(safe-area-inset-bottom));
  border-radius:18px 18px 0 0;
  background:#fff
}

.note-composer textarea {
  width:100%;
  min-height:140px;
  max-height:240px;
  box-sizing:border-box;
  padding:16px 0;
  font-size:16px;
  line-height:1.7
}

.note-collection-list {
  max-height:38vh;
  margin:10px 0
}

.note-collection-row {
  display:flex;
  align-items:center;
  justify-content:space-between;
  width:100%;
  padding:16px 0;
  margin:0;
  border-radius:0;
  border-bottom:1px solid #eee6dc;
  background:#fff;
  font-size:15px;
  text-align:left
}

.note-collection-sheet input {
  box-sizing:border-box;
  min-height:44px;
  padding:8px 12px;
  border:1px solid #e6ddd2;
  border-radius:8px;
  margin:12px 0
}

.note-sheet-head .note-text-button {
  font-weight:400
}


@media(max-width:360px) {
  .note-interaction-dock {
  gap:10px;
  padding-left:14px;
  padding-right:14px
}

.reader .presentation-title {
  font-size:21px
}

.note-menu {
  right:12px;
  width:200px
}


}
