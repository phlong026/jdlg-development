page{background:#faf8f4;color:#302c27}.reader{box-sizing:border-box;width:100%;padding:calc(env(safe-area-inset-top) + 20px) 20px calc(env(safe-area-inset-bottom) + 32px);overflow-wrap:anywhere}.navigation{display:flex;align-items:center;gap:16px;margin-bottom:24px}.navigation button{margin:0;font-size:14px;min-height:44px}.title{font-size:26px;font-weight:600;line-height:1.45}.meta,.source{font-size:13px;color:#716a61;line-height:1.7;margin:12px 0 22px}.body{display:block;white-space:pre-wrap;font-size:17px;line-height:1.85;max-width:100%}.media-frame{width:100%;margin:20px 0}.media-image{width:100%;display:block;background:#eee9e1}.notice{padding:16px;margin:20px 0;background:#eee9df;border-radius:12px;font-size:14px;line-height:1.7}.notice-caption,.limits{display:block;font-size:12px;color:#736a5e;margin-top:12px}.notice button,button{min-height:44px;margin-top:12px;white-space:normal;font-size:15px}.state{padding:48px 0;line-height:1.8}.error{display:block;color:#a83227;font-size:14px;margin:8px 0}
