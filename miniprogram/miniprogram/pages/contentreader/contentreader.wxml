<block wx:if="{{__profileAccessMounted}}">
<view class="reader">
 <navigation-bar class="reader-navigation" title="内容阅读" back="{{true}}" background="#f7f5f1" />
 <view wx:if="{{loading}}" class="state" role="status">正在加载内容…</view>
 <view wx:elif="{{error && !contentReady}}" class="state"><text>{{error}}</text><button class="secondary" bindtap="loadContent">重试</button></view>
 <block wx:elif="{{contentReady}}">
  <view wx:if="{{presentationView.kind !== 'video'}}" class="note-toolbar">
   <button class="note-toolbar-action" open-type="share" aria-label="分享笔记"><mini-icon name="share-up" size="24px" /></button>
   <button class="note-toolbar-action {{noteMenuOpen ? 'is-active' : ''}}" bindtap="openNoteMore" loading="{{noteActionBusy}}" disabled="{{noteActionBusy}}" aria-label="更多操作"><mini-icon name="more" size="25px" /></button>
   <block wx:if="{{noteMenuOpen}}"><view class="note-menu-dismiss" bindtap="closeNoteMore"></view><view class="note-menu" catchtap="keepNoteMenuOpen"><button wx:for="{{noteMenu}}" wx:key="key" class="note-menu-item {{item.divider ? 'has-divider' : ''}} {{item.danger ? 'is-danger' : ''}}" data-key="{{item.key}}" bindtap="selectNoteMenu"><mini-icon class="note-menu-icon" name="{{item.icon}}" size="19px" /><text>{{item.label}}</text></button></view></block>
  </view>
  <view wx:if="{{error}}" class="error"><text>{{error}}</text><button class="secondary" bindtap="loadContent">重试</button></view>
  <view class="article-paper article-paper-{{presentationView.kind}}"><template is="content-presentation" data="{{view: presentationView, tracking: true, mediaErrors: mediaErrors, videoStarted: videoStarted}}"/></view>

  <view wx:if="{{presentationView.kind !== 'video'}}" class="note-comments" id="note-comments"><view class="note-comments-head"><text>评论{{commentCount !== null ? ' ' + commentCount : ''}}</text><button wx:if="{{!interactionLoading}}" bindtap="loadNoteInteractions" class="note-text-button">刷新</button></view>
   <text wx:if="{{interactionLoading && !comments.length}}" class="note-muted">正在加载评论…</text>
   <view wx:if="{{interactionError}}" class="note-interaction-error"><text>{{interactionError}}</text><button class="note-text-button" bindtap="loadNoteInteractions">重试</button></view>
   <text wx:elif="{{interactionAvailable && !comments.length}}" class="note-muted">还没有评论，来说说你的想法</text>
   <view wx:for="{{comments}}" wx:key="comment_id" class="note-comment"><image wx:if="{{item.author.avatar}}" src="{{item.author.avatar}}" class="note-avatar" mode="aspectFill"/><view wx:else class="note-avatar note-avatar-placeholder">{{item.author.nickname ? item.author.nickname[0] : '访'}}</view><view class="note-comment-copy"><text class="note-comment-author">{{item.author.nickname || '用户'}}</text><text class="note-comment-text" selectable="{{true}}">{{item.text}}</text><view class="note-comment-meta"><text>{{item.created_label || item.created_at}}</text><button wx:if="{{item.mine}}" class="note-text-button" data-comment-id="{{item.comment_id}}" bindtap="deleteNoteComment">删除</button></view></view></view>
   <button wx:if="{{commentHasMore}}" class="note-load-more" bindtap="loadMoreNoteComments" loading="{{interactionLoading}}" disabled="{{interactionLoading}}">查看更多评论</button>
  </view>

  <view wx:if="{{consentAvailable && consentChoicePending}}" class="notice"><text class="notice-title">是否开启访问分析？</text><text>{{consentNotice}}</text><text class="notice-caption">访问分析默认开启，可在设置中关闭，关闭后不再记录。</text><view class="notice-actions"><button class="primary" bindtap="acceptTracking">同意开启</button><button class="secondary" bindtap="declineTracking">保持关闭</button></view></view>
  <view wx:elif="{{consentUnavailable}}" class="notice"><text>访问分析暂不可用，不影响阅读。</text></view>

  <view wx:if="{{presentationView.kind === 'video'}}" class="reader-actions video-reader-actions"><button class="share-action" open-type="share"><text class="action-icon">↗</text><text>分享给好友</text></button><button class="copy-action" bindtap="copyVideoCopy"><text class="action-icon">⌘</text><text>复制文案</text></button><button class="more-action" bindtap="openVideoMore"><text class="action-icon">•••</text><text>更多</text></button></view>
  <view wx:else class="note-interaction-dock"><button class="note-comment-entry" bindtap="openCommentComposer" disabled="{{!interactionAvailable}}"><mini-icon name="edit" size="18px" /><text>说点什么…</text></button><button class="note-dock-action {{liked ? 'is-active' : ''}}" bindtap="toggleNoteLike" disabled="{{interactionBusy || !interactionAvailable}}" aria-label="{{liked ? '取消点赞' : '点赞'}}"><mini-icon name="{{liked ? 'heart-filled' : 'heart'}}" size="25px" /><text>{{likeCount > 0 ? likeCount : '赞'}}</text></button><button class="note-dock-action {{favorited ? 'is-active' : ''}}" bindtap="toggleNoteFavorite" disabled="{{interactionBusy || !interactionAvailable}}" aria-label="{{favorited ? '取消收藏' : '收藏'}}"><mini-icon name="{{favorited ? 'star-filled' : 'star'}}" size="25px" /><text>{{favoriteCount > 0 ? favoriteCount : '收藏'}}</text></button><button class="note-dock-action" bindtap="scrollToNoteComments" aria-label="查看评论"><mini-icon name="comment" size="25px" /><text>{{commentCount > 0 ? commentCount : '评论'}}</text></button></view>
  <view wx:if="{{commentComposerOpen}}" class="note-modal-mask" bindtap="closeCommentComposer"><view class="note-composer" catchtap="keepNoteMenuOpen"><view class="note-sheet-head"><text>写评论</text><button class="note-text-button" bindtap="closeCommentComposer">关闭</button></view><textarea value="{{commentText}}" bindinput="setCommentText" maxlength="500" auto-focus="{{true}}" adjust-position="{{true}}" cursor-spacing="100" placeholder="说说你的想法，最多500字"/><text wx:if="{{interactionError}}" class="note-interaction-error">{{interactionError}}</text><text class="note-muted">评论将随当前笔记版本公开展示</text><button class="primary" bindtap="submitNoteComment" loading="{{commentSubmitting}}" disabled="{{commentSubmitting || !commentText}}">发送评论</button></view></view>
  <view wx:if="{{collectionsOpen}}" class="note-modal-mask" bindtap="closeNoteCollections"><view class="note-collection-sheet" catchtap="keepNoteMenuOpen"><view class="note-sheet-head"><text>加入合集</text><button class="note-text-button" bindtap="closeNoteCollections">关闭</button></view><text class="note-muted">保存到合集草稿，发布后生效</text><scroll-view scroll-y="{{true}}" class="note-collection-list"><button wx:for="{{noteCollections}}" wx:key="collection_id" class="note-collection-row" data-id="{{item.collection_id}}" bindtap="addNoteCollection" disabled="{{noteActionBusy}}">{{item.title}}<text>＋</text></button><button wx:if="{{noteCollectionCursor}}" class="note-text-button" bindtap="loadMoreNoteCollections" disabled="{{noteActionBusy}}">加载更多</button></scroll-view><input value="{{noteCollectionTitle}}" bindinput="setNoteCollectionTitle" maxlength="80" placeholder="新建合集名称"/><text wx:if="{{noteCollectionError}}" class="note-interaction-error">{{noteCollectionError}}</text><button class="primary" bindtap="addNoteCollection" disabled="{{noteActionBusy || !noteCollectionTitle}}" loading="{{noteActionBusy}}">新建并加入</button></view></view>
  <canvas type="2d" id="posterCanvas" class="poster-canvas" style="position:fixed;left:-9999px;top:-9999px;width:750px;height:1000px;"></canvas>
 </block>

</view>

<!-- content-presentation:generated:start -->
<template name="content-presentation">
 <view class="content-presentation content-presentation-{{view.kind}}">
  <block wx:if="{{view.kind === 'gallery'}}">
   <view class="presentation-media presentation-gallery" style="height:{{view.galleryHeight}}px">
    <swiper current="{{view.galleryIndex}}" style="height:{{view.galleryHeight}}px" data-tracking="{{tracking}}" bindchange="onContentGalleryChange">
     <swiper-item wx:for="{{view.media}}" wx:key="key">
      <view class="presentation-gallery-slide">
       <image class="presentation-gallery-image" style="width:{{item.width}}px;height:{{item.height}}px" src="{{item.url}}" mode="aspectFit" lazy-load="{{true}}" aria-label="{{item.caption || view.title}}" data-media-id="{{item.media_id}}" data-error-key="{{item.errorKey}}" data-tracking="{{tracking}}" bindtap="openImage" bindload="onContentVideoMetadata" binderror="mediaError" />
      </view>
     </swiper-item>
    </swiper>
    <text wx:if="{{view.media.length > 1}}" class="presentation-gallery-count">{{view.galleryIndex + 1}}/{{view.media.length}}</text>
   </view>
   <text wx:if="{{view.media[view.galleryIndex].caption}}" class="presentation-media-caption" selectable="{{true}}">{{view.media[view.galleryIndex].caption}}</text>
   <view wx:if="{{mediaErrors[view.media[view.galleryIndex].errorKey]}}" class="presentation-media-error"><text>{{mediaErrors[view.media[view.galleryIndex].errorKey]}}</text><button data-media-id="{{view.media[view.galleryIndex].media_id}}" data-error-key="{{view.media[view.galleryIndex].errorKey}}" bindtap="retryMedia">重新加载</button></view>
  </block>

  <block wx:elif="{{view.kind === 'video'}}">
   <view class="content-video content-video-{{view.videoLayout}}">
    <view class="presentation-video-brand"><text class="presentation-video-brand-mark">甲</text><text>甲第灵光</text><text class="presentation-video-brand-type">{{view.videoLayout === 'douyin' ? '沉浸视频' : '视频号作品'}}</text></view>
    <view wx:if="{{view.media[0]}}" class="presentation-media presentation-video-shell" style="width:{{view.media[0].width}}px;height:{{view.media[0].height}}px">
     <view wx:if="{{view.poster && !videoStarted[view.media[0].playerKey]}}" class="presentation-video-poster" data-dom-id="{{view.media[0].domId}}" data-player-key="{{view.media[0].playerKey}}" bindtap="playContentVideo">
      <image src="{{view.poster}}" mode="aspectFill" />
      <text class="presentation-video-play" aria-label="播放视频">▶</text>
     </view>
     <video wx:else id="{{view.media[0].domId}}" class="presentation-video" style="width:{{view.media[0].width}}px;height:{{view.media[0].height}}px" src="{{view.media[0].url}}" poster="{{view.nativePoster}}" autoplay="{{videoStarted[view.media[0].playerKey]}}" controls object-fit="contain" data-media-id="{{view.media[0].media_id}}" data-player-key="{{view.media[0].playerKey}}" data-error-key="{{view.media[0].errorKey}}" data-tracking="{{tracking}}" bindplay="videoState" bindpause="videoState" bindended="videoState" bindwaiting="videoState" binderror="videoState" bindloadedmetadata="onContentVideoMetadata" bindtimeupdate="videoProgress" bindratechange="videoRate" bindfullscreenchange="videoFullscreen" />
    </view>
    <view wx:if="{{view.media[0] && mediaErrors[view.media[0].errorKey]}}" class="presentation-media-error"><text>{{mediaErrors[view.media[0].errorKey]}}</text><button data-media-id="{{view.media[0].media_id}}" data-error-key="{{view.media[0].errorKey}}" bindtap="retryMedia">重新加载</button></view>
    <view class="presentation-note-copy presentation-video-copy">
     <view wx:if="{{view.title}}" class="presentation-title" selectable="{{true}}">{{view.title}}</view>
     <text wx:if="{{view.bodyText}}" class="presentation-body {{view.descriptionExpanded ? 'is-expanded' : ''}}" selectable="{{true}}">{{view.bodyText}}</text>
     <button wx:if="{{view.bodyExpandable}}" class="presentation-copy-toggle" bindtap="toggleContentDescription">{{view.descriptionExpanded ? '收起' : '展开全文'}}</button>
     <view wx:if="{{view.sourceNote || view.publishedAt}}" class="presentation-meta"><text>{{view.sourceNote}}</text><text>{{view.publishedAt}}</text></view>
    </view>
   </view>
  </block>

  <view wx:if="{{view.kind === 'gallery'}}" class="presentation-note-copy">
   <view wx:if="{{view.title}}" class="presentation-title" selectable="{{true}}">{{view.title}}</view>
   <text wx:if="{{view.bodyText}}" class="presentation-body" selectable="{{true}}">{{view.bodyText}}</text>
   <view wx:if="{{view.sourceNote || view.publishedAt}}" class="presentation-meta"><text>{{view.sourceNote}}</text><text>{{view.publishedAt}}</text></view>
  </view>

  <block wx:if="{{view.kind === 'article'}}">
   <view class="presentation-article-header">
    <view wx:if="{{view.title}}" class="presentation-title" selectable="{{true}}">{{view.title}}</view>
    <view wx:if="{{view.sourceNote || view.publishedAt}}" class="presentation-meta"><text>{{view.sourceNote}}</text><text>{{view.publishedAt}}</text></view>
   </view>
   <view class="presentation-article">
    <block wx:for="{{view.blocks}}" wx:key="key">
     <rich-text wx:if="{{item.kind === 'layout'}}" class="article-layout" nodes="{{item.html}}" selectable="{{true}}" />
     <view wx:elif="{{item.kind === 'paragraph' || item.kind === 'heading' || item.kind === 'quote'}}" class="{{item.className}}" style="{{item.style}}" selectable="{{true}}">{{item.text}}</view>
     <view wx:elif="{{item.kind === 'list'}}" class="{{item.className}}" style="{{item.style}}"><view wx:for="{{item.items}}" wx:for-item="listItem" wx:for-index="listIndex" wx:key="listIndex" class="article-list-item"><text class="article-list-marker">{{item.ordered ? (listIndex + 1) + '.' : '•'}}</text><text selectable="{{true}}">{{listItem}}</text></view></view>
     <view wx:else class="{{item.className}} presentation-article-media" style="{{item.style}}">
      <image wx:if="{{item.kind === 'image'}}" class="presentation-article-image" aria-label="{{item.caption || item.title || view.title}}" style="width:{{item.width}}px;height:{{item.height}}px" src="{{item.url}}" mode="aspectFit" lazy-load="{{true}}" data-media-id="{{item.media_id}}" data-error-key="{{item.errorKey}}" data-tracking="{{tracking}}" bindtap="openImage" bindload="onContentVideoMetadata" binderror="mediaError" />
      <video wx:else id="{{item.domId}}" class="presentation-article-video" style="width:{{item.width}}px;height:{{item.height}}px" src="{{item.url}}" controls object-fit="contain" data-media-id="{{item.media_id}}" data-player-key="{{item.playerKey}}" data-error-key="{{item.errorKey}}" data-tracking="{{tracking}}" bindplay="videoState" bindpause="videoState" bindended="videoState" bindwaiting="videoState" binderror="videoState" bindloadedmetadata="onContentVideoMetadata" bindtimeupdate="videoProgress" bindratechange="videoRate" bindfullscreenchange="videoFullscreen" />
      <text wx:if="{{item.caption}}" class="presentation-media-caption" selectable="{{true}}">{{item.caption}}</text>
      <view wx:if="{{mediaErrors[item.errorKey]}}" class="presentation-media-error"><text>{{mediaErrors[item.errorKey]}}</text><button data-media-id="{{item.media_id}}" data-error-key="{{item.errorKey}}" bindtap="retryMedia">重新加载</button></view>
     </view>
    </block>
   </view>
  </block>
 </view>
</template>
<!-- content-presentation:generated:end -->
</block>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
