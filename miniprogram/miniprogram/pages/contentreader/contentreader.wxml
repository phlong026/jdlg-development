<import src="../../components/content-presentation/content-presentation.wxml"/>
<block wx:if="{{__profileAccessMounted}}">
<view class="reader">
 <navigation-bar class="reader-navigation" title="内容阅读" back="{{true}}" background="#f7f5f1" />
 <view wx:if="{{loading}}" class="state" role="status">正在加载内容…</view>
 <view wx:elif="{{error && !contentReady}}" class="state"><text>{{error}}</text><button class="secondary" bindtap="loadContent">重试</button></view>
 <block wx:elif="{{contentReady}}">
  <view wx:if="{{presentationView.kind !== 'video'}}" class="reader-brand"><view class="brand-mark">甲</view><view><text class="brand-name">甲第灵光</text></view><text class="brand-share">甲第内容</text></view>
  <view wx:if="{{error}}" class="error"><text>{{error}}</text><button class="secondary" bindtap="loadContent">重试</button></view>
  <view class="article-paper article-paper-{{presentationView.kind}}"><template is="content-presentation" data="{{view: presentationView, tracking: true, mediaErrors: mediaErrors, videoStarted: videoStarted}}"/></view>
  <view wx:if="{{presentationView.sourceNote || content.source_url}}" class="source-card"><view><text class="source-label">内容来源</text><text class="source-value">{{presentationView.sourceNote || '原文链接'}}</text></view><button wx:if="{{content.source_url}}" class="source-action" bindtap="copySource">复制原文</button></view>

  <view wx:if="{{consentAvailable && consentChoicePending}}" class="notice"><text class="notice-title">是否开启访问分析？</text><text>{{consentNotice}}</text><text class="notice-caption">阅读、播放和分享均可正常使用，访问分析默认开启，可在「设置」中随时关闭，关闭后不再记录访问数据。</text><view class="notice-actions"><button class="primary" bindtap="acceptTracking">同意开启</button><button class="secondary" bindtap="declineTracking">保持关闭</button></view></view>
  <view wx:elif="{{consentUnavailable}}" class="notice"><text>访问分析设置暂时未就绪，阅读、播放和分享均可正常使用；稍后可在设置中调整。</text></view>
  <button wx:elif="{{consentAvailable && presentationView.kind !== 'video'}}" class="consent-settings" bindtap="openTrackingSettings">访问分析已{{consented ? '开启' : '关闭'}} · 设置</button>

  <view wx:if="{{contentReady && guideVisible}}" class="reader-guide"><view class="reader-guide-text"><text class="reader-guide-title">想为这套方案估算建房造价？</text><text class="reader-guide-sub">AI 建房顾问可按您的宅基地情况给出参考报价</text></view><button class="reader-guide-cta" bindtap="openGuide">去咨询</button><button class="reader-guide-close" bindtap="dismissGuide" aria-label="暂不需要">✕</button></view>
  <view wx:if="{{presentationView.kind === 'video'}}" class="reader-actions video-reader-actions"><button class="share-action" open-type="share"><text class="action-icon">↗</text><text>分享给好友</text></button><button class="copy-action" bindtap="copyVideoCopy"><text class="action-icon">⌘</text><text>复制文案</text></button><button class="more-action" bindtap="openVideoMore"><text class="action-icon">•••</text><text>更多</text></button></view>
  <view wx:else class="reader-actions reader-actions-{{posterAvailable ? 'three' : 'two'}}"><button class="copy-action" bindtap="copyWebLink" loading="{{webLinkBusy}}" disabled="{{webLinkBusy}}"><text class="action-icon">⌁</text><text>复制链接</text></button><button class="share-action" open-type="share"><text class="action-icon">↗</text><text>分享给好友</text></button><button wx:if="{{posterAvailable}}" class="poster-action" bindtap="generatePoster" loading="{{posterBusy}}" disabled="{{posterBusy}}"><text class="action-icon">▦</text><text>生成海报</text></button></view>
  <canvas type="2d" id="posterCanvas" class="poster-canvas" style="position:fixed;left:-9999px;top:-9999px;width:750px;height:1000px;"></canvas>
 </block>

</view>
</block>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
