<block wx:if="{{__profileAccessMounted}}">
<import src="../../components/content-presentation/content-presentation.wxml"/>
<view class="reader">
 <navigation-bar class="reader-navigation" title="内容阅读" back="{{true}}" background="#f7f5f1" />
 <view wx:if="{{loading}}" class="state" role="status">正在加载内容…</view>
 <view wx:elif="{{error && !contentReady}}" class="state"><text>{{error}}</text><button class="secondary" bindtap="loadContent">重试</button></view>
 <block wx:else>
  <view class="reader-brand"><view class="brand-mark">甲</view><view><text class="brand-name">甲第灵光</text></view><text class="brand-share">甲第内容</text></view>
  <view wx:if="{{error}}" class="error"><text>{{error}}</text><button class="secondary" bindtap="loadContent">重试</button></view>
  <view wx:if="{{consentAvailable}}" class="notice"><text class="notice-title">访问分析设置</text><text>{{consentNotice}}</text><text class="notice-caption">是否同意不影响阅读。</text><view class="notice-actions"><button wx:if="{{!consented}}" class="primary" bindtap="acceptTracking">同意</button><button class="secondary" bindtap="declineTracking">{{consented ? '关闭访问分析' : '暂不同意'}}</button></view></view>
  <view class="article-paper"><template is="content-presentation" data="{{view: presentationView, tracking: true, mediaErrors: mediaErrors}}"/></view>
  <view class="source-card"><view><text class="source-label">内容来源</text><text class="source-value">{{content.source_note || (content.source_url ? '外部素材' : '创作者资料')}}</text></view><button wx:if="{{content.source_url}}" class="source-action" bindtap="copySource">复制原文</button></view>

  <view wx:if="{{guideVisible}}" class="reader-guide"><view class="reader-guide-text"><text class="reader-guide-title">想为这套方案估算建房造价？</text><text class="reader-guide-sub">AI 建房顾问可按您的宅基地情况给出参考报价</text></view><button class="reader-guide-cta" bindtap="openGuide">去咨询</button><button class="reader-guide-close" bindtap="dismissGuide" aria-label="暂不需要">✕</button></view>
  <view class="reader-actions"><button class="copy-action" bindtap="copyWebLink" loading="{{webLinkBusy}}" disabled="{{webLinkBusy}}"><text class="action-icon">⌁</text><text>复制链接</text></button><button class="share-action" open-type="share"><text class="action-icon">↗</text><text>分享给好友</text></button><button class="poster-action" bindtap="generatePoster" loading="{{posterBusy}}" disabled="{{posterBusy}}"><text class="action-icon">▦</text><text>生成海报</text></button></view>
  <canvas type="2d" id="posterCanvas" class="poster-canvas" style="position:fixed;left:-9999px;top:-9999px;width:750px;height:1000px;"></canvas>
 </block>

</view>
</block>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
