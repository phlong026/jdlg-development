.page{min-height:100vh;background:#f7f5f1;color:#352e27}.body{padding:26rpx 28rpx 80rpx}.state{margin-top:30rpx;background:#fff;border:1rpx solid #ece5dc;border-radius:22rpx;padding:56rpx 30rpx;text-align:center;color:#75685c}.state button{margin-top:24rpx;background:#a87943;color:#fff}.hero{position:relative;min-height:420rpx;border-radius:28rpx;overflow:hidden;background:linear-gradient(145deg,#d8c2a2,#8d683b)}.hero image{position:absolute;inset:0;width:100%;height:100%}.hero-mark{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:160rpx;color:rgba(255,255,255,.48)}.hero-overlay{position:relative;z-index:1;min-height:420rpx;box-sizing:border-box;padding:190rpx 32rpx 32rpx;display:flex;flex-direction:column;justify-content:flex-end;background:linear-gradient(180deg,transparent 22%,rgba(38,29,20,.76))}.hero-title{font-size:44rpx;line-height:1.25;font-weight:600;color:#fff}.hero-description{font-size:27rpx;line-height:1.6;color:rgba(255,255,255,.86);margin-top:12rpx}.hero-meta{font-size:23rpx;color:#e7d5bd;margin-top:16rpx}.directory{margin-top:24rpx;background:#fff;border:1rpx solid #ece5dc;border-radius:22rpx;padding:0 24rpx}.item{display:flex;align-items:center;gap:20rpx;padding:24rpx 0;border-top:1rpx solid #f0ebe4}.item:first-child{border-top:0}.item-cover{width:132rpx;height:100rpx;border-radius:14rpx;background:#eee7dd}.placeholder{display:flex;align-items:center;justify-content:center;color:#a87943;font-size:32rpx}.item-main{flex:1;min-width:0}.item-title{display:block;font-size:30rpx;font-weight:500;line-height:1.45}.item-meta{display:block;font-size:23rpx;color:#8b7d70;margin-top:8rpx}.chevron{font-size:40rpx;color:#a87943}.unavailable{opacity:.62}.error{margin-top:20rpx;padding:18rpx 22rpx;border-radius:14rpx;background:#f7e7e1;color:#8a3e34}button::after{border:0}

.share-actions{display:flex;gap:20rpx;margin-top:28rpx;padding-bottom:env(safe-area-inset-bottom)}.share-actions button{flex:1;width:0;min-width:0;font-size:28rpx;margin:0;border-radius:14rpx}.copy-link{color:#7f5c37;background:#eee6d9}.share-primary{color:#fff;background:#a87943}
