.page{padding:36rpx 30rpx 70rpx;background:#f6f3ed;min-height:100vh;color:#352e27;box-sizing:border-box}.eyebrow{font-size:23rpx;letter-spacing:4rpx;color:#977345}.title{display:block;font-size:44rpx;font-weight:600;margin:16rpx 0}.description{display:block;font-size:26rpx;line-height:1.7;color:#827568;margin:18rpx 0 28rpx}.card{padding:30rpx;background:#fff;border-radius:20rpx;margin:24rpx 0}.section-title{display:block;font-size:32rpx;font-weight:600;margin-bottom:20rpx}.row{border-top:1rpx solid #eee8df;padding:26rpx 0}.name{display:block;font-size:30rpx}.muted{display:block;color:#8c7c6b;font-size:25rpx;line-height:1.7;margin:10rpx 0}.actions{display:flex;gap:12rpx}.actions button{flex:1}button{font-size:26rpx;background:#f4f0e8;color:#6d593e;margin:16rpx 0 0}button::after{border:0}.primary{background:#a6814d;color:#fff}.notice{display:block;padding:20rpx;background:#eae2d3;border-radius:12rpx;line-height:1.7}.error{color:#8a3e34;background:#f7e7e1}
.search{display:flex;gap:16rpx;margin-top:24rpx}.search input{flex:1;background:#fff;border-radius:14rpx;padding:0 24rpx}.search button{margin:0;min-width:128rpx}
