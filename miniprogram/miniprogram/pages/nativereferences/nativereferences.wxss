page{background:#fbfaf7;color:#352e27}.page{min-height:100vh;padding:24rpx 30rpx 70rpx;box-sizing:border-box}.state{padding:80rpx 28rpx;text-align:center;color:#827568}.library-tabs{display:flex;border-bottom:1rpx solid #dfd6ca;margin-bottom:16rpx}.library-tab{flex:1;margin:0;padding:22rpx 8rpx;background:transparent;border-radius:0;color:#746759;font-size:28rpx}.library-tab::after{border:0}.library-tab.active{color:#8e6438;border-bottom:4rpx solid #a87943;font-weight:600}.content-section{background:#fff;border-radius:20rpx;padding:4rpx 28rpx;margin:20rpx 0}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:26rpx 0;border-bottom:1rpx solid #eee8df}.row:last-of-type{border-bottom:0}.row-main{min-width:0;flex:1}.name{display:block;font-size:29rpx;line-height:1.5}.meta{display:block;color:#8c7c6b;font-size:23rpx;line-height:1.6;margin-top:6rpx}.empty{display:block;padding:72rpx 20rpx;text-align:center;color:#8c7c6b;font-size:26rpx}.actions{display:flex;align-items:center;gap:6rpx}.primary,.text-button,.load-more,.history-link,.notice button,.search button{margin:0;font-size:25rpx;line-height:1.4}.primary{background:#a87943;color:#fff}.compact{flex:none;padding:12rpx 24rpx}.text-button,.history-link{background:transparent;color:#8b6035}.load-more,.history-link{width:100%;padding:22rpx 0}.primary::after,.text-button::after,.load-more::after,.history-link::after,.notice button::after,.search button::after{border:0}.notice{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:18rpx;padding:20rpx;background:#eae2d3;border-radius:12rpx;line-height:1.7}.error{color:#8a3e34;background:#f7e7e1}.search{display:flex;gap:16rpx;margin:10rpx 0 20rpx}.search input{height:80rpx;box-sizing:border-box;flex:1;background:#fff;border-radius:14rpx;padding:0 24rpx}.search button{min-width:128rpx;background:#a87943;color:#fff;border-radius:14rpx}

button {
  min-height: 82rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  /* 统一垂直居中基线：原生 button 的默认 line-height 配合 min-height 会让文字偏移。 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

button::after {
  border: 0;
}

.library-empty { padding: 64rpx 24rpx; text-align: center; color: #817568; font-size: 26rpx; }
button.empty-action { width: auto; margin: 24rpx auto 0; padding: 0 28rpx; }
button.history-link { justify-content: space-between; width: 100%; padding: 20rpx 8rpx; border-top: 1rpx solid #e8e0d8; border-radius: 0; }

button:not([size='mini']) { width: auto; min-width: 0; box-sizing: border-box; }
button.library-tab { flex: 1; }
.search input { min-width: 0; width: 0; }
.search button { flex: none; min-width: 0; padding: 0 24rpx; min-height: 80rpx; }
.row .name { overflow-wrap: anywhere; }
.actions { flex: none; }
button.compact { flex: none; min-height: 72rpx; padding: 12rpx 20rpx; }
button.load-more, button.history-link { width: 100%; }
.content-section { border-radius: 12rpx; }
.media-thumb{flex:none;width:112rpx;height:112rpx;border-radius:12rpx;overflow:hidden;background:#eee7dd;color:#8b6338;display:flex;align-items:center;justify-content:center;font-size:24rpx}.media-thumb.video{width:84rpx;height:112rpx;background:#302b26;color:#fff}.media-thumb image{width:100%;height:100%}.media-row .row-main{align-self:center}
