<view class="page">
  <text class="eyebrow">内容资料库</text><text class="title">{{pickerMode === 'media' ? '选择已有素材' : pickerMode === 'content' ? '选择已发布内容' : '选用原生内容'}}</text>
  <text wx:if="{{!pickerMode}}" class="description">保存已发布的固定版本，打开内容后使用微信原生卡片分享。</text>
  <view wx:if="{{loginRequired}}" class="card"><text>登录并获得内容权限后可选用。</text><button bindtap="goLogin">去登录</button></view>
  <view wx:elif="{{loading}}" class="card">正在加载可选内容…</view>
  <block wx:else>
    <view wx:if="{{error}}" class="notice error">{{error}}<button bindtap="retry" disabled="{{busy}}">重新加载</button></view>
    <text wx:if="{{notice}}" class="notice">{{notice}}</text>
    <view wx:if="{{pickerMode}}" class="search"><input value="{{search}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="submitSearch" placeholder="搜索标题" /><button bindtap="submitSearch" disabled="{{busy}}">搜索</button></view>
    <view wx:if="{{pickerMode === 'media'}}" class="card"><text wx:if="{{!media.length}}" class="muted">没有符合条件的素材</text>
      <view wx:for="{{media}}" wx:key="media_id" class="row"><text class="name">{{item.title || (item.kind === 'image' ? '图片' : item.kind === 'video' ? '视频' : '文档')}}</text><button class="primary" data-id="{{item.media_id}}" bindtap="selectMedia">选择</button></view>
      <button wx:if="{{mediaCursor}}" data-kind="media" bindtap="loadMore" disabled="{{busy}}">加载更多</button>
    </view>
    <view wx:if="{{!pickerMode}}" class="card"><text class="section-title">已选用</text><text wx:if="{{!references.length}}" class="muted">尚未选用内容，可从下方选择。</text>
      <view wx:for="{{references}}" wx:key="reference_id" class="row"><text class="name">{{item.target.title}}</text><text class="muted">固定版本 V{{item.target.content_version}}{{item.available ? '' : ' · 来源已失效'}}</text><view class="actions"><button class="primary" data-id="{{item.reference_id}}" bindtap="openReference" disabled="{{busy || !item.available}}">打开并分享</button><button data-id="{{item.reference_id}}" bindtap="removeReference" disabled="{{busy}}">移除引用</button></view></view>
      <button wx:if="{{referenceCursor}}" data-kind="references" bindtap="loadMore" disabled="{{busy}}">加载更多引用</button>
    </view>
    <view wx:if="{{pickerMode !== 'media'}}" class="card"><text class="section-title">{{pickerMode ? '已发布内容' : '可选的已发布版本'}}</text><text wx:if="{{!candidates.length}}" class="muted">当前页暂无已发布内容。{{candidateCursor ? '可继续加载。' : ''}}</text>
      <view wx:for="{{candidates}}" wx:key="content_id" class="row"><text class="name">{{item.title}}</text><text class="muted">已发布 · V{{item.content_version}}</text><button wx:if="{{pickerMode}}" class="primary" data-id="{{item.content_id}}" data-version="{{item.content_version}}" bindtap="selectContent" disabled="{{busy}}">选择</button><button wx:else class="primary" data-id="{{item.content_id}}" data-version="{{item.content_version}}" bindtap="saveReference" disabled="{{busy}}">选用这个版本</button></view>
      <button wx:if="{{candidateCursor}}" data-kind="candidates" bindtap="loadMore" disabled="{{busy}}">加载更多来源</button>
    </view>
    <button wx:if="{{!pickerMode}}" bindtap="openHistory">查看已有生成记录</button>
    <text wx:if="{{!pickerMode}}" class="description">仅展示当前授权范围的已发布内容。</text>
  </block>
</view>
