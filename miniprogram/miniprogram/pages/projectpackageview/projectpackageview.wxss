page{background:#f8f5ef;color:#2f241a}.page{min-height:100vh;padding:28rpx 28rpx 120rpx;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.header{padding:16rpx 4rpx 22rpx}.eyebrow{display:block;color:#9b7148;font-size:23rpx;margin-bottom:10rpx}.title{display:block;font-size:42rpx;font-weight:650}.meta{display:block;color:#897b6e;font-size:23rpx;margin-top:8rpx}.card,.paper{background:#fff;border:1rpx solid #e9dfd2;border-radius:24rpx;margin-bottom:18rpx;padding:26rpx;box-shadow:0 8rpx 28rpx rgba(73,48,25,.035)}.directory{padding:0}.version-row{display:flex;align-items:center;justify-content:space-between;width:100%;max-width:none;margin:0!important;box-sizing:border-box;padding:27rpx 28rpx;border-bottom:1rpx solid #eee7de;background:#fff;text-align:left}.version-row:last-child{border-bottom:0}.row-title,.section-title{display:block;font-size:29rpx;font-weight:600}.arrow{font-size:42rpx;color:#b58a5b}.paper{font-size:28rpx;line-height:1.85}.plain{white-space:pre-wrap}.media image,.media video{width:100%;margin:20rpx 0;background:#eee}.primary,.secondary{margin-top:18rpx;padding:20rpx 24rpx;border-radius:14rpx;font-size:27rpx}.primary{background:#9f7140;color:#fff}.secondary{border:1rpx solid #b28a60;color:#80572f;background:#fff}.state{padding:180rpx 30rpx;text-align:center;color:#817469}.card textarea{width:100%;min-height:180rpx;box-sizing:border-box;margin-top:18rpx;padding:22rpx;background:#f7f4ef;border-radius:14rpx;font-size:26rpx}.ratings{display:flex;justify-content:space-between;gap:12rpx;margin-top:24rpx;font-size:23rpx}.feedback{padding:20rpx 0;border-bottom:1rpx solid #eee7de;font-size:26rpx}.rating{display:block;color:#8e642e;font-weight:600;margin-bottom:6rpx}.notice{padding:20rpx 24rpx;border-radius:14rpx;background:#fff6e6;color:#855820;font-size:24rpx}.article-heading{font-size:36rpx;font-weight:600;margin:24rpx 0 12rpx}.article-quote{border-left:6rpx solid #b89062;padding-left:20rpx;color:#66594e}.action-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.action-row .secondary{width:100%;margin-top:0}.card>.secondary,.card>.primary{width:100%}
