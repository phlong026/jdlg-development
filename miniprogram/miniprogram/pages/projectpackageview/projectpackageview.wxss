@import "/components/project-note-document/note-document.wxss";

page{background:#f8f5ef;color:#2f241a}.page{min-height:100vh;padding:28rpx 28rpx 120rpx;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.state{padding:180rpx 30rpx;color:#817469;text-align:center}.header{padding:16rpx 4rpx 22rpx}.eyebrow{display:block;margin-bottom:10rpx;color:#9b7148;font-size:23rpx}.title{display:block;font-family:"Songti SC","STSong",serif;font-size:42rpx;font-weight:650;line-height:1.4}.meta{display:block;margin-top:8rpx;color:#897b6e;font-size:23rpx}.version-line{display:flex;align-items:center;gap:12rpx;margin-top:12rpx}.version-line .meta{margin:0}.version-badge{padding:6rpx 14rpx;border-radius:999rpx;background:#f1e5d5;color:#8c5e31;font-size:21rpx}
.card,.paper{margin-bottom:18rpx;padding:28rpx;border:1rpx solid #e9dfd2;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(73,48,25,.035)}.paper{font-size:28rpx;line-height:1.85}.directory{padding:0;overflow:hidden}.version-row{display:flex;width:100%;max-width:none;align-items:center;justify-content:space-between;box-sizing:border-box;margin:0!important;padding:27rpx 28rpx;border-radius:0;border-bottom:1rpx solid #eee7de;background:#fff;text-align:left}.version-row:last-child{border-bottom:0}.row-title,.section-title{display:block;font-size:29rpx;font-weight:600}.arrow{color:#b58a5b;font-size:42rpx}
.primary,.secondary{width:100%;box-sizing:border-box;margin-top:18rpx;padding:20rpx 24rpx;border-radius:14rpx;font-size:27rpx}.primary{background:#9f7140;color:#fff}.secondary{border:1rpx solid #b28a60;background:#fff;color:#80572f}.primary::after,.secondary::after{border:0}.action-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.action-row .secondary{margin-top:0}
.feedback{padding:20rpx 0;border-bottom:1rpx solid #eee7de;font-size:26rpx;line-height:1.7}.feedback:last-child{border-bottom:0}.feedback-text{display:block;white-space:pre-wrap}.rating{display:block;margin-bottom:8rpx;color:#8e642e;font-weight:600}.feedback-card textarea{width:100%;min-height:180rpx;box-sizing:border-box;margin-top:18rpx;padding:22rpx;border-radius:14rpx;background:#f7f4ef;font-size:26rpx;line-height:1.65}.ratings{display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx;margin-top:24rpx;font-size:23rpx}.ratings label{display:flex;align-items:center;gap:4rpx}.notice{padding:20rpx 24rpx;border-radius:14rpx;background:#fff6e6;color:#855820;font-size:24rpx}
@media (max-width:360px){.title{font-size:39rpx}.action-row{grid-template-columns:1fr}.ratings{grid-template-columns:1fr}.ratings label{padding:7rpx 0}}
