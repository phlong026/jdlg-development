<block wx:if="{{__profileAccessMounted}}">
<import src="/components/project-note-document/note-document.wxml" />
<navigation-bar title="项目资料" back="{{true}}" custom-back="{{true}}" bind:back="handleBack" />
<view class="page">
  <view wx:if="{{loading}}" class="state">正在加载…</view>
  <view wx:elif="{{loginRequired}}" class="state"><text>请登录受邀账号后查看</text><button class="primary" bindtap="goLogin">去登录</button></view>
  <view wx:elif="{{error}}" class="state"><text>{{error}}</text><button class="secondary" bindtap="retry">重试</button></view>

  <block wx:elif="{{pageView === 'directory' && directory}}">
    <view class="header"><text class="eyebrow">受邀可见</text><text class="title">{{directory.project.name}}</text><text class="meta">{{directory.items.length}} 个方案</text></view>
    <view class="card directory">
      <button wx:for="{{directory.items}}" wx:key="version_id" class="version-row" data-id="{{item.version_id}}" bindtap="openVersion">
        <view><text class="row-title">{{item.title || '未命名方案'}}</text><text class="meta">第 {{item.revision}} 版</text></view><text class="arrow">›</text>
      </button>
    </view>
  </block>

  <block wx:elif="{{pageView === 'version' && versionView}}">
    <view class="header"><text class="eyebrow">{{directory.project.name}}</text><text class="title">{{versionView.version.title}}</text><view class="version-line"><text class="version-badge">V{{versionView.version.revision}}</text><text class="meta">固定版本</text></view></view>
    <view class="paper"><template is="note-document" data="{{format: versionView.version.body_format, body: versionView.version.body, blocks: articleBlocks, media: media, groups: mediaGroups, galleryPositions: galleryPositions, allowAttachments: false}}" /></view>
    <view class="card action-row"><button class="secondary" bindtap="acknowledgeRead" disabled="{{busy || readAcknowledged}}">{{readAcknowledged ? '已发送回执' : '发送阅读回执'}}</button><button wx:for="{{media}}" wx:key="media_id" wx:if="{{item.kind === 'image'}}" class="secondary" data-id="{{item.media_id}}" bindtap="saveImage">保存原图</button></view>
    <view class="card feedback-card">
      <text class="section-title">反馈给设计师</text>
      <view wx:for="{{versionView.feedbacks}}" wx:key="feedback_id" class="feedback"><text wx:if="{{item.satisfaction}}" class="rating">{{item.satisfaction === 'very_satisfied' ? '非常满意' : item.satisfaction === 'needs_adjustment' ? '需要调整' : '不太满意'}}</text><text class="feedback-text">{{item.text}}</text></view>
      <radio-group class="ratings" bindchange="setSatisfaction"><label><radio value="very_satisfied" color="#9f7140" />满意</label><label><radio value="needs_adjustment" color="#9f7140" />需要调整</label><label><radio value="unsatisfied" color="#9f7140" />不满意</label></radio-group>
      <textarea value="{{feedbackText}}" bindinput="setFeedbackText" maxlength="500" cursor-spacing="120" placeholder="请具体说明希望修改的位置或内容" />
      <button class="primary" bindtap="submitFeedback" disabled="{{busy || !feedbackText}}">提交反馈</button>
    </view>
    <view wx:if="{{versionView.can_confirm || confirmed}}" class="card"><text class="section-title">版本确认</text><button class="primary" bindtap="confirmVersion" disabled="{{busy || confirmed}}">{{confirmed ? '已确认当前版本' : '确认当前版本'}}</button></view>
  </block>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
</view>
</block>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
