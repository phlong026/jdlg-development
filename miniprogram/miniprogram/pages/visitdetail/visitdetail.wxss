.private-page {
  min-height: 100vh;
  background: #f7f3ee;
  color: #29221d;
}

.page-body {
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

button {
  min-height: 82rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
}

button::after {
  border: 0;
}

.state,
.customer-summary,
.share-summary,
.card {
  margin: 18rpx 0;
  padding: 26rpx;
  border-radius: 22rpx;
  background: #fff;
}

.state {
  display: grid;
  gap: 18rpx;
  min-height: 240rpx;
  align-content: center;
  text-align: center;
  color: #776d64;
}

.state button {
  width: 240rpx;
  color: #fff;
  background: #8b5e3c;
}

.state.compact {
  min-height: 150rpx;
}

.customer-summary,
.share-summary,
.card {
  display: grid;
  gap: 18rpx;
}

.customer-identity,
.visitor {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.customer-avatar,
.visitor image,
.visitor-placeholder {
  width: 84rpx;
  height: 84rpx;
  flex: none;
  border-radius: 50%;
}

.customer-avatar,
.visitor-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #b88752;
  font-size: 30rpx;
  font-weight: 600;
}

.customer-identity > view:last-child,
.visitor > view:nth-child(2) {
  min-width: 0;
  flex: 1;
}

.page-title,
.title {
  color: #29221d;
  font-weight: 650;
}

.page-title {
  font-size: 32rpx;
  line-height: 1.4;
}

.title {
  font-size: 29rpx;
  line-height: 1.45;
}

.muted {
  display: block;
  color: #776d64;
  font-size: 23rpx;
  line-height: 1.55;
}

.title-row,
.card-heading,
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.title-row {
  justify-content: flex-start;
  flex-wrap: wrap;
}

.intent,
.status {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 21rpx;
}

.intent-high {
  color: #b86b50;
  background: #f9ede7;
}

.intent-mid,
.status {
  color: #95632f;
  background: #f8f0e2;
}

.summary-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding-top: 20rpx;
  border-top: 1rpx solid #eee5db;
}

.summary-metrics.two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.summary-metrics > view {
  display: grid;
  gap: 7rpx;
  text-align: center;
  color: #817568;
  font-size: 23rpx;
}

.summary-metrics > view + view {
  border-left: 1rpx solid #eee5db;
}

.summary-value {
  color: #8b5e3c;
  font-size: 31rpx;
  font-weight: 650;
}

.section-head {
  margin: 30rpx 4rpx 12rpx;
  font-size: 29rpx;
  font-weight: 650;
}

.back-link {
  padding: 8rpx 0 8rpx 20rpx;
  color: #8b5e3c;
  font-size: 24rpx;
  font-weight: 400;
}

.meta {
  color: #817568;
  font-size: 23rpx;
}

.metrics {
  display: flex;
  gap: 22rpx;
  flex-wrap: wrap;
  color: #8b5e3c;
  font-size: 25rpx;
}

.lead-action,
.load-more {
  width: 100%;
  margin-top: 24rpx;
}

.lead-action {
  color: #fff;
  background: #a87943;
}

.customer-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0 24rpx;
}

.customer-actions button { min-width: 220rpx; flex: 1; }
.material-context { margin-bottom: 20rpx; padding: 14rpx 18rpx; border-radius: 14rpx; color: #76512f; background: #f0e5d6; font-size: 23rpx; }
.text-action { width: auto; margin: 4rpx 0 18rpx; padding: 0; color: #8b5e3c; background: transparent; font-size: 24rpx; }

.lead-done {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  color: #6f644f;
  background: #eee8dc;
  text-align: center;
  font-size: 26rpx;
}

.load-more {
  color: #8b5e3c;
  background: #efe6dc;
}

.visitor .chevron {
  margin-left: auto;
  padding: 10rpx;
  color: #b49a7e;
  font-size: 28rpx;
}

.timeline {
  margin: 6rpx 0 0 56rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #e4d4bf;
}

.timeline-node {
  position: relative;
  display: flex;
  gap: 16rpx;
  padding: 10rpx 0;
}

.timeline-dot {
  position: absolute;
  left: -28rpx;
  width: 16rpx;
  height: 16rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background: #a87943;
}

.timeline-body {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.timeline-label {
  color: #352e27;
  font-size: 25rpx;
  font-weight: 600;
}

.timeline-time {
  color: #817568;
  font-size: 23rpx;
}

.timeline-detail {
  color: #a89a8c;
  font-size: 22rpx;
}
