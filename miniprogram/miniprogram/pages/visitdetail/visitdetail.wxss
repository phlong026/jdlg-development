.private-page{min-height:100vh;background:#faf7f5;color:#302316;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}
.page-body{padding:8rpx 30rpx calc(44rpx + env(safe-area-inset-bottom))}
button{margin:0;min-height:76rpx;border-radius:12rpx;font-size:29rpx}button::after{border:0}
.customer-summary{padding:20rpx 0 0}.customer-identity{display:flex;align-items:center;gap:24rpx}.customer-avatar{width:124rpx;height:124rpx;flex:none;border-radius:50%}.avatar-fallback{background:#eae0d4;display:flex;align-items:center;justify-content:center}
.page-title{min-width:0;color:#302216;font-size:38rpx;line-height:1.35;font-weight:600}.customer-identity .page-title{max-width:350rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.identity-label{flex:none;padding:7rpx 16rpx;border-radius:10rpx;background:#ece6e0;color:#81715f;font-size:25rpx}
.summary-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:30rpx 0 42rpx}.summary-metrics>view{display:flex;flex-direction:column;gap:10rpx;text-align:center;color:#85725f;font-size:28rpx}.summary-metrics>view+view{border-left:1rpx solid #e5dcd3}.summary-value{color:#302216;font-size:36rpx;font-weight:600;line-height:1.2}
.customer-actions{display:flex;align-items:stretch;gap:20rpx;margin-bottom:38rpx}.customer-actions button,.lead-done{flex:1;min-width:0;margin:0;display:flex;align-items:center;justify-content:center;padding:0 16rpx;min-height:80rpx;line-height:1.35}.lead-action{color:#fff;background:linear-gradient(135deg,#ad7c49,#b48a5e);border:1rpx solid #a77946}.project-action{color:#352619;background:transparent;border:1rpx solid #a77946}.authorization-action{color:#8d7965;background:#ece5dd;font-size:25rpx}.lead-done{border-radius:12rpx;background:#ece5dd;color:#78634f;font-size:25rpx}
.section-head{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0 16rpx;color:#322317;font-size:33rpx;font-weight:600}.recent-browsing,.related-projects,.project-activity-section{padding:0 0 22rpx;border-top:1rpx solid #e4d9cf}
.entry-row,.project-row{display:flex;align-items:center;gap:22rpx;min-height:124rpx;padding:10rpx 0;border-bottom:1rpx solid #eee5dc}.entry-row:last-child,.project-row:last-child{border-bottom:0}.entry-cover,.project-cover{position:relative;width:196rpx;height:108rpx;flex:none;border-radius:10rpx;overflow:hidden;background:#ece2d6}.entry-cover image{width:100%;height:100%}.media-fallback{display:flex;align-items:center;justify-content:center;color:#9c846b;background:#ece2d6;font-size:25rpx}.entry-cover>.media-fallback{width:100%;height:100%}.play-symbol{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;border:2rpx solid #fff;border-radius:50%;color:#fff;background:#49372255;font-size:24rpx}
.entry-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:10rpx}.title{min-width:0;color:#302216;font-size:30rpx;font-weight:600;line-height:1.4}.entry-copy .title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.entry-copy .meta{font-size:25rpx;line-height:1.45}.meta,.muted{color:#8b7865;font-size:27rpx;line-height:1.5}.muted{display:block}.chevron{flex:none;margin-left:auto;color:#89745e;font-size:38rpx}.project-row .title{flex:1}
.text-action{width:auto;min-height:60rpx;margin-top:8rpx;padding:4rpx 0;background:transparent;color:#a66c32;font-size:28rpx;text-align:left;line-height:1.5}
.project-activity-list{margin-left:9rpx;border-left:1rpx solid #dac8b5}.project-activity-row{position:relative;display:flex;align-items:baseline;flex-wrap:wrap;gap:4rpx;padding:9rpx 0 9rpx 32rpx;min-height:38rpx}.activity-dot{position:absolute;left:-7rpx;top:23rpx;width:10rpx;height:10rpx;border:3rpx solid #c49664;border-radius:50%;background:#faf7f5}.activity-label{color:#3d2b1c;font-size:28rpx}.project-activity-row .meta{font-size:25rpx}.material-context{padding:0 0 22rpx;color:#8b7865;font-size:26rpx}
.state{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;min-height:250rpx;padding:28rpx;text-align:center;color:#84715e;font-size:28rpx}.state.compact{min-height:120rpx;padding:14rpx}.state button{padding:0 26rpx;background:#ab7945;color:#fff}
.load-more{width:100%;margin-top:24rpx;padding:12rpx 0;color:#8b7865;background:transparent;font-size:28rpx}
.share-summary{padding:26rpx 0;border-bottom:1rpx solid #e4d9cf}.summary-metrics.two{grid-template-columns:repeat(2,minmax(0,1fr));margin:28rpx 0}.card{padding:26rpx 0;border-bottom:1rpx solid #e4d9cf;display:grid;gap:16rpx}.visitor{display:flex;align-items:center;gap:22rpx}.visitor image,.visitor-placeholder{width:84rpx;height:84rpx;flex:none;border-radius:50%}.visitor-placeholder{display:flex;align-items:center;justify-content:center;background:#ece2d6;color:#8b735a;font-size:30rpx}.visitor>view:nth-child(2){flex:1;min-width:0}.metrics{display:flex;gap:22rpx;flex-wrap:wrap;color:#8b6c4d;font-size:27rpx}.timeline{margin:4rpx 0 0 38rpx;padding-left:28rpx;border-left:2rpx solid #decdb8}.timeline-node{position:relative;padding:12rpx 0}.timeline-dot{position:absolute;left:-36rpx;top:25rpx;width:12rpx;height:12rpx;border-radius:50%;background:#b48a5b}.timeline-body{display:flex;flex-direction:column;gap:4rpx}.timeline-label{font-size:28rpx;color:#44301f}.timeline-time,.timeline-detail{font-size:25rpx;color:#8b7865}
