.private-page{min-height:100vh;background:#f7f3ee;color:#29221d}.page-body{padding:96rpx 28rpx 52rpx}.summary,.state,.card{margin:18rpx 0;padding:26rpx;border-radius:22rpx;background:#fff;display:grid;gap:14rpx}.state{text-align:center}.title{font-size:31rpx;font-weight:650}.muted{display:block;font-size:24rpx;color:#776d64;line-height:1.6}.visitor{display:flex;gap:18rpx;align-items:center}.visitor image{width:84rpx;height:84rpx;border-radius:50%}.visitor>view{display:grid;gap:5rpx}.metrics{display:flex;gap:22rpx;flex-wrap:wrap;color:#8b5e3c;font-size:27rpx}button{min-height:82rpx;border-radius:16rpx;font-size:27rpx}button::after{border:0}

.visitor {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.visitor .chevron {
  margin-left: auto;
  color: #b49a7e;
  font-size: 28rpx;
  padding: 10rpx;
}

.timeline {
  margin: 16rpx 0 0 56rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #e4d4bf;
}

.timeline-node {
  display: flex;
  gap: 16rpx;
  padding: 10rpx 0;
  position: relative;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #a87943;
  flex-shrink: 0;
  margin-top: 8rpx;
  position: absolute;
  left: -28rpx;
}

.timeline-body {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.timeline-label {
  font-size: 25rpx;
  font-weight: 600;
  color: #352e27;
}

.timeline-time {
  font-size: 23rpx;
  color: #817568;
}

.timeline-detail {
  font-size: 22rpx;
  color: #a89a8c;
}
