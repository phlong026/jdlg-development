<block wx:if="{{__profileAccessMounted}}">
<view class="private-page">
 <navigation-bar title="{{mode === 'customer' ? '客户详情' : '分享详情'}}" variant="workbench" back="{{true}}" background="#faf7f5" />
 <view class="page-body">
  <view wx:if="{{loading}}" class="state" role="status">正在加载访问统计…</view><view wx:elif="{{loginRequired}}" class="state"><text>请先登录后查看访问详情</text><button bindtap="goLogin">去登录</button></view><view wx:elif="{{denied}}" class="state"><text>该分享已无查看权限</text><button bindtap="retry">重新检查</button></view><view wx:elif="{{error}}" class="state"><text>{{error}}</text><button bindtap="retry">重试</button></view>
  <block wx:else>
   <block wx:if="{{mode === 'customer'}}">
    <view class="customer-summary"><view class="customer-identity"><image wx:if="{{customerAvatar}}" class="customer-avatar" src="{{customerAvatar}}" mode="aspectFill" data-avatar="{{customerAvatar}}" binderror="customerAvatarLoadError" /><view wx:else class="customer-avatar avatar-fallback"><mini-icon name="user" size="64rpx" color="#8f7458" /></view><text class="page-title">{{visitor_name || title}}</text><text class="identity-label" bindtap="showCustomerIdentity" role="button">{{customerIdentityLabel}}</text></view><view class="summary-metrics"><view><text>查看</text><text class="summary-value">{{customerViews}}次</text></view><view><text>内容</text><text class="summary-value">{{customerContents}}份</text></view><view><text>停留</text><text class="summary-value">{{customerDuration}}</text></view></view></view>
    <view class="customer-actions"><button wx:if="{{canConvertLead}}" class="lead-action" bindtap="convertLead" loading="{{leadBusy}}" disabled="{{leadBusy}}">转为线索</button><view wx:elif="{{leadConverted}}" class="lead-done">{{handoffText || '已转为线索'}}</view><button wx:elif="{{conversionReason}}" class="authorization-action" bindtap="explainConversion">查看授权说明</button><button wx:if="{{canLinkProject}}" class="project-action" bindtap="createCustomerProject">关联项目</button></view>
    <view wx:if="{{contentTitle}}" class="material-context">当前素材：{{contentTitle}}</view>
    <view class="recent-browsing"><view class="section-head"><text>最近浏览</text></view><view class="state compact" wx:if="{{!entries.length && !loading}}">暂无浏览明细</view>
     <view wx:for="{{visibleEntries}}" wx:key="view_id" class="entry-row" data-index="{{index}}" bindtap="{{item.can_manage_preview ? 'openEntryContent' : ''}}" role="{{item.can_manage_preview ? 'button' : 'listitem'}}" aria-label="{{item.can_manage_preview ? '预览固定版本 ' + item.title : item.title}}"><view class="entry-cover"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" data-id="{{item.view_id}}" data-cover="{{item.cover}}" binderror="entryCoverLoadError" /><view wx:else class="media-fallback"><mini-icon name="{{item.is_video ? 'video' : 'file'}}" size="48rpx" color="#b69e83" /></view><text wx:if="{{item.is_video}}" class="play-symbol">▶</text></view><view class="entry-copy"><text class="title">{{item.title}}</text><text class="meta">{{item.occurred_short_text}} · {{item.is_video ? '观看' + item.watch_text : '停留' + item.visible_text}}<text wx:if="{{item.is_video && item.progress}}"> · {{item.progress}}%</text></text></view><text wx:if="{{item.can_manage_preview}}" class="chevron">›</text></view>
     <button wx:if="{{entries.length > 2}}" class="text-action" bindtap="toggleEntries">{{entriesExpanded ? '收起' : '查看全部'}} ›</button>
    </view>
    <view wx:if="{{relatedProjects.length}}" class="related-projects"><view class="section-head"><text>关联项目</text></view><view wx:for="{{relatedProjects}}" wx:key="project_id" class="project-row" data-id="{{item.project_id}}" bindtap="openCustomerProject" role="button"><view class="project-cover media-fallback"><mini-icon name="file" size="48rpx" color="#b69e83" /></view><text class="title">{{item.project_name}}</text><text class="chevron">›</text></view></view>
    <view wx:if="{{projectActivities.length}}" class="project-activity-section"><view class="section-head"><text>项目动态</text></view><view class="project-activity-list"><view wx:for="{{visibleProjectActivities}}" wx:key="activity_id" class="project-activity-row" data-id="{{item.project_id}}" bindtap="openCustomerProject"><view class="activity-dot"></view><text class="activity-label">{{item.kindText}}</text><text class="meta"> · {{item.occurredShortText}}</text></view></view><button wx:if="{{projectActivities.length > 3}}" class="text-action" bindtap="toggleProjectActivities">{{projectActivitiesExpanded ? '收起' : '查看全部'}} ›</button><text wx:if="{{projectActivitiesTruncated}}" class="muted">展示最近项目摘要，完整记录请进入项目。</text></view>
   </block>
   <block wx:else>
    <view class="share-summary"><text class="page-title">{{title}}</text><view class="summary-metrics two"><view><text>已识别</text><text class="summary-value">{{identified_count}}人</text></view><view><text>匿名</text><text class="summary-value">{{anonymous_count}}人</text></view></view><text class="muted">停留时长仅表示页面在前台</text></view>
    <view class="section-head"><text>访问记录</text></view><view class="state compact" wx:if="{{!items.length}}">当前统计窗口暂无访问</view>
    <view wx:for="{{items}}" wx:key="visitor_key" class="card"><view class="visitor" data-key="{{item.visitor_key}}" bindtap="toggleTimeline" role="button"><image wx:if="{{item.visitor.avatar_url}}" src="{{item.visitor.avatar_url}}" mode="aspectFill" /><view wx:else class="visitor-placeholder">访</view><view><text class="title">{{item.visitor_name}}</text><text class="muted">{{item.visitor.identity_state === 'identified' ? '已识别' : '匿名访客'}}{{item.visitor.identity_type ? ' · ' + item.visitor.identity_type : ''}}</text></view><text class="chevron">{{item.expanded ? '⌃' : '⌄'}}</text></view><view class="metrics"><text>{{item.page_views}} 次浏览</text><text>{{item.session_count}} 次会话</text><text>停留 {{item.visible_text}}</text></view><block wx:if="{{item.expanded && item.timeline.length}}"><view class="timeline"><view wx:for="{{item.timeline}}" wx:for-item="node" wx:key="label" class="timeline-node"><view class="timeline-dot"></view><view class="timeline-body"><text class="timeline-label">{{node.label}}</text><text class="timeline-time">{{node.time}}</text><text class="timeline-detail">{{node.detail}}</text></view></view></view></block><text wx:else class="muted">首次 {{item.first_visit_text}} · 最近 {{item.last_visit_text}}</text></view>
   </block>
   <button wx:if="{{next_cursor}}" class="load-more" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
  </block>
 </view>
</view>
</block>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
