@import "../../components/content-presentation/content-presentation.wxss";

page {
  background: #fbfaf7;
  color: #2b211b;
}

.private-page {
  min-height: 100vh;
}

.page-body {
  padding: 24rpx 28rpx calc(190rpx + env(safe-area-inset-bottom));
}

.editor-hero, .section-heading, .preview-heading, .published-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.editor-hero {
  padding: 0 4rpx;
}

.status-badge {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #eee9e2;
  color: #796d62;
  font-size: 23rpx;
}

.status-badge.published {
  background: #edf4e9;
  color: #557047;
}

.status-badge.revoked {
  background: #f8e9e6;
  color: #9a443e;
}

.panel, .preview, .state, .error, .notice, .published-card {
  margin: 18rpx 0;
  padding: 26rpx;
  border: 1rpx solid #eee8e1;
  border-radius: 16rpx;
  background: #fff;
}

.state {
  text-align: center;
  color: #6f665e;
}

.state button {
  margin: 24rpx auto 0;
}

.error {
  color: #a12622;
  background: #fff3f1;
  border-color: #f1d7d3;
}

.notice {
  color: #526247;
  background: #f2f6ee;
  border-color: #e2eadb;
}

.form-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.form-panel .title-input {
  border: 0;
  padding: 8rpx 0;
  background: transparent;
  font-size: 36rpx;
  font-weight: 600;
}

button.settings-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  min-height: 76rpx;
  margin: 0;
  padding: 12rpx 0 0;
  border-top: 1rpx solid #eee8e1;
  border-radius: 0;
  background: transparent;
  font-size: 26rpx;
  color: #66584a;
}

.plain-action {
  width: auto;
  min-height: 72rpx;
  margin: 0;
  padding: 12rpx 8rpx;
  background: transparent;
  font-size: 26rpx;
  color: #806345;
}

.insert-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0;
}

.section-heading {
  margin: 30rpx 4rpx 12rpx;
}

.form-panel .section-heading {
  margin: 0 0 4rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 600;
}

.section-caption {
  display: block;
  margin-top: 5rpx;
  color: #817568;
  font-size: 24rpx;
}

.content-heading > view {
  min-width: 0;
}

.content-heading .section-title {
  flex-shrink: 0;
  white-space: nowrap;
}

.heading-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.heading-actions button.text-action {
  width: auto;
  flex: 0 0 auto;
}

.ai-action {
  background: #fff8ef;
}

.field {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
}

.field-label {
  font-size: 25rpx;
  color: #6d6258;
}

input, textarea, .picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #ded5cc;
  border-radius: 14rpx;
  background: #fdfcfb;
  font-size: 28rpx;
}

.rights {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  gap: 14rpx;
}

.rights label {
  font-size: 24rpx;
  white-space: nowrap;
}

.block {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.block textarea {
  min-height: 220rpx;
  border: 0;
  background: transparent;
  padding: 8rpx 0;
  line-height: 1.7;
}

.block textarea.heading {
  min-height: 96rpx;
  font-size: 33rpx;
  font-weight: 650;
}

.block textarea.quote {
  padding-left: 22rpx;
  border-left: 6rpx solid #dfcbb3;
  color: #6d6258;
}

.list-editor {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.list-toolbar {
  display: flex;
}

.list-item-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.list-marker {
  min-width: 44rpx;
  text-align: right;
  color: #98683a;
  font-size: 26rpx;
}

.list-item-row input {
  flex: 1;
  min-height: 72rpx;
}

.list-item-remove {
  flex: 0 0 auto;
  min-height: 64rpx;
  margin: 0;
  padding: 0 18rpx;
  background: #f5f1ec;
  color: #a24a43;
  font-size: 24rpx;
}

.caption-input {
  min-height: 72rpx;
  font-size: 25rpx;
  color: #6d6258;
}

.block image, .block video, .media-row image, .media-row video, .preview image, .preview video {
  width: 100%;
  height: 360rpx;
  border-radius: 14rpx;
  background: #eee;
}

.media-placeholder {
  box-sizing: border-box;
  width: 100%;
  padding: 50rpx 24rpx;
  border-radius: 14rpx;
  background: #f4f1ed;
  text-align: center;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.actions button {
  width: auto;
  min-height: 80rpx;
  flex: 0 0 auto;
  margin: 0;
  padding: 0 16rpx;
  background: #f5f1ec;
  color: #65584e;
  font-size: 24rpx;
}

.actions .selected {
  background: #f1e4d2;
  color: #8b5c2d;
}

.actions .remove {
  color: #a24a43;
}

.text-action {
  width: auto;
  min-height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid #dfcbb3;
  background: #fff;
  color: #98683a;
  font-size: 24rpx;
}

.media-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.media-info {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 26rpx;
}

.muted {
  color: #817568;
  font-size: 24rpx;
}

.empty-state {
  padding: 48rpx 24rpx;
}

.preview {
  padding: 30rpx;
}

.preview-title {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 650;
}

.preview-cover {
  margin: 24rpx 0;
}

.preview-block {
  padding: 14rpx 0;
  font-size: 29rpx;
  line-height: 1.85;
}

.preview-block image, .preview-block video {
  margin: 8rpx 0;
}

.caption {
  display: block;
  text-align: center;
}

.published-card {
  border-color: #e4d4bf;
  background: #fffaf3;
}

.published-card > view {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.published-title {
  font-size: 29rpx;
  font-weight: 650;
}

.legacy-panel {
  font-size: 29rpx;
  line-height: 1.8;
}

.danger {
  color: #a12622;
  border: 1rpx solid #d9aaa6;
  background: #fff;
}

.revoke-button {
  width: 100%;
  margin: 18rpx 0;
}

.delete-draft-button {
  width: 100%;
  margin: 22rpx 0 0;
}

.editor-actions {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 20;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  margin: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e8e0d8;
  background: rgba(255, 255, 255, 0.96);
}

button {
  min-height: 82rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  /* 统一垂直居中基线：原生 button 的默认 line-height 配合 min-height 会让文字偏移。 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

button::after {
  border: 0;
}

.editor-actions button {
  flex: 1;
  margin: 0;
}

.primary {
  background: #a87943;
  color: #fff;
}

.secondary {
  border: 1rpx solid #a87943;
  background: #fff;
  color: #8c5e32;
}

.compact {
  width: auto;
  min-height: 68rpx;
  margin: 0;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.article-layout {
  display: block;
  box-sizing: border-box;
  max-width: 100%;
  font-size: 29rpx;
  line-height: 1.85;
  overflow-wrap: anywhere;
}

.article-layout-preview {
  overflow: hidden;
}

/* 操作按钮在页面底部，顶部错误/提示横幅滚动出视口后用户看不到反馈；吸顶常驻。 */
.error, .notice {
  position: sticky;
  top: 0;
  z-index: 15;
}

button:not([size='mini']) { width: auto; min-width: 0; box-sizing: border-box; }
button.primary, button.secondary { display: flex; align-items: center; justify-content: center; min-height: 84rpx; line-height: 1.4; }
.cover-panel .section-heading { margin: 0 0 18rpx; }
.editor-cover { display: block; width: 100%; height: 300rpx; border-radius: 10rpx; }
.insert-actions { flex-wrap: wrap; justify-content: flex-start; }
button.settings-toggle { width: 100%; }
.published-card { gap: 16rpx; background: #f5ecdf; border-color: #e7d7bf; }
.published-card .published-title { min-width: 0; flex: 1; }
.published-card button { flex: none; padding: 0 22rpx; }
.block { box-shadow: none; }
.block .actions { padding-top: 12rpx; border-top: 1rpx solid #eee8e1; }
.block .actions button { min-height: 64rpx; padding: 0 14rpx; background: transparent; }

.editor-actions button:not([size="mini"]) { width: 0; min-width: 0; flex: 1; }
.cover-panel button { flex: none; }

.mode-tabs {
  position: sticky;
  top: 0;
  z-index: 12;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin: 16rpx 0;
  padding: 8rpx;
  border-radius: 18rpx;
  background: rgba(242, 237, 230, 0.96);
}

.mode-tab {
  min-height: 68rpx;
  margin: 0;
  border-radius: 14rpx;
  background: transparent;
  color: #75685d;
  font-size: 25rpx;
}

.mode-tab.active {
  background: #fff;
  color: #8c5e32;
  font-weight: 650;
  box-shadow: 0 4rpx 14rpx rgba(79, 55, 33, 0.08);
}

.media-stage {
  position: relative;
  overflow: hidden;
  min-height: 560rpx;
  margin: 18rpx -28rpx 24rpx;
  background: #191816;
}

.editor-gallery,
.editor-gallery swiper-item,
.editor-gallery image,
.video-stage video {
  width: 100%;
  height: 680rpx;
}

.editor-gallery image,
.video-stage video {
  display: block;
  background: #191816;
}

.video-stage {
  min-height: 360rpx;
  display: flex;
  align-items: center;
}

.video-stage video {
  min-height: 360rpx;
  max-height: 68vh;
}

.media-empty {
  box-sizing: border-box;
  min-height: 560rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  color: #d9d3ca;
}

.gallery-list,
.settings-card,
.copy-card,
.video-cover-row {
  margin: 18rpx 0;
  border: 1rpx solid #eee8e1;
  border-radius: 18rpx;
  background: #fff;
}

.gallery-item {
  display: flex;
  gap: 18rpx;
  padding: 18rpx;
  border-bottom: 1rpx solid #f0ebe5;
}

.gallery-item:last-child { border-bottom: 0; }
.gallery-item > image,
.gallery-thumb-placeholder {
  width: 128rpx;
  height: 128rpx;
  flex: 0 0 128rpx;
  border-radius: 12rpx;
  background: #f0ede8;
}

.gallery-thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #918477;
}

.gallery-item-main { min-width: 0; flex: 1; }
.gallery-item-main .caption-input { min-height: 64rpx; padding: 10rpx 0; border: 0; background: transparent; }
.mini-actions { display: flex; flex-wrap: wrap; gap: 8rpx; }
.mini-actions button { min-height: 54rpx; padding: 0 14rpx; background: #f7f3ee; color: #6d5e50; font-size: 21rpx; }
.mini-actions button.selected { background: #efe0cc; color: #8c5e32; }
.mini-actions button.remove { color: #a24a43; }

.add-media-card {
  width: 100%;
  margin: 18rpx 0;
  border: 1rpx dashed #cfae88;
  background: #fffaf3;
  color: #8c5e32;
}

.copy-card { padding: 24rpx; }
.copy-card textarea { min-height: 240rpx; margin-top: 12rpx; padding: 8rpx 0; border: 0; background: transparent; line-height: 1.75; }
.video-tools { display: flex; gap: 16rpx; margin: 18rpx 0; }
.video-tools button { flex: 1; }
.video-caption { margin: 18rpx 0; background: #fff; }
.video-cover-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 22rpx; color: #6d6258; font-size: 24rpx; }
.video-cover-row image { width: 104rpx; height: 78rpx; border-radius: 10rpx; }

.settings-card { padding: 0 24rpx 18rpx; }
.settings-card .field { margin-top: 20rpx; }
.block.active { border-color: #d7b890; box-shadow: 0 0 0 2rpx rgba(168, 121, 67, 0.08); }
.studio-preview { margin: 0 -10rpx; padding: 0; border: 0; background: transparent; }

@media (min-width: 600px) {
  .page-body { max-width: 900rpx; margin: 0 auto; }
  .media-stage { margin-left: 0; margin-right: 0; border-radius: 18rpx; }
}
