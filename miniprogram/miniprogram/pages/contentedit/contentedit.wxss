.private-page{min-height:100vh;background:#f7f3ee;color:#29221d}.page-body{padding:96rpx 28rpx 60rpx}.panel,.preview,.state,.error,.notice{margin:18rpx 0;padding:24rpx;border-radius:22rpx;background:#fff}.panel{display:grid;gap:22rpx}.state{text-align:center}.error{color:#a12622;background:#fff0ef}.notice{color:#45613d;background:#eef6e9}.section-title{display:block;margin:30rpx 0 12rpx;font-size:32rpx;font-weight:650}label{display:grid;gap:10rpx;font-size:28rpx}input,textarea,.picker{box-sizing:border-box;width:100%;min-height:80rpx;padding:18rpx;border:1rpx solid #dfd4ca;border-radius:14rpx;background:#fff}radio-group,.actions{display:flex;gap:12rpx;flex-wrap:wrap}.block image,.block video,.media-row image,.media-row video,.preview image,.preview video{width:100%;height:360rpx;border-radius:14rpx;background:#eee}.muted{font-size:25rpx;color:#776d64}.primary{background:#8b5e3c;color:#fff}.danger{color:#a12622;border:1rpx solid #d9aaa6;background:#fff}button{min-height:80rpx;margin:14rpx 0;border-radius:16rpx;font-size:27rpx}button::after{border:0}.actions button{flex:1;margin:0;background:#f2ece6}.preview-block{padding:14rpx 0;line-height:1.7}
