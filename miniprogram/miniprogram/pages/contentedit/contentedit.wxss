@import "../../components/content-presentation/content-presentation.wxss";

page {
  background: #fbfaf7;
  color: #2b211b;
}

.private-page {
  min-height: 100vh;
}

.page-body {
  padding: 24rpx 28rpx calc(190rpx + env(safe-area-inset-bottom));
}

.editor-hero, .section-heading, .preview-heading, .published-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.editor-hero {
  padding: 0 4rpx;
}

/* 覆盖原生按钮自动边距，让状态与更多操作分别贴齐两侧。 */
.editor-hero .editor-more {
  flex: none;
  margin: 0 0 0 auto;
}

.more-menu {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
  margin: 12rpx 0 18rpx;
  padding: 16rpx;
  border: 1rpx solid #eee8e1;
  border-radius: 16rpx;
  background: #fff;
}

.more-menu button {
  flex: none;
  min-height: 72rpx;
  margin: 0;
  padding: 12rpx 20rpx;
}

.status-badge {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #eee9e2;
  color: #796d62;
  font-size: 23rpx;
}

.status-badge.published {
  background: #edf4e9;
  color: #557047;
}

.status-badge.revoked {
  background: #f8e9e6;
  color: #9a443e;
}

.panel, .preview, .state, .error, .notice, .published-card {
  margin: 18rpx 0;
  padding: 26rpx;
  border: 1rpx solid #eee8e1;
  border-radius: 16rpx;
  background: #fff;
}

.state {
  text-align: center;
  color: #6f665e;
}

.state button {
  margin: 24rpx auto 0;
}

.error {
  color: #a12622;
  background: #fff3f1;
  border-color: #f1d7d3;
}

.notice {
  color: #526247;
  background: #f2f6ee;
  border-color: #e2eadb;
}

.form-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.form-panel .title-input {
  border: 0;
  padding: 8rpx 0;
  background: transparent;
  font-size: 36rpx;
  font-weight: 600;
}

button.settings-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  min-height: 76rpx;
  margin: 0;
  padding: 12rpx 0 0;
  border-top: 1rpx solid #eee8e1;
  border-radius: 0;
  background: transparent;
  font-size: 26rpx;
  color: #66584a;
}

.plain-action {
  width: auto;
  min-height: 72rpx;
  margin: 0;
  padding: 12rpx 8rpx;
  background: transparent;
  font-size: 26rpx;
  color: #806345;
}

.insert-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0;
}

.section-heading {
  margin: 30rpx 4rpx 12rpx;
}

.form-panel .section-heading {
  margin: 0 0 4rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 600;
}

.section-caption {
  display: block;
  margin-top: 5rpx;
  color: #817568;
  font-size: 24rpx;
}

.content-heading > view {
  min-width: 0;
}

.content-heading .section-title {
  flex-shrink: 0;
  white-space: nowrap;
}

.heading-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.heading-actions button.text-action {
  width: auto;
  flex: 0 0 auto;
}

.ai-action {
  background: #fff8ef;
}

.field {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
}

.field-label {
  font-size: 25rpx;
  color: #6d6258;
}

input, textarea, .picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #ded5cc;
  border-radius: 14rpx;
  background: #fdfcfb;
  font-size: 28rpx;
}

.rights {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  gap: 14rpx;
}

.rights label {
  font-size: 24rpx;
  white-space: nowrap;
}

.block {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.block textarea {
  min-height: 220rpx;
  border: 0;
  background: transparent;
  padding: 8rpx 0;
  line-height: 1.7;
}

.block textarea.heading {
  min-height: 96rpx;
  font-size: 33rpx;
  font-weight: 650;
}

.block textarea.quote {
  padding-left: 22rpx;
  border-left: 6rpx solid #dfcbb3;
  color: #6d6258;
}

.list-editor {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.list-toolbar {
  display: flex;
}

.list-item-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.list-marker {
  min-width: 44rpx;
  text-align: right;
  color: #98683a;
  font-size: 26rpx;
}

.list-item-row input {
  flex: 1;
  min-height: 72rpx;
}

.list-item-remove {
  flex: 0 0 auto;
  min-height: 64rpx;
  margin: 0;
  padding: 0 18rpx;
  background: #f5f1ec;
  color: #a24a43;
  font-size: 24rpx;
}

.caption-input {
  min-height: 72rpx;
  font-size: 25rpx;
  color: #6d6258;
}

.block image, .block video, .media-row image, .media-row video, .preview image, .preview video {
  width: 100%;
  height: 360rpx;
  border-radius: 14rpx;
  background: #eee;
}

.media-placeholder {
  box-sizing: border-box;
  width: 100%;
  padding: 50rpx 24rpx;
  border-radius: 14rpx;
  background: #f4f1ed;
  text-align: center;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.actions button {
  width: auto;
  min-height: 80rpx;
  flex: 0 0 auto;
  margin: 0;
  padding: 0 16rpx;
  background: #f5f1ec;
  color: #65584e;
  font-size: 24rpx;
}

.actions .selected {
  background: #f1e4d2;
  color: #8b5c2d;
}

.actions .remove {
  color: #a24a43;
}

.text-action {
  width: auto;
  min-height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid #dfcbb3;
  background: #fff;
  color: #98683a;
  font-size: 24rpx;
}

.media-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.media-info {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 26rpx;
}

.muted {
  color: #817568;
  font-size: 24rpx;
}

.empty-state {
  padding: 48rpx 24rpx;
}

.preview {
  padding: 30rpx;
}

.preview-title {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 650;
}

.preview-cover {
  margin: 24rpx 0;
}

.preview-block {
  padding: 14rpx 0;
  font-size: 29rpx;
  line-height: 1.85;
}

.preview-block image, .preview-block video {
  margin: 8rpx 0;
}

.caption {
  display: block;
  text-align: center;
}

.published-card {
  border-color: #e4d4bf;
  background: #fffaf3;
}

.published-card > view {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.published-title {
  font-size: 29rpx;
  font-weight: 650;
}

.legacy-panel {
  font-size: 29rpx;
  line-height: 1.8;
}

.danger {
  color: #a12622;
  border: 1rpx solid #d9aaa6;
  background: #fff;
}

.editor-actions {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 20;
  bottom: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e8e0d8;
  background: rgba(255, 255, 255, 0.96);
}

button {
  min-height: 82rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  /* 统一垂直居中基线：原生 button 的默认 line-height 配合 min-height 会让文字偏移。 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

button::after {
  border: 0;
}

.editor-actions button {
  flex: 1;
  margin: 0;
}

.editor-actions .preview-link {
  width: 100%;
  min-height: 40rpx;
  flex: 0 0 100%;
  padding: 0;
  background: transparent;
  color: #8c633b;
  font-size: 23rpx;
}

.primary-actions {
  display: flex;
  width: 100%;
  gap: 16rpx;
}

.primary {
  background: #a87943;
  color: #fff;
}

.secondary {
  border: 1rpx solid #a87943;
  background: #fff;
  color: #8c5e32;
}

.compact {
  width: auto;
  min-height: 68rpx;
  margin: 0;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.article-layout {
  display: block;
  box-sizing: border-box;
  max-width: 100%;
  font-size: 29rpx;
  line-height: 1.85;
  overflow-wrap: anywhere;
}

.article-layout-preview {
  overflow: hidden;
}

/* 操作按钮在页面底部，顶部错误/提示横幅滚动出视口后用户看不到反馈；吸顶常驻。 */
.error, .notice {
  position: sticky;
  top: 0;
  z-index: 15;
}

button:not([size='mini']) { width: auto; min-width: 0; box-sizing: border-box; }
button.primary, button.secondary { display: flex; align-items: center; justify-content: center; min-height: 84rpx; line-height: 1.4; }
.cover-panel .section-heading { margin: 0 0 18rpx; }
.editor-cover { display: block; width: 100%; height: 300rpx; border-radius: 10rpx; }
.insert-actions { flex-wrap: wrap; justify-content: flex-start; }
button.settings-toggle { width: 100%; }
.published-card { gap: 16rpx; background: #f5ecdf; border-color: #e7d7bf; }
.published-card .published-title { min-width: 0; flex: 1; }
.published-card button { flex: none; padding: 0 22rpx; }
.block { box-shadow: none; }
.block .actions { padding-top: 12rpx; border-top: 1rpx solid #eee8e1; }
.block .actions button { min-height: 64rpx; padding: 0 14rpx; background: transparent; }

.editor-actions button:not([size="mini"]) { width: 0; min-width: 0; flex: 1; }
.cover-panel button { flex: none; }

.media-stage {
  position: relative;
  overflow: hidden;
  min-height: 560rpx;
  margin: 18rpx -28rpx 24rpx;
  background: #191816;
}

.editor-gallery,
.editor-gallery swiper-item,
.editor-gallery image,
.video-stage video {
  width: 100%;
  height: 680rpx;
}

.editor-gallery image,
.video-stage video {
  display: block;
  background: #191816;
}

.video-stage {
  min-height: 360rpx;
  display: flex;
  align-items: center;
}

.video-stage video {
  min-height: 360rpx;
  max-height: 68vh;
}

.media-empty {
  box-sizing: border-box;
  min-height: 560rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  color: #d9d3ca;
}

.gallery-selected-tools,
.settings-card,
.copy-card,
.video-cover-row {
  margin: 18rpx 0;
  border: 1rpx solid #eee8e1;
  border-radius: 18rpx;
  background: #fff;
}

.gallery-thumbs {
  width: 100%;
  margin: 14rpx 0;
  white-space: nowrap;
}
.gallery-thumb-row { display: inline-flex; gap: 12rpx; padding: 4rpx; }
.gallery-thumb {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  min-height: 112rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 12rpx;
  border: 3rpx solid transparent;
  background: #f0ede8;
}
.gallery-thumb.selected { border-color: #a87943; }
.gallery-thumb image,
.gallery-thumb-placeholder { width: 100%; height: 100%; }
.cover-mark { position: absolute; right: 0; bottom: 0; padding: 3rpx 8rpx; border-radius: 8rpx 0 0 0; background: rgba(88,58,31,.82); color: #fff; font-size: 18rpx; }

.gallery-thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #918477;
}

.gallery-selected-tools { padding: 16rpx 18rpx; }
.gallery-selected-tools .caption-input { min-height: 64rpx; padding: 10rpx 0; border: 0; background: transparent; }
.mini-actions { display: flex; flex-wrap: wrap; gap: 8rpx; }
.mini-actions button { min-height: 54rpx; padding: 0 14rpx; background: #f7f3ee; color: #6d5e50; font-size: 21rpx; }
.mini-actions button.selected { background: #efe0cc; color: #8c5e32; }
.mini-actions button.remove { color: #a24a43; }

.add-media-card {
  width: 100%;
  margin: 18rpx 0;
  border: 1rpx dashed #cfae88;
  background: #fffaf3;
  color: #8c5e32;
}

.copy-card { padding: 24rpx; }
.copy-card textarea { min-height: 240rpx; margin-top: 12rpx; padding: 8rpx 0; border: 0; background: transparent; line-height: 1.75; }
.editor-copy-group { margin: 14rpx 0; padding: 18rpx 24rpx; border: 1rpx solid #e8e0d7; border-radius: 18rpx; background: #fff; }
.editor-title-row, .editor-field-head { display: flex; align-items: center; gap: 16rpx; }
.editor-title-row .title-input { flex: 1; min-width: 0; padding: 8rpx 0; border: 0; background: transparent; }
.editor-copy-group .ai-action { flex: none; min-height: 56rpx; margin: 0; padding: 0 16rpx; border: 1rpx solid #d6b58e; border-radius: 999rpx; font-size: 23rpx; }
.editor-copy-group > .title-input { margin-top: 8rpx; padding: 8rpx 0; border: 0; background: transparent; font-size: 29rpx; }
.intro-field { margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid #f0ebe5; }
textarea.compact-intro { box-sizing: border-box; width: 100%; min-height: 72rpx; height: 72rpx; margin-top: 4rpx; padding: 8rpx 0; border: 0; background: transparent; line-height: 1.55; }
.video-caption { margin: 18rpx 0; background: #fff; }
.video-cover-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 22rpx; color: #6d6258; font-size: 24rpx; }
.video-cover-row image { width: 104rpx; height: 78rpx; border-radius: 10rpx; }
.video-field-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.video-field-head .ai-action { flex: none; min-height: 56rpx; margin: 0; padding: 0 16rpx; border: 1rpx solid #d6b58e; border-radius: 999rpx; font-size: 23rpx; }
.field-error { display: block; margin: 8rpx 4rpx 0; color: #a13f38; font-size: 22rpx; }
.video-media-card { overflow: hidden; margin: 16rpx 0 12rpx; padding: 20rpx; border: 1rpx solid #e8e0d7; border-radius: 20rpx; background: #fff; }
.video-media-summary { display: flex; flex-direction: column; align-items: stretch; gap: 20rpx; }
.video-thumbnail { position: relative; flex: none; width: 100%; height: 360rpx; padding: 0; margin: 0; overflow: hidden; border-radius: 14rpx; background: #24211e; color: #fff; }
.video-thumbnail image { display: block; width: 100%; height: 100%; }
.video-play-icon { position: absolute; top: 50%; left: 50%; display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin: -36rpx 0 0 -36rpx; border-radius: 50%; background: rgba(0,0,0,.38); font-size: 30rpx; }
.video-preview-label { position: absolute; bottom: 0; left: 0; width: 100%; padding: 9rpx 0; background: rgba(0,0,0,.5); font-size: 21rpx; }
.video-media-details { display: flex; flex: 1; min-width: 0; flex-direction: column; justify-content: space-between; gap: 12rpx; }
.video-media-title { font-size: 29rpx; font-weight: 600; }
.video-media-details > .muted { font-size: 22rpx; line-height: 1.6; }
.video-inline-actions { display: flex; gap: 16rpx; }
.video-inline-actions button { margin: 0; padding: 0 4rpx; min-height: 56rpx; font-size: 24rpx; }
.video-media-details button.video-cover-button { display: flex; align-items: center; justify-content: flex-start; gap: 12rpx; width: 100%; min-height: 76rpx; padding: 8rpx 12rpx; margin: 0; background: #f7f4ef; color: #75614e; font-size: 23rpx; }
.video-cover-button image { width: 52rpx; height: 64rpx; border-radius: 5rpx; }
.video-cover-button > .muted { margin-left: auto; }
.video-compact-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; min-height: 240rpx; padding: 20rpx 0; color: #40382f; text-align: center; }
.video-compact-empty .muted { color: #958778; font-size: 23rpx; }
.video-empty-actions { display: flex; gap: 16rpx; margin-top: 10rpx; }
.video-upload-status { margin: 14rpx 2rpx 0; color: #786857; font-size: 22rpx; }
.video-progress { overflow: hidden; height: 8rpx; margin-top: 8rpx; border-radius: 999rpx; background: #ede7e0; }
.video-progress view { height: 100%; border-radius: inherit; background: #a87943; transition: width 180ms ease; }
.video-layout-options { display: flex; gap: 4rpx; padding: 5rpx; border-radius: 12rpx; background: #f0ebe4; }
.video-layout-options button { width: 122rpx; min-height: 58rpx; padding: 0; margin: 0; background: transparent; color: #76695e; font-size: 23rpx; }
.video-layout-options button.selected { background: #fff; color: #8c5e32; box-shadow: 0 3rpx 12rpx rgba(79,55,33,.08); }
.video-copy-card { margin: 16rpx 0; padding: 18rpx 24rpx; }
.video-copy-card textarea { min-height: 108rpx; margin-top: 4rpx; font-size: 27rpx; line-height: 1.65; }
.video-field-head .copy-field-action { flex: none; min-height: 56rpx; margin: 0 0 0 auto; padding: 0 4rpx 0 20rpx; border: 0; background: transparent; font-size: 23rpx; }
.char-count { display: block; color: #9a8d81; font-size: 20rpx; text-align: right; }
.video-collapse { margin: 12rpx 0; padding: 0 24rpx; border: 1rpx solid #eee8e1; border-radius: 16rpx; background: #fff; }
.video-collapse .settings-toggle { padding-left: 0; padding-right: 0; }
.video-collapse textarea { box-sizing: border-box; width: 100%; min-height: 150rpx; padding: 18rpx 0; line-height: 1.7; }
.video-collapse .video-copy-card { margin: 0 0 16rpx; padding: 12rpx 0; border: 0; border-top: 1rpx solid #f0ebe5; border-radius: 0; }
.display-setting-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 16rpx 0; border-top: 1rpx solid #f0ebe5; }

.settings-card { padding: 0 24rpx 18rpx; }
.settings-card .field { margin-top: 20rpx; }
.block.active { border-color: #d7b890; box-shadow: 0 0 0 2rpx rgba(168, 121, 67, 0.08); }
.studio-preview { margin: 0 -10rpx; padding: 0; border: 0; background: transparent; }

@media (min-width: 600px) {
  .page-body { max-width: 900rpx; margin: 0 auto; }
  .media-stage { margin-left: 0; margin-right: 0; border-radius: 18rpx; }
}

/* 空态只保留一个添加入口，媒体就绪后再使用深色预览舞台。 */
.gallery-stage-empty {
  min-height: 0;
  margin: 18rpx 0 24rpx;
  border: 1rpx dashed #d7bda0;
  border-radius: 20rpx;
  background: #fffaf3;
}
.gallery-stage-empty .media-empty { min-height: 320rpx; padding: 28rpx; gap: 12rpx; color: #756450; }
.gallery-empty-icon { color: #a67a45; font-size: 54rpx; line-height: 1; }
.gallery-empty-title { color: #483b2e; font-size: 29rpx; font-weight: 600; }
.gallery-empty-hint { color: #938575; font-size: 23rpx; }
.gallery-stage-empty .compact { margin-top: 8rpx; }
.gallery-upload-status { margin: 12rpx 0; color: #8c5e32; font-size: 24rpx; text-align: center; }
