<block wx:if="{{__profileAccessMounted}}">
<view class="private-page">
 <navigation-bar title="{{preview ? '发布预览' : presentation === 'gallery' ? '编辑图集' : presentation === 'video' ? '编辑视频' : '编辑内容'}}" back="{{true}}" custom-back="{{true}}" bind:back="handleBack" background="#fbfaf7" />
 <view class="page-body">
  <view wx:if="{{loading}}" class="state" role="status">正在加载…</view>
  <view wx:elif="{{loginRequired}}" class="state"><text>登录后编辑内容</text><button class="primary compact" bindtap="goLogin">去登录</button></view>
  <view wx:elif="{{denied}}" class="state"><text>暂无内容管理权限</text><button class="secondary compact" bindtap="retry">重新检查</button></view>
  <view wx:elif="{{disabled}}" class="state">内容创作暂未开通</view>
  <block wx:else>
   <view wx:if="{{!preview}}" class="editor-hero"><view class="status-badge {{status}}">{{status === 'published' ? '已发布' : status === 'revoked' ? '已撤回' : status === 'deleted' ? '已删除' : '草稿'}}</view><button wx:if="{{!deleted && !documentReadOnly && !legacyReadOnly && id}}" class="plain-action editor-more" bindtap="toggleMore" aria-expanded="{{moreExpanded}}" aria-controls="content-more-menu" disabled="{{busy}}">更多</button></view>
   <view wx:if="{{moreExpanded && !preview && !deleted && !documentReadOnly && !legacyReadOnly && id}}" id="content-more-menu" class="more-menu"><button wx:if="{{version > 0 && status !== 'revoked'}}" class="danger" bindtap="revoke" disabled="{{busy}}">撤回发布</button><button class="text-action {{pinned ? 'selected' : ''}}" bindtap="togglePinned" disabled="{{busy}}">{{pinned ? '已置顶' : '置顶'}}</button><button wx:if="{{status === 'draft' && version === 0 && !serverReadOnly}}" class="danger" bindtap="deleteDraft" disabled="{{busy}}">删除草稿</button></view>
   <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
   <view wx:if="{{!preview && !deleted && status === 'published' && version > 0}}" class="published-card"><text>已发布 · 第{{version}}版</text><button class="primary compact" bindtap="openPublished">查看并分享</button></view>
   <block wx:if="{{deleted}}"><view class="state"><text>草稿已删除，原素材保留</text><button class="secondary compact" bindtap="backToWorkbench">返回内容创作</button></view></block>
   <block wx:elif="{{documentReadOnly}}"><view class="panel document-panel"><text class="section-title">{{title}}</text><text class="muted">{{documentAsset.title || '文档资料'}} · 仅授权可见</text><button class="primary" bindtap="openDocument" loading="{{busy}}" disabled="{{busy || !documentAsset}}">打开文档</button></view></block>
   <block wx:elif="{{legacyReadOnly}}">
    <view class="notice">此内容需在管理后台编辑</view>
    <view class="panel legacy-panel"><text class="section-title">{{title}}</text><rich-text wx:if="{{body_format === 'rich_text'}}" nodes="{{legacyBody}}" /><text wx:else user-select="true">{{legacyBody}}</text></view>
    <view wx:for="{{legacyMedia}}" wx:key="media_id" class="panel media-row"><image wx:if="{{item.kind === 'image' && item.local_path}}" src="{{item.local_path}}" mode="aspectFit" /><video wx:elif="{{item.kind === 'video' && item.local_path}}" src="{{item.local_path}}" controls /><view wx:else class="media-placeholder">素材预览暂不可用</view></view>
   </block>
   <block wx:else>
    <block wx:if="{{!preview}}">
     <view wx:if="{{presentation === 'article'}}" class="panel form-panel"><input class="title-input" value="{{title}}" maxlength="80" data-field="title" bindinput="setField" placeholder="写一个清楚的标题" aria-label="内容标题" /></view>
     <view wx:if="{{layoutReadOnly}}" class="notice">正文保留原排版，可修改标题和内容设置。</view>
     <view wx:if="{{layoutReadOnly}}" class="panel article-layout-preview"><block wx:for="{{layoutBlocks}}" wx:key="key"><rich-text wx:if="{{item.kind === 'layout'}}" class="article-layout" nodes="{{item.html}}" selectable="{{true}}" /><view wx:else class="{{item.className}}" style="{{item.style}}"><video id="{{item.domId}}" src="{{item.url}}" style="width:100%;height:{{item.height}}px" controls object-fit="contain" /></view></block></view>

     <block wx:if="{{!layoutReadOnly}}">
     <block wx:if="{{presentation === 'gallery'}}">
      <view wx:if="{{!imageBlocks.length}}" class="media-stage gallery-stage gallery-stage-empty"><view class="media-empty"><text class="gallery-empty-icon">＋</text><text class="gallery-empty-title">添加图片</text><text class="gallery-empty-hint">每次最多选择 9 张</text><button class="primary compact" bindtap="chooseMedia" disabled="{{busy}}" loading="{{busy}}">{{busy ? '正在上传' : '从相册选择'}}</button></view></view>
      <scroll-view wx:if="{{imageBlocks.length}}" scroll-x enhanced show-scrollbar="{{false}}" class="gallery-thumbs"><view class="gallery-thumb-row"><button wx:for="{{imageBlocks}}" wx:key="media_id" class="gallery-thumb {{selectedImageBlock && selectedImageBlock.media_id === item.media_id ? 'selected' : ''}}" data-index="{{item.blockIndex}}" bindtap="selectGalleryImage" aria-label="编辑第{{index + 1}}张图"><image wx:if="{{item.asset && item.asset.local_path}}" src="{{item.asset.local_path}}" mode="aspectFill" /><view wx:else class="gallery-thumb-placeholder">{{index + 1}}</view><text wx:if="{{cover_media_id === item.media_id}}" class="cover-mark">封面</text></button></view></scroll-view>
      <view wx:if="{{selectedImageBlock}}" class="gallery-selected-tools"><input class="caption-input" value="{{selectedImageBlock.caption}}" data-index="{{selectedImageBlock.blockIndex}}" bindinput="editCaption" maxlength="80" placeholder="这张图的短注释（选填）" /><view class="mini-actions"><button data-index="{{selectedImageBlock.blockIndex}}" data-step="-1" bindtap="moveBlock">前移</button><button data-index="{{selectedImageBlock.blockIndex}}" data-step="1" bindtap="moveBlock">后移</button><button class="{{cover_media_id === selectedImageBlock.media_id ? 'selected' : ''}}" data-media-id="{{selectedImageBlock.media_id}}" bindtap="setBlockCover">{{cover_media_id === selectedImageBlock.media_id ? '已设封面' : '设为封面'}}</button><button class="remove" data-index="{{selectedImageBlock.blockIndex}}" bindtap="removeBlock">移除</button></view></view>
      <button wx:if="{{imageBlocks.length}}" class="add-media-card" bindtap="chooseMedia" disabled="{{busy}}" loading="{{busy}}">{{busy ? '正在上传' : '＋ 继续添加图片'}}</button>
      <view wx:if="{{mediaUploadMessage}}" class="gallery-upload-status" role="status">{{mediaUploadMessage}}</view>
      <view class="panel form-panel"><input class="title-input" value="{{title}}" maxlength="80" data-field="title" bindinput="setField" placeholder="写一个清楚的标题" aria-label="图文标题" /></view>
      <view class="copy-card"><text class="field-label">介绍（选填）</text><textarea value="{{postText}}" bindinput="editPostText" auto-height maxlength="10000" placeholder="简单补充这组图片的亮点" /></view>
     </block>

     <block wx:if="{{presentation === 'video'}}">
      <view class="video-workspace-head"><picker wx:if="{{context.owner_choices.length > 1}}" range="{{context.owner_choices}}" range-key="display_name" value="{{ownerIndex}}" bindchange="setOwner" disabled="{{busy || !!id}}"><view>{{ownerDisplayName || '请选择内容归属'}} ›</view></picker><text wx:else>{{ownerDisplayName || '我的内容'}}</text><text class="muted">视频创作</text></view>
      <text wx:if="{{fieldErrors.owner_id}}" class="field-error">{{fieldErrors.owner_id}}</text>
      <view class="video-media-card">
       <view wx:if="{{videoBlocks.length}}" class="video-media-summary">
        <block wx:for="{{videoBlocks}}" wx:key="media_id"><view class="video-thumbnail" aria-role="button" data-media-id="{{item.media_id}}" bindtap="openEditorVideo" aria-label="全屏预览视频"><image wx:if="{{item.asset && item.asset.poster_path}}" src="{{item.asset.poster_path}}" mode="aspectFit" /><block wx:else><block wx:for="{{media}}" wx:for-item="cover" wx:key="media_id"><image wx:if="{{cover.media_id === cover_media_id && cover.local_path}}" src="{{cover.local_path}}" mode="aspectFit" /></block></block><text class="video-play-icon">▶</text><text class="video-preview-label">预览视频</text></view></block>
        <view class="video-media-details"><text class="video-media-title">主视频</text><text class="muted">{{videoUploadMessage || (videoBlocks[0].asset.local_path ? '已添加 · 可全屏预览' : videoBlocks[0].asset.preview_error ? '视频加载失败' : '正在加载视频…')}}</text><view class="video-inline-actions"><button wx:if="{{!videoBlocks[0].asset.local_path}}" class="text-action" data-media-id="{{videoBlocks[0].media_id}}" bindtap="previewMedia" disabled="{{busy}}">重试</button><button class="text-action" bindtap="chooseMedia" disabled="{{busy}}">替换视频</button><button class="text-action" bindtap="openMediaPicker" disabled="{{busy}}">素材库</button></view><button class="video-cover-button" bindtap="openCoverPicker" disabled="{{busy}}"><block wx:for="{{media}}" wx:key="media_id"><image wx:if="{{item.media_id === cover_media_id && item.local_path}}" src="{{item.local_path}}" mode="aspectFill" /></block><text>{{cover_media_id ? '更换封面' : '选择封面'}}</text><text class="muted">›</text></button></view>
       </view>
       <view wx:else class="video-compact-empty"><text class="video-media-title">添加一个视频，开始创作</text><text class="muted">从手机上传，或直接使用已有素材</text><view class="video-empty-actions"><button class="primary compact" bindtap="chooseMedia" disabled="{{busy}}">从手机选择</button><button class="secondary compact" bindtap="openMediaPicker" disabled="{{busy}}">素材库</button></view></view>
       <view wx:if="{{videoUploadMessage}}" class="video-upload-status"><text>{{videoUploadMessage}}</text><view class="video-progress"><view style="width:{{videoUploadProgress}}%" /></view></view>
      </view>
      <text wx:if="{{fieldErrors.video}}" class="field-error">{{fieldErrors.video}}</text>
      <view class="panel video-title-card"><view class="video-field-head"><text class="field-label">视频标题</text><button class="text-action ai-action" bindtap="openAIWriting" disabled="{{busy}}">AI辅助</button></view><input class="title-input" value="{{title}}" maxlength="80" data-field="title" bindinput="setField" placeholder="例如：新中式三层乡村别墅" aria-label="视频标题" /><text wx:if="{{fieldErrors.title}}" class="field-error">{{fieldErrors.title}}</text></view>
      <view class="copy-card video-copy-card"><text class="field-label">视频介绍（选填）</text><textarea value="{{postText}}" bindinput="editPostText" auto-height maxlength="10000" placeholder="简单补充视频亮点" /></view>
      <view class="video-collapse"><button class="settings-toggle" bindtap="toggleVideoShare" aria-expanded="{{videoShareExpanded}}"><text>分享文案</text><text class="muted">{{videoShareExpanded ? '收起' : '展开'}} ›</text></button><block wx:if="{{videoShareExpanded}}"><view class="copy-card video-copy-card"><view class="video-field-head"><text class="field-label">私聊转发</text><button class="text-action copy-field-action" data-field="shareCopy" bindtap="copyVideoField">复制</button></view><textarea value="{{shareCopy}}" data-field="shareCopy" bindinput="setField" auto-height maxlength="2000" placeholder="需要时再补充" /></view><view class="copy-card video-copy-card"><view class="video-field-head"><text class="field-label">朋友圈</text><button class="text-action copy-field-action" data-field="momentsCopy" bindtap="copyVideoField">复制</button></view><textarea value="{{momentsCopy}}" data-field="momentsCopy" bindinput="setField" auto-height maxlength="2000" placeholder="需要时再补充" /></view></block></view>
      <view class="video-collapse"><button class="settings-toggle" bindtap="toggleVideoDisplay" aria-expanded="{{videoDisplayExpanded}}"><text>显示设置</text><text class="muted">{{videoDisplayExpanded ? '收起' : '展开'}} ›</text></button><block wx:if="{{videoDisplayExpanded}}"><view class="display-setting-row"><text class="field-label">小程序阅读样式</text><view class="video-layout-options"><button class="{{videoLayout === 'channels' ? 'selected' : ''}}" data-layout="channels" bindtap="setVideoLayout">视频号</button><button class="{{videoLayout === 'douyin' ? 'selected' : ''}}" data-layout="douyin" bindtap="setVideoLayout">沉浸式</button></view></view><input wx:if="{{videoBlocks.length}}" class="video-caption caption-input" value="{{videoBlocks[0].caption}}" data-index="{{videoBlocks[0].blockIndex}}" bindinput="editCaption" maxlength="80" placeholder="视频短注释（选填）" /></block></view>
     </block>

     <block wx:if="{{presentation === 'article'}}">
      <view class="section-heading content-heading"><text class="section-title">正文</text><view class="heading-actions"><button class="text-action ai-action" bindtap="openAIWriting" disabled="{{busy}}">AI辅助</button><button class="text-action" bindtap="showInsertMenu" disabled="{{busy}}">添加内容</button></view></view>
      <view wx:for="{{renderedBlocks}}" wx:key="index" class="panel block {{activeBlockIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectBlock">
       <textarea wx:if="{{item.kind === 'paragraph' || item.kind === 'heading' || item.kind === 'quote'}}" class="{{item.kind}}" value="{{item.text}}" data-index="{{index}}" bindinput="editBlock" auto-height maxlength="{{item.kind === 'heading' ? 500 : 10000}}" placeholder="{{item.kind === 'heading' ? '输入小标题' : item.kind === 'quote' ? '输入引用内容' : '输入段落'}}" />
       <view wx:elif="{{item.kind === 'list'}}" class="list-editor"><button class="text-action" data-index="{{index}}" bindtap="toggleListOrdered">{{item.ordered ? '取消编号' : '添加编号'}}</button><view wx:for="{{item.items}}" wx:for-item="listItem" wx:for-index="itemIndex" wx:key="itemIndex" class="list-item-row"><text class="list-marker">{{item.ordered ? itemIndex + 1 + '.' : '•'}}</text><input value="{{listItem}}" data-index="{{index}}" data-item-index="{{itemIndex}}" bindinput="editListItem" /><button wx:if="{{item.items.length > 1}}" class="remove" data-index="{{index}}" data-item-index="{{itemIndex}}" bindtap="removeListItem">删除</button></view><button class="text-action" data-index="{{index}}" bindtap="addListItem">＋ 添加一项</button></view>
       <block wx:else><image wx:if="{{item.kind === 'image' && item.asset && item.asset.local_path}}" src="{{item.asset.local_path}}" mode="aspectFit" /><video wx:elif="{{item.kind === 'video' && item.asset && item.asset.local_path}}" src="{{item.asset.local_path}}" controls object-fit="contain" /><view wx:elif="{{item.asset && item.asset.preview_error}}" class="media-placeholder"><text>媒体加载失败</text><button data-media-id="{{item.media_id}}" bindtap="previewMedia">重试</button></view><view wx:else class="media-placeholder">正在加载媒体…</view><input class="caption-input" value="{{item.caption}}" data-index="{{index}}" bindinput="editCaption" maxlength="80" placeholder="短注释（选填）" /></block>
       <view wx:if="{{activeBlockIndex === index}}" class="actions"><button wx:if="{{item.kind === 'paragraph'}}" data-index="{{index}}" data-to="heading" bindtap="convertBlock">转标题</button><button wx:if="{{item.kind === 'paragraph' || item.kind === 'heading'}}" data-index="{{index}}" data-to="quote" bindtap="convertBlock">转引用</button><button wx:if="{{item.kind === 'heading' || item.kind === 'quote'}}" data-index="{{index}}" data-to="paragraph" bindtap="convertBlock">转段落</button><button wx:if="{{item.kind === 'heading'}}" data-index="{{index}}" data-level="2" bindtap="setHeadingLevel">小标题</button><button wx:if="{{item.kind === 'heading'}}" data-index="{{index}}" data-level="3" bindtap="setHeadingLevel">次级标题</button><button data-index="{{index}}" data-step="-1" bindtap="moveBlock">上移</button><button data-index="{{index}}" data-step="1" bindtap="moveBlock">下移</button><button class="remove" data-index="{{index}}" bindtap="removeBlock">移除</button></view>
      </view>
      <view class="insert-actions"><button class="text-action" bindtap="chooseMedia" disabled="{{busy || !context.media_upload_configured}}">添加素材</button><button class="plain-action" bindtap="openMediaPicker" disabled="{{busy}}">选择已有素材</button><button class="plain-action" bindtap="toggleMedia">素材管理 {{mediaExpanded ? '⌃' : '›'}}</button></view>
     </block>
     </block>

     <view class="settings-card"><button class="settings-toggle" bindtap="toggleSettings" aria-expanded="{{settingsExpanded}}"><text>内容设置</text><text class="muted">{{rights === 'authorized' ? '已获授权' : '自有素材'}} {{settingsExpanded ? '⌃' : '›'}}</text></button><block wx:if="{{settingsExpanded}}"><label wx:if="{{presentation !== 'video' && context.owner_choices.length > 1}}" class="field"><text class="field-label">内容归属</text><picker range="{{context.owner_choices}}" range-key="display_name" value="{{ownerIndex}}" bindchange="setOwner"><view class="picker">{{ownerDisplayName || '请选择'}}</view></picker></label><view class="field"><text class="field-label">版权来源</text><radio-group class="rights" bindchange="setRights"><label><radio value="own" checked="{{rights === 'own'}}" color="#a87943" />自有素材</label><label><radio value="authorized" checked="{{rights === 'authorized'}}" color="#a87943" />已获授权</label></radio-group></view><label class="field"><text class="field-label">来源说明</text><input value="{{source_note}}" data-field="source_note" bindinput="setField" /></label><label class="field"><text class="field-label">原文链接</text><input value="{{source_url}}" data-field="source_url" bindinput="setField" /></label><label class="field"><text class="field-label">标签</text><input value="{{tagsText}}" bindinput="setTags" maxlength="200" placeholder="空格分隔，最多10个" /></label></block></view>
     <block wx:if="{{mediaExpanded}}"><view class="section-heading"><text class="section-title">素材管理</text><button class="plain-action" bindtap="chooseDocument">上传文档</button></view><view wx:for="{{media}}" wx:key="media_id" class="panel media-row"><image wx:if="{{item.kind === 'image' && item.local_path}}" src="{{item.local_path}}" mode="aspectFit" /><video wx:elif="{{item.kind === 'video' && item.local_path}}" src="{{item.local_path}}" controls /><view class="media-info"><text>{{item.title || (item.kind === 'image' ? '图片' : '视频')}}</text></view><view class="actions"><button wx:if="{{!item.local_path}}" data-index="{{index}}" bindtap="previewMedia">预览</button><button data-index="{{index}}" bindtap="addMediaBlock">加入正文</button><button wx:if="{{item.kind === 'image'}}" data-index="{{index}}" bindtap="setCover">设为封面</button></view></view><view wx:for="{{documentCandidates}}" wx:key="media_id" class="panel media-info"><text>{{item.title || '待归档文档'}}</text><button class="text-action" data-index="{{index}}" bindtap="archiveDocument">保存文档</button></view></block>
    </block>
    <view wx:if="{{preview}}" class="preview studio-preview"><template is="content-presentation" data="{{view: presentationView, tracking: false, mediaErrors: presentationMediaErrors, videoStarted: videoStarted}}"/></view>
    <view class="editor-actions"><block wx:if="{{preview}}"><button class="secondary" bindtap="returnToEdit" disabled="{{busy}}">返回编辑</button><button class="primary publish-button" bindtap="publish" loading="{{busy}}" disabled="{{busy}}">发布</button></block><block wx:else><button class="preview-link" bindtap="saveAndPreview" disabled="{{busy}}">预览</button><view class="primary-actions"><button class="secondary" bindtap="saveDraft" loading="{{busy}}" disabled="{{busy}}">保存草稿</button><button class="primary publish-button" bindtap="publish" loading="{{busy}}" disabled="{{busy}}">发布</button></view></block></view>
   </block>
  </block>
 </view>
</view>

<!-- content-presentation:generated:start -->
<template name="content-presentation">
 <view class="content-presentation content-presentation-{{view.kind}}">
  <block wx:if="{{view.kind === 'gallery'}}">
   <view class="presentation-media presentation-gallery" style="height:{{view.galleryHeight}}px">
    <swiper current="{{view.galleryIndex}}" style="height:{{view.galleryHeight}}px" data-tracking="{{tracking}}" bindchange="onContentGalleryChange">
     <swiper-item wx:for="{{view.media}}" wx:key="key">
      <view class="presentation-gallery-slide">
       <image class="presentation-gallery-image" style="width:{{item.width}}px;height:{{item.height}}px" src="{{item.url}}" mode="aspectFit" lazy-load="{{true}}" aria-label="{{item.caption || view.title}}" data-media-id="{{item.media_id}}" data-error-key="{{item.errorKey}}" data-tracking="{{tracking}}" bindtap="openImage" bindload="onContentVideoMetadata" binderror="mediaError" />
      </view>
     </swiper-item>
    </swiper>
    <text wx:if="{{view.media.length > 1}}" class="presentation-gallery-count">{{view.galleryIndex + 1}}/{{view.media.length}}</text>
   </view>
   <text wx:if="{{view.media[view.galleryIndex].caption}}" class="presentation-media-caption" selectable="{{true}}">{{view.media[view.galleryIndex].caption}}</text>
   <view wx:if="{{mediaErrors[view.media[view.galleryIndex].errorKey]}}" class="presentation-media-error"><text>{{mediaErrors[view.media[view.galleryIndex].errorKey]}}</text><button data-media-id="{{view.media[view.galleryIndex].media_id}}" data-error-key="{{view.media[view.galleryIndex].errorKey}}" bindtap="retryMedia">重新加载</button></view>
  </block>

  <block wx:elif="{{view.kind === 'video'}}">
   <view class="content-video content-video-{{view.videoLayout}}">
    <view class="presentation-video-brand"><text class="presentation-video-brand-mark">甲</text><text>甲第灵光</text><text class="presentation-video-brand-type">{{view.videoLayout === 'douyin' ? '沉浸视频' : '视频号作品'}}</text></view>
    <view wx:if="{{view.media[0]}}" class="presentation-media presentation-video-shell" style="width:{{view.media[0].width}}px;height:{{view.media[0].height}}px">
     <view wx:if="{{view.poster && !videoStarted[view.media[0].playerKey]}}" class="presentation-video-poster" data-dom-id="{{view.media[0].domId}}" data-player-key="{{view.media[0].playerKey}}" bindtap="playContentVideo">
      <image src="{{view.poster}}" mode="aspectFill" />
      <text class="presentation-video-play" aria-label="播放视频">▶</text>
     </view>
     <video wx:else id="{{view.media[0].domId}}" class="presentation-video" style="width:{{view.media[0].width}}px;height:{{view.media[0].height}}px" src="{{view.media[0].url}}" poster="{{view.nativePoster}}" autoplay="{{videoStarted[view.media[0].playerKey]}}" controls object-fit="contain" data-media-id="{{view.media[0].media_id}}" data-player-key="{{view.media[0].playerKey}}" data-error-key="{{view.media[0].errorKey}}" data-tracking="{{tracking}}" bindplay="videoState" bindpause="videoState" bindended="videoState" bindwaiting="videoState" binderror="videoState" bindloadedmetadata="onContentVideoMetadata" bindtimeupdate="videoProgress" bindratechange="videoRate" bindfullscreenchange="videoFullscreen" />
    </view>
    <view wx:if="{{view.media[0] && mediaErrors[view.media[0].errorKey]}}" class="presentation-media-error"><text>{{mediaErrors[view.media[0].errorKey]}}</text><button data-media-id="{{view.media[0].media_id}}" data-error-key="{{view.media[0].errorKey}}" bindtap="retryMedia">重新加载</button></view>
    <view class="presentation-note-copy presentation-video-copy">
     <view wx:if="{{view.title}}" class="presentation-title" selectable="{{true}}">{{view.title}}</view>
     <text wx:if="{{view.bodyText}}" class="presentation-body {{view.descriptionExpanded ? 'is-expanded' : ''}}" selectable="{{true}}">{{view.bodyText}}</text>
     <button wx:if="{{view.bodyExpandable}}" class="presentation-copy-toggle" bindtap="toggleContentDescription">{{view.descriptionExpanded ? '收起' : '展开全文'}}</button>
     <view wx:if="{{view.sourceNote || view.publishedAt}}" class="presentation-meta"><text>{{view.sourceNote}}</text><text>{{view.publishedAt}}</text></view>
    </view>
   </view>
  </block>

  <view wx:if="{{view.kind === 'gallery'}}" class="presentation-note-copy">
   <view wx:if="{{view.title}}" class="presentation-title" selectable="{{true}}">{{view.title}}</view>
   <text wx:if="{{view.bodyText}}" class="presentation-body" selectable="{{true}}">{{view.bodyText}}</text>
   <view wx:if="{{view.sourceNote || view.publishedAt}}" class="presentation-meta"><text>{{view.sourceNote}}</text><text>{{view.publishedAt}}</text></view>
  </view>

  <block wx:if="{{view.kind === 'article'}}">
   <view class="presentation-article-header">
    <view wx:if="{{view.title}}" class="presentation-title" selectable="{{true}}">{{view.title}}</view>
    <view wx:if="{{view.sourceNote || view.publishedAt}}" class="presentation-meta"><text>{{view.sourceNote}}</text><text>{{view.publishedAt}}</text></view>
   </view>
   <view class="presentation-article">
    <block wx:for="{{view.blocks}}" wx:key="key">
     <rich-text wx:if="{{item.kind === 'layout'}}" class="article-layout" nodes="{{item.html}}" selectable="{{true}}" />
     <view wx:elif="{{item.kind === 'paragraph' || item.kind === 'heading' || item.kind === 'quote'}}" class="{{item.className}}" style="{{item.style}}" selectable="{{true}}">{{item.text}}</view>
     <view wx:elif="{{item.kind === 'list'}}" class="{{item.className}}" style="{{item.style}}"><view wx:for="{{item.items}}" wx:for-item="listItem" wx:for-index="listIndex" wx:key="listIndex" class="article-list-item"><text class="article-list-marker">{{item.ordered ? (listIndex + 1) + '.' : '•'}}</text><text selectable="{{true}}">{{listItem}}</text></view></view>
     <view wx:else class="{{item.className}} presentation-article-media" style="{{item.style}}">
      <image wx:if="{{item.kind === 'image'}}" class="presentation-article-image" aria-label="{{item.caption || item.title || view.title}}" style="width:{{item.width}}px;height:{{item.height}}px" src="{{item.url}}" mode="aspectFit" lazy-load="{{true}}" data-media-id="{{item.media_id}}" data-error-key="{{item.errorKey}}" data-tracking="{{tracking}}" bindtap="openImage" bindload="onContentVideoMetadata" binderror="mediaError" />
      <video wx:else id="{{item.domId}}" class="presentation-article-video" style="width:{{item.width}}px;height:{{item.height}}px" src="{{item.url}}" controls object-fit="contain" data-media-id="{{item.media_id}}" data-player-key="{{item.playerKey}}" data-error-key="{{item.errorKey}}" data-tracking="{{tracking}}" bindplay="videoState" bindpause="videoState" bindended="videoState" bindwaiting="videoState" binderror="videoState" bindloadedmetadata="onContentVideoMetadata" bindtimeupdate="videoProgress" bindratechange="videoRate" bindfullscreenchange="videoFullscreen" />
      <text wx:if="{{item.caption}}" class="presentation-media-caption" selectable="{{true}}">{{item.caption}}</text>
      <view wx:if="{{mediaErrors[item.errorKey]}}" class="presentation-media-error"><text>{{mediaErrors[item.errorKey]}}</text><button data-media-id="{{item.media_id}}" data-error-key="{{item.errorKey}}" bindtap="retryMedia">重新加载</button></view>
     </view>
    </block>
   </view>
  </block>
 </view>
</template>
<!-- content-presentation:generated:end -->
</block>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
