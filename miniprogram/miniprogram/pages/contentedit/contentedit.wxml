<block wx:if="{{__profileAccessMounted}}">
<import src="/components/content-presentation/content-presentation.wxml"/>
<view class="private-page">
 <navigation-bar title="{{preview ? '发布预览' : presentation === 'gallery' ? '编辑图集' : presentation === 'video' ? '编辑视频' : '编辑内容'}}" back="{{true}}" custom-back="{{true}}" bind:back="handleBack" background="#fbfaf7" />
 <view class="page-body">
  <view wx:if="{{loading}}" class="state" role="status">正在加载…</view>
  <view wx:elif="{{loginRequired}}" class="state"><text>登录后编辑内容</text><button class="primary compact" bindtap="goLogin">去登录</button></view>
  <view wx:elif="{{denied}}" class="state"><text>暂无内容管理权限</text><button class="secondary compact" bindtap="retry">重新检查</button></view>
  <view wx:elif="{{disabled}}" class="state">内容创作暂未开通</view>
  <block wx:else>
   <view wx:if="{{!preview}}" class="editor-hero"><view class="status-badge {{status}}">{{status === 'published' ? '已发布' : status === 'revoked' ? '已撤回' : status === 'deleted' ? '已删除' : '草稿'}}</view><button wx:if="{{!deleted && id}}" class="plain-action" bindtap="toggleMore" aria-expanded="{{moreExpanded}}">更多</button></view>
   <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
   <view wx:if="{{!preview && !deleted && status === 'published' && version > 0}}" class="published-card"><text>已发布 · 第{{version}}版</text><button class="primary compact" bindtap="openPublished">查看并分享</button></view>
   <block wx:if="{{deleted}}"><view class="state"><text>草稿已删除，原素材保留</text><button class="secondary compact" bindtap="backToWorkbench">返回内容创作</button></view></block>
   <block wx:elif="{{documentReadOnly}}"><view class="panel document-panel"><text class="section-title">{{title}}</text><text class="muted">{{documentAsset.title || '文档资料'}} · 仅授权可见</text><button class="primary" bindtap="openDocument" loading="{{busy}}" disabled="{{busy || !documentAsset}}">打开文档</button></view></block>
   <block wx:elif="{{legacyReadOnly}}">
    <view class="notice">此内容需在管理后台编辑</view>
    <view class="panel legacy-panel"><text class="section-title">{{title}}</text><rich-text wx:if="{{body_format === 'rich_text'}}" nodes="{{legacyBody}}" /><text wx:else user-select="true">{{legacyBody}}</text></view>
    <view wx:for="{{legacyMedia}}" wx:key="media_id" class="panel media-row"><image wx:if="{{item.kind === 'image' && item.local_path}}" src="{{item.local_path}}" mode="aspectFit" /><video wx:elif="{{item.kind === 'video' && item.local_path}}" src="{{item.local_path}}" controls /><view wx:else class="media-placeholder">素材预览暂不可用</view></view>
   </block>
   <block wx:else>
    <block wx:if="{{!preview}}">
     <view wx:if="{{!layoutReadOnly}}" class="mode-tabs"><button class="mode-tab {{presentation === 'gallery' ? 'active' : ''}}" data-presentation="gallery" bindtap="selectPresentation">图集</button><button class="mode-tab {{presentation === 'video' ? 'active' : ''}}" data-presentation="video" bindtap="selectPresentation">视频</button><button class="mode-tab {{presentation === 'article' ? 'active' : ''}}" data-presentation="article" bindtap="selectPresentation">文章</button></view>
     <view class="panel form-panel"><input class="title-input" value="{{title}}" maxlength="80" data-field="title" bindinput="setField" placeholder="写一个清楚的标题" aria-label="内容标题" /></view>
     <view wx:if="{{layoutReadOnly}}" class="notice">正文保留原排版，可修改标题和内容设置。</view>
     <view wx:if="{{layoutReadOnly}}" class="panel article-layout-preview"><block wx:for="{{layoutBlocks}}" wx:key="key"><rich-text wx:if="{{item.kind === 'layout'}}" class="article-layout" nodes="{{item.html}}" selectable="{{true}}" /><view wx:else class="{{item.className}}" style="{{item.style}}"><video id="{{item.domId}}" src="{{item.url}}" style="width:100%;height:{{item.height}}px" controls object-fit="contain" /></view></block></view>

     <block wx:if="{{!layoutReadOnly}}">
     <block wx:if="{{presentation === 'gallery'}}">
      <view class="media-stage gallery-stage">
       <swiper wx:if="{{imageBlocks.length}}" class="editor-gallery" indicator-dots="{{true}}"><swiper-item wx:for="{{imageBlocks}}" wx:key="media_id"><image wx:if="{{item.asset && item.asset.local_path}}" src="{{item.asset.local_path}}" mode="aspectFit" /><view wx:elif="{{item.asset && item.asset.preview_error}}" class="media-placeholder"><text>图片加载失败</text><button class="text-action" data-media-id="{{item.media_id}}" bindtap="previewMedia">重试</button></view><view wx:else class="media-placeholder">正在加载图片…</view></swiper-item></swiper>
       <view wx:if="{{!imageBlocks.length}}" class="media-empty"><text>先添加图片</text><button class="primary compact" bindtap="chooseMedia">从相册选择</button></view>
      </view>
      <view class="gallery-list"><view wx:for="{{imageBlocks}}" wx:key="media_id" class="gallery-item"><image wx:if="{{item.asset && item.asset.local_path}}" src="{{item.asset.local_path}}" mode="aspectFill" /><view wx:else class="gallery-thumb-placeholder">{{index + 1}}</view><view class="gallery-item-main"><input class="caption-input" value="{{item.caption}}" data-index="{{item.blockIndex}}" bindinput="editCaption" maxlength="80" placeholder="这张图的短注释（选填）" /><view class="mini-actions"><button data-index="{{item.blockIndex}}" data-step="-1" bindtap="moveBlock">前移</button><button data-index="{{item.blockIndex}}" data-step="1" bindtap="moveBlock">后移</button><button class="{{cover_media_id === item.media_id ? 'selected' : ''}}" data-media-id="{{item.media_id}}" bindtap="setBlockCover">{{cover_media_id === item.media_id ? '封面' : '设封面'}}</button><button class="remove" data-index="{{item.blockIndex}}" bindtap="removeBlock">移除</button></view></view></view></view>
      <button class="add-media-card" bindtap="chooseMedia" disabled="{{busy}}">＋ 继续添加图片</button>
      <view class="copy-card"><text class="field-label">正文</text><textarea value="{{postText}}" bindinput="editPostText" auto-height maxlength="10000" placeholder="写一份完整文案，不要重复填在每张图的注释里" /></view>
     </block>

     <block wx:if="{{presentation === 'video'}}">
      <view class="media-stage video-stage"><block wx:for="{{videoBlocks}}" wx:key="media_id"><video wx:if="{{item.asset && item.asset.local_path}}" style="height:{{item.mediaHeight}}px" src="{{item.asset.local_path}}" controls object-fit="contain" data-editor="true" data-media-id="{{item.media_id}}" bindloadedmetadata="onContentVideoMetadata" /><view wx:elif="{{item.asset && item.asset.preview_error}}" class="media-placeholder"><text>视频加载失败</text><button class="text-action" data-media-id="{{item.media_id}}" bindtap="previewMedia">重试</button></view><view wx:else class="media-placeholder">正在加载视频…</view></block><view wx:if="{{!videoBlocks.length}}" class="media-empty"><text>先添加主视频</text><button class="primary compact" bindtap="chooseMedia">选择视频</button></view></view>
      <view class="video-tools"><button class="secondary compact" bindtap="openMediaPicker">选择已有视频</button><button class="secondary compact" bindtap="openCoverPicker">{{cover_media_id ? '更换封面' : '选择封面'}}</button></view>
      <input wx:if="{{videoBlocks.length}}" class="video-caption caption-input" value="{{videoBlocks[0].caption}}" data-index="{{videoBlocks[0].blockIndex}}" bindinput="editCaption" maxlength="80" placeholder="视频短注释（选填）" />
      <view wx:if="{{cover_media_id}}" class="video-cover-row"><text>已设独立封面</text><block wx:for="{{media}}" wx:key="media_id"><image wx:if="{{item.media_id === cover_media_id && item.local_path}}" src="{{item.local_path}}" mode="aspectFill" /></block></view>
      <view class="copy-card"><text class="field-label">正文</text><textarea value="{{postText}}" bindinput="editPostText" auto-height maxlength="10000" placeholder="写完整视频文案或发布说明" /></view>
     </block>

     <block wx:if="{{presentation === 'article'}}">
      <view class="section-heading content-heading"><text class="section-title">正文</text><view class="heading-actions"><button class="text-action ai-action" bindtap="openAIWriting" disabled="{{busy}}">文案辅助</button><button class="text-action" bindtap="showInsertMenu" disabled="{{busy}}">添加内容</button></view></view>
      <view wx:for="{{renderedBlocks}}" wx:key="index" class="panel block {{activeBlockIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectBlock">
       <textarea wx:if="{{item.kind === 'paragraph' || item.kind === 'heading' || item.kind === 'quote'}}" class="{{item.kind}}" value="{{item.text}}" data-index="{{index}}" bindinput="editBlock" auto-height maxlength="{{item.kind === 'heading' ? 500 : 10000}}" placeholder="{{item.kind === 'heading' ? '输入小标题' : item.kind === 'quote' ? '输入引用内容' : '输入段落'}}" />
       <view wx:elif="{{item.kind === 'list'}}" class="list-editor"><button class="text-action" data-index="{{index}}" bindtap="toggleListOrdered">{{item.ordered ? '取消编号' : '添加编号'}}</button><view wx:for="{{item.items}}" wx:for-item="listItem" wx:for-index="itemIndex" wx:key="itemIndex" class="list-item-row"><text class="list-marker">{{item.ordered ? itemIndex + 1 + '.' : '•'}}</text><input value="{{listItem}}" data-index="{{index}}" data-item-index="{{itemIndex}}" bindinput="editListItem" /><button wx:if="{{item.items.length > 1}}" class="remove" data-index="{{index}}" data-item-index="{{itemIndex}}" bindtap="removeListItem">删除</button></view><button class="text-action" data-index="{{index}}" bindtap="addListItem">＋ 添加一项</button></view>
       <block wx:else><image wx:if="{{item.kind === 'image' && item.asset && item.asset.local_path}}" src="{{item.asset.local_path}}" mode="aspectFit" /><video wx:elif="{{item.kind === 'video' && item.asset && item.asset.local_path}}" src="{{item.asset.local_path}}" controls object-fit="contain" /><view wx:elif="{{item.asset && item.asset.preview_error}}" class="media-placeholder"><text>媒体加载失败</text><button data-media-id="{{item.media_id}}" bindtap="previewMedia">重试</button></view><view wx:else class="media-placeholder">正在加载媒体…</view><input class="caption-input" value="{{item.caption}}" data-index="{{index}}" bindinput="editCaption" maxlength="80" placeholder="短注释（选填）" /></block>
       <view wx:if="{{activeBlockIndex === index}}" class="actions"><button wx:if="{{item.kind === 'paragraph'}}" data-index="{{index}}" data-to="heading" bindtap="convertBlock">转标题</button><button wx:if="{{item.kind === 'paragraph' || item.kind === 'heading'}}" data-index="{{index}}" data-to="quote" bindtap="convertBlock">转引用</button><button wx:if="{{item.kind === 'heading' || item.kind === 'quote'}}" data-index="{{index}}" data-to="paragraph" bindtap="convertBlock">转段落</button><button wx:if="{{item.kind === 'heading'}}" data-index="{{index}}" data-level="2" bindtap="setHeadingLevel">小标题</button><button wx:if="{{item.kind === 'heading'}}" data-index="{{index}}" data-level="3" bindtap="setHeadingLevel">次级标题</button><button data-index="{{index}}" data-step="-1" bindtap="moveBlock">上移</button><button data-index="{{index}}" data-step="1" bindtap="moveBlock">下移</button><button class="remove" data-index="{{index}}" bindtap="removeBlock">移除</button></view>
      </view>
      <view class="insert-actions"><button class="text-action" bindtap="chooseMedia" disabled="{{busy || !context.media_upload_configured}}">添加素材</button><button class="plain-action" bindtap="openMediaPicker" disabled="{{busy}}">选择已有素材</button><button class="plain-action" bindtap="toggleMedia">素材管理 {{mediaExpanded ? '⌃' : '›'}}</button></view>
     </block>
     </block>

     <view class="settings-card"><button class="settings-toggle" bindtap="toggleSettings" aria-expanded="{{settingsExpanded}}"><text>内容设置</text><text class="muted">{{rights === 'authorized' ? '已获授权' : '自有素材'}} {{settingsExpanded ? '⌃' : '›'}}</text></button><block wx:if="{{settingsExpanded}}"><label wx:if="{{context.owner_choices.length > 1}}" class="field"><text class="field-label">内容归属</text><picker range="{{context.owner_choices}}" range-key="display_name" value="{{ownerIndex}}" bindchange="setOwner"><view class="picker">{{ownerDisplayName || '请选择'}}</view></picker></label><view class="field"><text class="field-label">版权来源</text><radio-group class="rights" bindchange="setRights"><label><radio value="own" checked="{{rights === 'own'}}" color="#a87943" />自有素材</label><label><radio value="authorized" checked="{{rights === 'authorized'}}" color="#a87943" />已获授权</label></radio-group></view><label class="field"><text class="field-label">来源说明</text><input value="{{source_note}}" data-field="source_note" bindinput="setField" /></label><label class="field"><text class="field-label">原文链接</text><input value="{{source_url}}" data-field="source_url" bindinput="setField" /></label><label class="field"><text class="field-label">标签</text><input value="{{tagsText}}" bindinput="setTags" maxlength="200" placeholder="空格分隔，最多10个" /></label></block></view>
     <block wx:if="{{mediaExpanded}}"><view class="section-heading"><text class="section-title">素材管理</text><button class="plain-action" bindtap="chooseDocument">上传文档</button></view><view wx:for="{{media}}" wx:key="media_id" class="panel media-row"><image wx:if="{{item.kind === 'image' && item.local_path}}" src="{{item.local_path}}" mode="aspectFit" /><video wx:elif="{{item.kind === 'video' && item.local_path}}" src="{{item.local_path}}" controls /><view class="media-info"><text>{{item.title || (item.kind === 'image' ? '图片' : '视频')}}</text></view><view class="actions"><button wx:if="{{!item.local_path}}" data-index="{{index}}" bindtap="previewMedia">预览</button><button data-index="{{index}}" bindtap="addMediaBlock">加入正文</button><button wx:if="{{item.kind === 'image'}}" data-index="{{index}}" bindtap="setCover">设为封面</button></view></view><view wx:for="{{documentCandidates}}" wx:key="media_id" class="panel media-info"><text>{{item.title || '待归档文档'}}</text><button class="text-action" data-index="{{index}}" bindtap="archiveDocument">保存文档</button></view></block>
    </block>
    <view wx:if="{{preview}}" class="preview studio-preview"><template is="content-presentation" data="{{view: presentationView, tracking: false, mediaErrors: presentationMediaErrors}}"/></view>
    <block wx:if="{{moreExpanded && !preview}}"><button wx:if="{{version > 0 && status !== 'revoked'}}" class="danger revoke-button" bindtap="revoke" disabled="{{busy}}">撤回发布</button><button class="text-action {{pinned ? 'selected' : ''}}" bindtap="togglePinned">{{pinned ? '已置顶' : '置顶'}}</button><button wx:if="{{id && status === 'draft' && version === 0 && !serverReadOnly}}" class="danger delete-draft-button" bindtap="deleteDraft">删除草稿</button></block>
    <view class="editor-actions"><block wx:if="{{preview}}"><button class="secondary" bindtap="returnToEdit" disabled="{{busy}}">返回编辑</button><button class="primary publish-button" bindtap="publish" loading="{{busy}}" disabled="{{busy}}">发布</button></block><block wx:else><button class="secondary" bindtap="saveDraft" loading="{{busy}}" disabled="{{busy}}">保存草稿</button><button class="primary" bindtap="saveAndPreview" loading="{{busy}}" disabled="{{busy}}">预览发布</button></block></view>
   </block>
  </block>
 </view>
</view>
</block>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
