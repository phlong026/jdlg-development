<block wx:if="{{__profileAccessMounted}}">
<view class="private-page">
 <navigation-bar title="{{preview ? '发布预览' : id ? '编辑内容' : '新建内容'}}" back="{{true}}" custom-back="{{true}}" bind:back="handleBack" background="#fbfaf7" />
 <view class="page-body">
  <view wx:if="{{loading}}" class="state" role="status">正在加载授权素材…</view>
  <view wx:elif="{{loginRequired}}" class="state"><text>请先登录后编辑内容。</text><button class="primary compact" bindtap="goLogin">去登录</button></view>
  <view wx:elif="{{denied}}" class="state"><text>当前账号没有内容管理权限。</text><button class="secondary compact" bindtap="retry">重新检查</button></view>
  <view wx:elif="{{disabled}}" class="state">手机内容制作暂未开通。</view>
  <block wx:else>
   <view wx:if="{{!preview}}" class="editor-hero"><view class="status-badge {{status}}">{{status === 'published' ? '已发布' : status === 'revoked' ? '已撤回' : status === 'deleted' ? '已删除' : '草稿'}}</view><button wx:if="{{!deleted && id}}" class="plain-action" bindtap="toggleMore" aria-expanded="{{moreExpanded}}">更多</button></view>
   <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
   <block wx:if="{{deleted}}"><view class="state"><text>这份草稿已删除，原媒体资料仍保留在授权素材库。</text><button class="secondary compact" bindtap="backToWorkbench">返回内容工作台</button></view></block>
   <block wx:elif="{{documentReadOnly}}">
    <view class="panel document-panel"><text class="section-title">{{title}}</text><text class="muted">{{documentAsset.title || (documentAsset.mime === 'application/pdf' ? 'PDF' : documentAsset.mime === 'application/vnd.openxmlformats-officedocument.presentationml.presentation' ? 'PPT' : 'Word')}} · 仅授权可见</text><button class="primary" bindtap="openDocument" loading="{{busy}}" disabled="{{busy || !documentAsset}}">打开文档</button></view>
    <button wx:if="{{moreExpanded && id && status === 'draft' && version === 0 && !serverReadOnly}}" class="danger delete-draft-button" bindtap="deleteDraft" disabled="{{busy}}">删除资料</button>
   </block>
   <block wx:elif="{{legacyReadOnly}}">
    <view class="notice">此内容暂仅支持查看，可在管理后台编辑。</view>
    <view class="panel legacy-panel"><text class="section-title">{{title}}</text><rich-text wx:if="{{body_format === 'rich_text'}}" nodes="{{legacyBody}}" /><text wx:else user-select="true">{{legacyBody}}</text></view>
    <view wx:if="{{legacyMedia.length}}" class="section-heading"><text class="section-title">原内容媒体</text></view>
    <view wx:for="{{legacyMedia}}" wx:key="media_id" class="panel media-row"><image wx:if="{{item.kind === 'image' && item.local_path}}" src="{{item.local_path}}" mode="aspectFit" /><video wx:elif="{{item.kind === 'video' && item.local_path}}" src="{{item.local_path}}" controls /><view wx:else class="muted">私有媒体预览暂不可用</view></view>
   </block>
   <block wx:else>
    <block wx:if="{{!preview}}">
    <view class="panel form-panel">
     <input class="title-input" value="{{title}}" maxlength="80" data-field="title" bindinput="setField" placeholder="填写标题" aria-label="内容标题" />
     <button class="settings-toggle" bindtap="toggleSettings" aria-expanded="{{settingsExpanded}}"><text>内容设置</text><text class="muted">{{rights === 'authorized' ? '已获授权' : '自有素材'}} {{settingsExpanded ? '⌃' : '›'}}</text></button>
     <block wx:if="{{settingsExpanded}}">
      <label wx:if="{{context.owner_choices.length > 1}}" class="field"><text class="field-label">内容归属</text><picker range="{{context.owner_choices}}" range-key="display_name" value="{{ownerIndex}}" bindchange="setOwner"><view class="picker">{{ownerDisplayName || '请选择'}}</view></picker></label>
      <view class="field"><text class="field-label">素材版权来源</text><radio-group class="rights" bindchange="setRights"><label><radio value="own" checked="{{rights === 'own'}}" color="#a87943" />自有素材</label><label><radio value="authorized" checked="{{rights === 'authorized'}}" color="#a87943" />已获授权</label></radio-group></view>
      <label class="field"><text class="field-label">来源说明</text><input value="{{source_note}}" maxlength="2000" data-field="source_note" bindinput="setField" placeholder="选填" /></label>
      <label class="field"><text class="field-label">原文链接</text><input value="{{source_url}}" data-field="source_url" bindinput="setField" placeholder="选填" /></label>
      <label class="field"><text class="field-label">标签 <text class="optional">最多10个，空格分隔</text></text><input value="{{tagsText}}" bindinput="setTags" maxlength="200" placeholder="如：现代简约 三层 120平" /></label>
     </block>
    </view>
    <view wx:if="{{layoutReadOnly}}" class="notice">正文保留原排版，暂不支持编辑。</view>
    <view wx:if="{{layoutReadOnly}}" class="panel article-layout-preview">
     <view class="section-heading"><text class="section-title">导入正文</text><text class="section-caption">保留原排版 · 正文只读</text></view>
     <block wx:for="{{layoutBlocks}}" wx:key="key"><rich-text wx:if="{{item.kind === 'layout'}}" class="article-layout" nodes="{{item.html}}" selectable="{{true}}" /><view wx:else class="{{item.className}}" style="{{item.style}}"><video id="{{item.domId}}" src="{{item.url}}" style="width:100%;height:{{item.height}}px" controls object-fit="contain" /></view></block>
    </view>
    <block wx:if="{{!layoutReadOnly}}">
     <view class="section-heading content-heading"><text class="section-title">正文</text><view class="heading-actions"><button class="text-action ai-action" bindtap="openAIWriting" disabled="{{busy}}">AI文案</button><button class="text-action" bindtap="showInsertMenu" disabled="{{busy}}">插入块</button></view></view>
     <view wx:for="{{renderedBlocks}}" wx:key="index" class="panel block">
      <textarea wx:if="{{item.kind === 'paragraph' || item.kind === 'heading' || item.kind === 'quote'}}" class="{{item.kind}}" value="{{item.text}}" data-index="{{index}}" bindinput="editBlock" auto-height maxlength="{{item.kind === 'heading' ? 500 : 10000}}" placeholder="{{item.kind === 'heading' ? '输入小标题（H2/H3）' : item.kind === 'quote' ? '输入引用内容' : '输入段落'}}" />
      <view wx:elif="{{item.kind === 'list'}}" class="list-editor">
       <view class="list-toolbar"><button class="text-action" data-index="{{index}}" bindtap="toggleListOrdered">{{item.ordered ? '改为无序列表' : '改为有序列表'}}</button></view>
       <view wx:for="{{item.items}}" wx:for-item="listItem" wx:for-index="itemIndex" wx:key="itemIndex" class="list-item-row">
        <text class="list-marker">{{item.ordered ? itemIndex + 1 + '.' : '•'}}</text>
        <input value="{{listItem}}" data-index="{{index}}" data-item-index="{{itemIndex}}" bindinput="editListItem" maxlength="2000" placeholder="列表项" />
        <button wx:if="{{item.items.length > 1}}" class="remove list-item-remove" data-index="{{index}}" data-item-index="{{itemIndex}}" bindtap="removeListItem">删项</button>
       </view>
       <button class="text-action" data-index="{{index}}" bindtap="addListItem">＋ 列表项</button>
      </view>
      <block wx:else><image wx:if="{{item.kind === 'image' && item.asset && item.asset.local_path}}" src="{{item.asset.local_path}}" mode="aspectFit" /><video wx:elif="{{item.kind === 'video' && item.asset && item.asset.local_path}}" src="{{item.asset.local_path}}" controls /><view wx:else class="muted media-placeholder">私有媒体预览暂不可用</view><input class="caption-input" value="{{item.caption}}" data-index="{{index}}" bindinput="editCaption" maxlength="500" placeholder="{{item.kind === 'video' ? '视频说明（选填）' : '图注（选填）'}}" aria-label="媒体说明" /></block>
      <view wx:if="{{renderedBlocks.length > 1 || item.kind !== 'paragraph' || item.text}}" class="actions"><button wx:if="{{item.kind === 'paragraph'}}" data-index="{{index}}" data-to="heading" bindtap="convertBlock">转标题</button><button wx:if="{{item.kind === 'paragraph' || item.kind === 'heading'}}" data-index="{{index}}" data-to="quote" bindtap="convertBlock">转引用</button><button wx:if="{{item.kind === 'heading' || item.kind === 'quote'}}" data-index="{{index}}" data-to="paragraph" bindtap="convertBlock">转段落</button><button wx:if="{{item.kind === 'heading'}}" class="{{item.level === 2 ? 'selected' : ''}}" data-index="{{index}}" data-level="2" bindtap="setHeadingLevel">H2</button><button wx:if="{{item.kind === 'heading'}}" class="{{item.level === 3 ? 'selected' : ''}}" data-index="{{index}}" data-level="3" bindtap="setHeadingLevel">H3</button><button wx:if="{{renderedBlocks.length > 1}}" data-index="{{index}}" data-step="-1" bindtap="moveBlock" disabled="{{index === 0}}">上移</button><button wx:if="{{renderedBlocks.length > 1}}" data-index="{{index}}" data-step="1" bindtap="moveBlock" disabled="{{index === renderedBlocks.length - 1}}">下移</button><button class="remove" data-index="{{index}}" bindtap="removeBlock">移除</button></view>
     </view>
     <view class="insert-actions"><button class="text-action" bindtap="chooseMedia" disabled="{{busy || !context.media_upload_configured}}">添加图片／视频</button><button class="plain-action" bindtap="openMediaPicker" disabled="{{busy}}">选择已有素材</button><button class="plain-action" bindtap="toggleMedia" aria-expanded="{{mediaExpanded}}">素材管理 {{mediaExpanded ? '⌃' : '›'}}</button></view>
     <block wx:if="{{mediaExpanded}}">
     <view class="section-heading"><text class="section-title">已上传素材</text><button class="plain-action" bindtap="chooseDocument" disabled="{{busy || !context.media_upload_configured}}">上传文档（PDF/Word/PPT）</button></view>
     <view wx:if="{{documentCandidates.length}}" class="panel"><text class="section-title">文档</text><view wx:for="{{documentCandidates}}" wx:key="media_id" class="media-info"><view><text>{{item.title || '待归档文档'}}</text><text class="muted">{{item.mime === 'application/pdf' ? 'PDF' : item.mime === 'application/vnd.openxmlformats-officedocument.presentationml.presentation' ? 'PPT' : 'Word'}}</text></view><button class="text-action" data-index="{{index}}" bindtap="archiveDocument" disabled="{{busy}}">保存文档</button></view></view>
     <view wx:if="{{!media.length && !documentCandidates.length}}" class="state empty-state">暂无已上传素材</view>
     <view wx:for="{{media}}" wx:key="media_id" class="panel media-row">
      <image wx:if="{{item.kind === 'image' && item.local_path}}" src="{{item.local_path}}" mode="aspectFit" /><video wx:elif="{{item.kind === 'video' && item.local_path}}" src="{{item.local_path}}" controls />
      <view class="media-info"><text>{{item.title || (item.kind === 'image' ? '图片' : '视频')}}</text></view>
      <view class="actions"><button wx:if="{{!item.local_path}}" data-index="{{index}}" bindtap="previewMedia">预览</button><button data-index="{{index}}" bindtap="addMediaBlock">加入正文</button><button wx:if="{{item.kind === 'image'}}" class="{{cover_media_id === item.media_id ? 'selected' : ''}}" data-index="{{index}}" bindtap="setCover">{{cover_media_id === item.media_id ? '已设封面' : '设为封面'}}</button></view>
     </view>
     </block>
    </block>
    </block>
    <view wx:if="{{preview}}" class="preview">
     <view class="preview-heading"><text class="preview-title">{{preview.content.title}}</text></view><text class="section-caption">{{rights === 'authorized' ? '已获授权素材' : '自有素材'}} · 发布后可分享</text>
     <image wx:if="{{previewCover && previewCover.local_path}}" class="preview-cover" src="{{previewCover.local_path}}" mode="aspectFit" /><view wx:elif="{{previewCover}}" class="muted media-placeholder">封面预览加载失败<button data-media-id="{{previewCover.media_id}}" bindtap="retryPreviewMedia" disabled="{{busy}}">重试封面</button></view>
     <block wx:if="{{previewLayoutReadOnly}}"><block wx:for="{{previewLayoutBlocks}}" wx:key="key"><rich-text wx:if="{{item.kind === 'layout'}}" class="article-layout" nodes="{{item.html}}" selectable="{{true}}" /><view wx:else class="{{item.className}}" style="{{item.style}}"><video id="{{item.domId}}" src="{{item.url}}" style="width:100%;height:{{item.height}}px" controls object-fit="contain" /></view></block></block>
     <block wx:else><view wx:for="{{previewBlocks}}" wx:key="index" class="preview-block"><view wx:if="{{item.kind === 'list'}}"><text wx:for="{{item.items}}" wx:for-item="listItem" wx:for-index="listIndex" wx:key="listIndex">{{item.ordered ? (listIndex + 1) + '. ' : '• '}}{{listItem}}\n</text></view><text wx:elif="{{item.text}}">{{item.text}}</text><image wx:elif="{{item.kind === 'image' && item.asset && item.asset.local_path}}" src="{{item.asset.local_path}}" mode="aspectFit" /><video wx:elif="{{item.kind === 'video' && item.asset && item.asset.local_path}}" src="{{item.asset.local_path}}" controls /><view wx:else class="muted media-placeholder">媒体预览加载失败<button data-media-id="{{item.media_id}}" bindtap="retryPreviewMedia" disabled="{{busy}}">重试媒体</button></view><text wx:if="{{item.caption}}" class="muted caption">{{item.caption}}</text></view></block>
    </view>
    <view wx:if="{{!preview && status === 'published' && version > 0}}" class="published-card"><view><text class="published-title">已发布 · V{{version}}</text></view><button class="secondary compact" bindtap="openPublished">查看并分享</button></view>
    <block wx:if="{{moreExpanded && !preview}}"><button wx:if="{{version > 0 && status !== 'revoked'}}" class="danger revoke-button" bindtap="revoke" disabled="{{busy}}">撤回发布</button><button class="text-action {{pinned ? 'selected' : ''}}" bindtap="togglePinned" disabled="{{busy}}">{{pinned ? '已置顶' : '置顶'}}</button>
<button wx:if="{{id && status === 'draft' && version === 0 && !serverReadOnly}}" class="danger delete-draft-button" bindtap="deleteDraft" disabled="{{busy}}">删除草稿</button></block>
    <view class="editor-actions"><block wx:if="{{preview}}"><button class="secondary" bindtap="returnToEdit" disabled="{{busy}}">返回编辑</button><button class="primary publish-button" bindtap="publish" loading="{{busy}}" disabled="{{busy}}">发布</button></block><block wx:else><button class="secondary" bindtap="saveDraft" loading="{{busy}}" disabled="{{busy}}">保存</button><button class="primary" bindtap="saveAndPreview" loading="{{busy}}" disabled="{{busy}}">预览</button></block></view>
   </block>
  </block>
 </view>
</view>
</block>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
