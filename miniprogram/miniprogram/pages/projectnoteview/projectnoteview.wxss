@import "/components/project-note-document/note-document.wxss";

page{background:#fbfaf7;color:#312417}.page{min-height:100vh;padding:18rpx 28rpx 120rpx;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.state{min-height:65vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:30rpx;padding:40rpx;color:#75685b;text-align:center}
.brand{display:flex;align-items:center;gap:18rpx;padding:18rpx 8rpx}.brand-mark{display:flex;width:72rpx;height:72rpx;align-items:center;justify-content:center;border-radius:50%;background:#5b3923;color:#fff;font-family:serif;font-size:34rpx}.brand-name{display:block;font-size:27rpx;font-weight:650}.private-label{margin-left:auto;padding:8rpx 14rpx;border:1rpx solid #c5a27a;border-radius:20rpx;color:#966a38;font-size:22rpx}
.header{padding:16rpx 10rpx 18rpx}.project{display:inline-flex;padding:8rpx 18rpx;border-radius:999rpx;background:#f3ede5;color:#7e5a36;font-size:23rpx}.title{display:block;margin:20rpx 0 10rpx;font-size:42rpx;font-weight:650;line-height:1.35}.version-line{display:flex;align-items:center;gap:12rpx}.version-badge{padding:6rpx 14rpx;border-radius:999rpx;background:#f1e5d5;color:#8c5e31;font-size:21rpx}.muted{display:block;color:#83776b;font-size:23rpx;line-height:1.65}.version-line .muted{margin:0}
.paper,.card{margin-bottom:18rpx;padding:28rpx;border:1rpx solid #e8ddd0;border-radius:20rpx;background:#fff}.paper{font-size:29rpx;line-height:1.85}.reader-document{padding:0 10rpx 28rpx}.reader-document .note-gallery,.reader-document .note-media{margin:16rpx 0 28rpx}.reader-body{display:block;white-space:pre-wrap;color:#33271d;font-size:29rpx;line-height:1.9}.fixed-version-note{display:block;margin:10rpx 10rpx 26rpx;padding-top:24rpx;border-top:1rpx solid #eee5da;color:#8c7d6f;font-size:23rpx}.section-title{display:block;margin-bottom:18rpx;font-size:31rpx;font-weight:650}
.primary,.secondary,.share{width:100%;box-sizing:border-box;margin-top:20rpx;padding:20rpx 26rpx;border-radius:12rpx;font-size:27rpx}.primary,.share{background:#9f7140;color:#fff}.secondary{border:1rpx solid #aa8358;background:#fff;color:#80572f}.primary::after,.secondary::after,.share::after{border:0}
.feedback{padding:20rpx 0;border-bottom:1rpx solid #eee5da;font-size:26rpx;line-height:1.7}.feedback:last-child{border-bottom:0}.feedback-text{display:block;white-space:pre-wrap}.rating-label{display:block;margin-bottom:10rpx;color:#8e642e;font-weight:600}.resolution{display:block;margin-top:12rpx;padding:16rpx 18rpx;border-radius:12rpx;background:#f6f2ec;color:#65584d;font-size:24rpx;line-height:1.65}.feedback-help{margin-top:18rpx}.feedback-card textarea{width:100%;min-height:170rpx;box-sizing:border-box;margin-top:18rpx;padding:22rpx;border-radius:12rpx;background:#f7f5f2;font-size:26rpx;line-height:1.65}
.satisfaction-options{display:grid;gap:2rpx;margin-top:18rpx}.satisfaction-options label{display:flex;align-items:center;gap:10rpx;padding:12rpx 0;font-size:25rpx}.confirm{border-color:#c4a071;background:#fffcf6}.notice{margin:20rpx 0;padding:22rpx;border-radius:12rpx;background:#eff8ef;color:#3f7040}.footer{display:block;margin:24rpx;color:#897d71;font-size:22rpx;line-height:1.6;text-align:center}.picker{padding:22rpx;border-radius:12rpx;background:#f8f3ea;color:#6f4d28}.actions{display:flex;align-items:center;gap:12rpx}.actions button{flex:1}.actions .muted{white-space:nowrap}
@media (max-width:360px){.title{font-size:41rpx}.actions{display:grid;grid-template-columns:1fr 1fr}.actions .muted{grid-column:1/-1;text-align:center}}
.article-media-missing{display:block;margin:12rpx 0;padding:24rpx;text-align:center;color:#8a6d3b;background:#fbf3e2;border-radius:8rpx;font-size:24rpx}
.share-dock{position:fixed;z-index:30;left:0;right:0;bottom:0;display:grid;grid-template-columns:1fr;padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e9dfd2;background:rgba(255,255,255,.97);box-shadow:0 -8rpx 28rpx rgba(69,43,22,.08)}.share-dock-split{grid-template-columns:1fr 1.7fr;gap:14rpx}.share-dock .primary,.share-dock .secondary{width:100%;margin-top:0}
.page{padding-bottom:180rpx}
.reader-document .note-gallery-swiper,.reader-document .note-media image,.reader-document .note-media video{background:transparent}
.reader-document .note-gallery-meta{position:relative}
.reader-document .note-gallery-count{position:absolute;right:12rpx;bottom:100%;margin-bottom:12rpx;padding:3rpx 12rpx;border-radius:999rpx;background:rgba(33,28,23,.55);color:#fff}
