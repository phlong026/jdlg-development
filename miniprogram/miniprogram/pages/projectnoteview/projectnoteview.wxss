page{background:#f7f3ed;color:#312417}.page{min-height:100vh;padding:32rpx 28rpx 120rpx;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.state{min-height:65vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:30rpx;color:#75685b;padding:40rpx}.brand{display:flex;align-items:center;gap:18rpx;padding:18rpx 8rpx}.brand-mark{width:72rpx;height:72rpx;border-radius:50%;background:#5b3923;color:#fff;display:flex;align-items:center;justify-content:center;font-family:serif;font-size:34rpx}.brand-name{font-size:27rpx;font-weight:650;display:block}.private-label{margin-left:auto;font-size:22rpx;color:#966a38;border:1rpx solid #c5a27a;padding:8rpx 14rpx;border-radius:20rpx}.header{padding:42rpx 10rpx 28rpx}.project{display:block;color:#a87943;font-size:24rpx}.title{display:block;font-size:46rpx;font-weight:650;line-height:1.35;margin:16rpx 0}.muted{display:block;color:#83776b;font-size:23rpx;line-height:1.65}.paper,.card{background:#fff;border:1rpx solid #e8ddd0;border-radius:20rpx;padding:34rpx;margin-bottom:24rpx}.paper{line-height:1.85;font-size:29rpx}.article-heading{font-size:38rpx;font-weight:650;margin:28rpx 0 14rpx}.article-quote{border-left:6rpx solid #b89062;padding-left:22rpx;color:#66594e}.list-item{padding:8rpx 0}.media image,.media video{width:100%;margin:22rpx 0;background:#eee}.caption{display:block;text-align:center;color:#85786b;font-size:23rpx}.section-title{font-size:31rpx;font-weight:650;display:block;margin-bottom:18rpx}.feedback{padding:18rpx 0;border-bottom:1rpx solid #eee5da;font-size:26rpx}.card textarea{width:100%;box-sizing:border-box;min-height:150rpx;background:#f7f5f2;border-radius:12rpx;padding:22rpx;margin-top:20rpx}.confirm{border-color:#c4a071;background:#fffcf6}.primary,.secondary,.share,.attachment{padding:20rpx 26rpx;border-radius:12rpx;font-size:27rpx;margin-top:20rpx}.primary,.share{background:#9f7140;color:#fff}.secondary,.attachment{border:1rpx solid #aa8358;color:#80572f;background:#fff}.notice{background:#eff8ef;color:#3f7040;padding:22rpx;border-radius:12rpx;margin:20rpx 0}.footer{display:block;text-align:center;color:#897d71;font-size:22rpx;line-height:1.6;margin:24rpx}.share{width:100%}.plain{white-space:pre-wrap}

.rating-label{display:block;color:#8e642e;font-weight:600;margin-bottom:12rpx}.satisfaction-options label{display:flex;align-items:center;gap:10rpx;padding:14rpx 0;font-size:25rpx}

.picker{padding:22rpx;background:#f8f3ea;border-radius:12rpx;color:#6f4d28}.actions{display:flex;align-items:center;gap:12rpx}.actions button{flex:1}.actions .muted{white-space:nowrap}
