page {
  background: #fbfaf7;
  color: #30251c;
}

.writing-page {
  min-height: 100vh;
  background: #fbfaf7;
  font-size: 28rpx;
}

.writing-body {
  padding: 24rpx 32rpx calc(156rpx + env(safe-area-inset-bottom));
}

.writing-tabs {
  display: flex;
  border-bottom: 1rpx solid #e8e1d8;
  margin-bottom: 28rpx;
}

.writing-tab {
  flex: 1;
  padding: 14rpx 4rpx 22rpx;
  margin: 0;
  border-radius: 0;
  font-size: 28rpx;
  line-height: 1.5;
  background: transparent;
  color: #544a40;
}

.writing-tab::after {
  border: 0;
}

.writing-tab.active {
  color: #a87943;
  border-bottom: 4rpx solid #a87943;
  font-weight: 600;
}

.writing-panel {
  padding: 26rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 18rpx;
}

.section-title {
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.5;
}

.field {
  display: block;
  margin-top: 24rpx;
}

.field-title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  color: #62584d;
}

.optional {
  font-size: 22rpx;
  color: #9b9389;
}

.field input, .field textarea {
  display: block;
  box-sizing: border-box;
  width: 100%;
  background: #faf9f6;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.field input {
  height: 88rpx;
  padding: 0 20rpx;
  line-height: normal;
}

.field textarea {
  min-height: 176rpx;
}

.placeholder {
  color: #9b968e;
}

.panel-caption {
  display: block;
  color: #91897f;
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 18rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  gap: 16rpx;
}



.writing-result {
  box-sizing: border-box;
  width: 100%;
  padding: 22rpx;
  background: #faf9f6;
  border-radius: 10rpx;
  min-height: 310rpx;
  font-size: 28rpx;
  line-height: 1.9;
  color: #3d352e;
}

.refine-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.refine-actions button {
  flex: 1;
  padding: 16rpx 0;
  background: #f8f5ef;
  font-size: 26rpx;
  line-height: 1.5;
  color: #745331;
  border: 1rpx solid #eee6db;
  border-radius: 10rpx;
}

.refine-actions button::after {
  border: 0;
}

.refine-actions button[disabled] {
  color: #aaa49a;
  background: #f5f4f1;
}

.feedback {
  display: block;
  margin: 12rpx 0 20rpx;
  font-size: 25rpx;
  line-height: 1.7;
  padding: 20rpx;
  border-radius: 10rpx;
}

.error {
  color: #a54435;
  background: #fcf0ec;
}

.notice {
  color: #6d6847;
  background: #f3f1e7;
}

.generation-hint {
  display: block;
  font-size: 23rpx;
  color: #8f867b;
  line-height: 1.7;
}

.writing-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  box-sizing: border-box;
  padding: 18rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: #fbfaf7;
  border-top: 1rpx solid #eee6dc;
}

.primary, .secondary {
  box-sizing: border-box;
  width: 100%;
  font-size: 28rpx;
  line-height: 82rpx;
  height: 84rpx;
  border-radius: 10rpx;
  margin: 0;
}

.primary {
  color: #fff;
  background: #a87943;
}

.secondary {
  background: transparent;
  border: 2rpx solid #a87943;
  color: #9a6b36;
}

.primary::after, .secondary::after {
  border: 0;
}

.writing-footer .primary, .writing-footer .secondary {
  flex: 1;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0 12rpx;
  white-space: nowrap;
  font-size: 26rpx;
}

.primary[disabled] {
  color: #fff;
  background: #c7b295;
}

.secondary[disabled] {
  color: #afa69b;
  border-color: #d7cec3;
}

.login-state {
  padding: 40rpx 28rpx;
  background: #fff;
  border-radius: 18rpx;
  line-height: 1.8;
}

.login-state .secondary {
  margin-top: 24rpx;
}

/* 语音是输入辅助，保持次级视觉权重与可长按的触控面积。 */
.voice-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

button.voice-button {
  width: auto;
  min-height: 88rpx;
  margin: 0;
  padding: 0 16rpx;
  gap: 10rpx;
  border: 0;
  border-radius: 12rpx;
  background: transparent;
  color: #806345;
  font-size: 25rpx;
  white-space: nowrap;
}

button.voice-button.active {
  color: #8c5e32;
  background: #f1e4d2;
}

button {
  min-height: 82rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  /* 统一垂直居中基线：原生 button 的默认 line-height 配合 min-height 会让文字偏移。 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

button::after {
  border: 0;
}

.stream-preview {
  min-height: 200rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #ded5cc;
  border-radius: 14rpx;
  background: #fdfcfb;
  font-size: 28rpx;
  line-height: 1.7;
}

.stream-text {
  white-space: pre-wrap;
  word-break: break-all;
}

.deep-chat {
  width: auto;
  min-height: 72rpx;
  margin: 0 0 12rpx;
  padding: 0;
  justify-content: flex-start;
  border: 0;
  background: transparent;
  color: #98683a;
  font-size: 26rpx;
}

.picker-value {
  min-height: 82rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #ded5cc;
  border-radius: 14rpx;
  background: #fdfcfb;
  font-size: 28rpx;
  color: #6d6258;
  display: flex;
  align-items: center;
}

.writing-footer-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.writing-error {
  display: block;
  box-sizing: border-box;
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
  color: #a54435;
  background: #fcf0ec;
}

/* 与固定栏错误同宽同排版，按实际换行高度给正文留位。 */
.writing-error-reserve {
  visibility: hidden;
  pointer-events: none;
}

.writing-navigation { position: sticky; top: 0; z-index: 30; background: #fbfaf7; }
