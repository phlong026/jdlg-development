page {
  background: #faf8f4;
  color: #30251c;
}

.writing-page {
  min-height: 100vh;
  background: #faf8f4;
  font-size: 28rpx;
}

.writing-body {
  padding: 24rpx 32rpx calc(250rpx + env(safe-area-inset-bottom));
}

.page-title {
  display: block;
  margin-bottom: 28rpx;
  font-size: 46rpx;
  line-height: 1.3;
  font-weight: 650;
  color: #302117;
}

.writing-tabs {
  display: flex;
  border-bottom: 1rpx solid #e8e1d8;
  margin-bottom: 28rpx;
}

.writing-tab {
  flex: 1;
  padding: 14rpx 4rpx 22rpx;
  margin: 0;
  border-radius: 0;
  font-size: 28rpx;
  line-height: 1.5;
  background: transparent;
  color: #544a40;
}

.writing-tab::after {
  border: 0;
}

.writing-tab.active {
  color: #a87943;
  border-bottom: 4rpx solid #a87943;
  font-weight: 600;
}

.writing-panel {
  padding: 26rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 18rpx;
}

.section-title {
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.5;
}

.field {
  display: block;
  margin-top: 24rpx;
}

.field-title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  color: #62584d;
}

.optional {
  font-size: 22rpx;
  color: #9b9389;
}

.field input, .field textarea {
  display: block;
  box-sizing: border-box;
  width: 100%;
  background: #faf9f6;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.field input {
  height: 88rpx;
  padding: 0 20rpx;
  line-height: normal;
}

.field textarea {
  min-height: 176rpx;
}

.placeholder {
  color: #9b968e;
}

.panel-caption {
  display: block;
  color: #91897f;
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 18rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  gap: 16rpx;
}

.edit-hint {
  font-size: 23rpx;
  color: #938879;
}

.writing-result {
  box-sizing: border-box;
  width: 100%;
  padding: 22rpx;
  background: #faf9f6;
  border-radius: 10rpx;
  min-height: 310rpx;
  font-size: 28rpx;
  line-height: 1.9;
  color: #3d352e;
}

.refine-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.refine-actions button {
  flex: 1;
  padding: 16rpx 0;
  background: #f8f5ef;
  font-size: 26rpx;
  line-height: 1.5;
  color: #745331;
  border: 1rpx solid #eee6db;
  border-radius: 10rpx;
}

.refine-actions button::after {
  border: 0;
}

.refine-actions button[disabled] {
  color: #aaa49a;
  background: #f5f4f1;
}

.feedback {
  display: block;
  margin: 12rpx 0 20rpx;
  font-size: 25rpx;
  line-height: 1.7;
  padding: 20rpx;
  border-radius: 10rpx;
}

.error {
  color: #a54435;
  background: #fcf0ec;
}

.notice {
  color: #6d6847;
  background: #f3f1e7;
}

.generation-hint {
  display: block;
  font-size: 23rpx;
  color: #8f867b;
  line-height: 1.7;
}

.writing-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  box-sizing: border-box;
  padding: 18rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: #faf8f4;
  border-top: 1rpx solid #eee6dc;
}

.primary, .secondary {
  box-sizing: border-box;
  width: 100%;
  font-size: 28rpx;
  line-height: 82rpx;
  height: 84rpx;
  border-radius: 10rpx;
  margin: 0;
}

.primary {
  color: #fff;
  background: #a87943;
}

.secondary {
  background: transparent;
  border: 2rpx solid #a87943;
  color: #9a6b36;
}

.primary::after, .secondary::after {
  border: 0;
}

.writing-footer .primary, .writing-footer .secondary {
  width: 100%;
  margin-left: 0;
  margin-right: 0;
}

.writing-footer .secondary {
  margin-top: 16rpx;
}

.primary[disabled] {
  color: #fff;
  background: #c7b295;
}

.secondary[disabled] {
  color: #afa69b;
  border-color: #d7cec3;
}

.login-state {
  padding: 40rpx 28rpx;
  background: #fff;
  border-radius: 18rpx;
  line-height: 1.8;
}

.login-state .secondary {
  margin-top: 24rpx;
}
