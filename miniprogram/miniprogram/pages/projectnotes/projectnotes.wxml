<block wx:if="{{__profileAccessMounted}}">
<import src="/components/project-note-document/note-document.wxml" />
<navigation-bar title="{{navigationTitle}}" back="{{true}}" custom-back="{{true}}" bind:back="handleBack" background="#f8f5ef" />
<view class="page {{pageView === 'editor' ? 'page-editor' : ''}}">
  <view wx:if="{{loading}}" class="state">正在加载…</view>
  <view wx:elif="{{loginRequired}}" class="state"><text>登录后管理项目</text><button class="primary state-action" bindtap="goLogin">去登录</button></view>
  <view wx:elif="{{projectLoadFailed}}" class="state"><text>{{error}}</text><button class="secondary state-action" bindtap="retryProjectAccess">重新加载</button></view>
  <view wx:elif="{{accessRecheckRequired}}" class="state"><text>{{notice}}</text><button class="secondary state-action" bindtap="retryProjectAccess">重新加载</button></view>
  <block wx:else>
    <view wx:if="{{error && pageView !== 'editor'}}" class="alert error">{{error}}</view><view wx:if="{{notice && pageView !== 'editor'}}" class="alert success">{{notice}}</view><view wx:if="{{truncationNotice}}" class="alert warning">{{truncationNotice}}</view><view wx:if="{{historyNotice}}" class="alert warning">{{historyNotice}}</view>

    <block wx:if="{{pageView === 'list'}}">
      <view class="list-header"><text class="count">{{projects.length}} 个项目</text><button wx:if="{{projects.length}}" class="primary list-create" bindtap="openProjectCreation" disabled="{{busy}}">新建项目</button></view>
      <view wx:if="{{!projects.length}}" class="empty-card"><text class="empty-title">还没有项目</text><button class="primary empty-action" bindtap="openProjectCreation">新建项目</button></view>
      <view wx:else class="project-list"><button wx:for="{{projects}}" wx:key="project_id" class="project-row" data-id="{{item.project_id}}" bindtap="selectProject" bindlongpress="openProjectDeleteMenu"><view><view class="project-name-line"><text class="project-name">{{item.name}}</text><text wx:if="{{item.stage_label}}" class="stage-label">{{item.stage_label}}</text></view><text class="project-meta">{{item.location || item.style || '项目资料待完善'}}</text></view><text class="arrow">›</text></button></view>
    </block>

    <block wx:elif="{{pageView === 'create'}}">
      <view class="card create-card">
        <text class="field-label">项目名称</text>
        <input value="{{projectName}}" bindinput="setProjectName" maxlength="100" placeholder="例如：林宅改造" focus="{{true}}" />
        <label wx:if="{{ownerChoices.length > 1}}" class="owner-field"><text class="field-label">项目归属</text><picker range="{{ownerChoices}}" range-key="display_name" value="{{ownerIndex}}" bindchange="setOwnerID"><view class="picker compact-picker">{{ownerChoices[ownerIndex].display_name}} <text class="arrow small">›</text></view></picker></label>
        <button class="primary" loading="{{busy}}" disabled="{{busy || !projectName || !ownerID}}" bindtap="createProjectNoteProject">创建项目</button>
      </view>
    </block>

    <block wx:elif="{{pageView === 'detail' && selectedProject}}">
      <view class="project-head"><view><text class="project-title">{{selectedProject.name}}</text><view class="project-summary"><text class="status">{{projectStatusLabel}}</text><text wx:if="{{selectedProject.creator_display_name}}" class="creator">创建人 · {{selectedProject.creator_display_name}}</text></view></view><button class="text-button" bindtap="openProjectSettings">编辑资料</button></view>
      <view wx:if="{{projectSettingsOpen}}" class="card form-card">
        <view class="card-head"><text class="section-title">项目资料</text><button class="text-button" bindtap="closeProjectSettings">收起</button></view>
        <text class="field-label">项目名称</text><input value="{{projectEdit.name}}" data-field="name" bindinput="setProjectField" maxlength="100" placeholder="请输入项目名称" /><text class="field-label">项目地点</text><input value="{{projectEdit.location}}" data-field="location" bindinput="setProjectField" maxlength="200" placeholder="请输入项目地点" />
        <view class="field-row"><label><text class="field-label">建筑面积（㎡）</text><input value="{{projectEdit.building_area}}" data-field="building_area" bindinput="setProjectField" type="digit" placeholder="建筑面积" /></label><label><text class="field-label">层数（层）</text><input value="{{projectEdit.floors}}" data-field="floors" bindinput="setProjectField" type="number" placeholder="层数" /></label></view>
        <text class="field-label">建筑风格</text><input value="{{projectEdit.style}}" data-field="style" bindinput="setProjectField" maxlength="100" placeholder="请输入建筑风格" /><button class="primary" bindtap="saveProjectDetails" disabled="{{busy || !projectEdit.name}}">保存</button><button wx:if="{{selectedProject.status !== 'revising'}}" class="secondary" bindtap="markProjectRevising" disabled="{{busy}}">标记为修改中</button>
      </view>
      <view class="card notes-card"><view class="card-head"><text class="section-title">项目笔记</text><button wx:if="{{notes.length}}" class="text-button" bindtap="startNewNote" disabled="{{busy}}">新建笔记</button></view><view wx:if="{{!notes.length}}" class="empty compact"><button class="primary empty-action" bindtap="startNewNote">新建笔记</button></view><button wx:for="{{notes}}" wx:key="note_id" class="content-row" data-id="{{item.note_id}}" bindtap="openNote" bindlongpress="openNoteDeleteMenu"><view><text class="row-title">{{item.title}}</text><text class="project-meta">修订 {{item.revision || 1}}</text></view><text class="arrow">›</text></button></view>
      <view wx:if="{{versionChoices.length}}" class="card"><text class="section-title">方案版本</text><button wx:for="{{versionChoices}}" wx:key="version_id" class="content-row" data-id="{{item.version_id}}" bindtap="selectVersion" disabled="{{busy}}"><text class="row-title">{{item.label}}</text><text class="arrow">›</text></button></view>
      <view class="card menu-card"><button class="menu-row" bindtap="openProjectPackage"><text class="row-title">分享资料</text><text class="arrow">›</text></button><button class="menu-row" bindtap="openMembers"><text class="row-title">项目成员</text><view class="menu-trailing"><text class="menu-meta">{{activeMembers.length}} 人</text><text class="arrow">›</text></view></button><button class="menu-row" bindtap="openHistory"><text class="row-title">项目记录</text><text class="arrow">›</text></button></view>
    </block>

    <block wx:elif="{{pageView === 'editor' && selectedProject}}">
      <view class="editor-context"><view><text class="editor-project">{{selectedProject.name}}</text><text class="editor-status">{{note ? '草稿 · 修订 ' + (note.revision || 1) : '新笔记草稿'}}</text></view><button wx:if="{{note && !historyMode}}" class="text-button" bindtap="openNoteMore" disabled="{{busy}}">更多</button></view>
      <view wx:if="{{note && notes.length > 1 && editorMode === 'edit'}}" class="editor-head"><picker range="{{notes}}" range-key="title" value="{{noteIndex}}" bindchange="selectNote" disabled="{{busy}}"><view class="picker note-picker">切换笔记 · {{note.title}}</view></picker></view>
      <view class="mode-tabs"><button class="mode-tab {{editorMode === 'edit' ? 'active' : ''}}" bindtap="editNote" disabled="{{busy}}">编辑</button><button class="mode-tab {{editorMode === 'preview' ? 'active' : ''}}" bindtap="previewNote" disabled="{{busy || !noteTitle || (!bodyReadOnly && !noteBody)}}">完整预览</button></view>

      <block wx:if="{{editorMode === 'edit'}}">
        <view wx:if="{{error}}" class="alert error editor-alert">{{error}}</view><view wx:if="{{notice}}" class="alert success editor-alert">{{notice}}</view>
        <view class="card editor-card">
          <label class="editor-field"><text class="field-label">笔记标题</text><input class="title-input" value="{{noteTitle}}" bindinput="setNoteTitle" bindkeyboardheightchange="onNoteKeyboardHeight" maxlength="80" placeholder="例如：一层平面方案说明" /></label>
          <view class="editor-divider"></view>
          <view class="editor-field"><view class="field-heading"><text class="field-label">方案内容</text><view class="field-actions"><text class="field-hint">{{noteBody.length || 0}} / 8000</text><button wx:if="{{!bodyReadOnly}}" class="text-button ai-inline" bindtap="openNoteAIWriting" disabled="{{busy}}">AI 辅助</button></view></view><text wx:if="{{bodyReadOnly}}" class="readonly-note">此内容保留原排版。可修改标题，并通过“完整预览”查看正文与素材。</text><textarea wx:else class="note-body-input" value="{{noteBody}}" bindinput="setNoteBody" bindblur="onNoteBodyBlur" bindkeyboardheightchange="onNoteKeyboardHeight" cursor-spacing="140" maxlength="8000" auto-height placeholder="记录方案要点、沟通结论和设计说明。可按空间或问题分段，方便客户阅读。" /></view>
        </view>

        <view class="card material-card"><view class="card-head"><view><text class="section-title">方案素材</text><text class="project-meta">{{noteMedia.length ? noteMedia.length + ' 项，预览时按当前顺序展示' : '可添加效果图、现场照片或讲解视频'}}</text></view></view>
          <view wx:if="{{!noteMedia.length}}" class="material-empty">暂无素材</view>
          <view wx:for="{{noteMedia}}" wx:key="media_id" class="material-row">
            <image wx:if="{{item.kind === 'image' && item.local_path}}" class="material-thumb" src="{{item.local_path}}" mode="aspectFill" data-id="{{item.media_id}}" bindtap="openImage" binderror="noteMediaLoadError" />
            <video wx:elif="{{item.kind === 'video' && item.local_path}}" binderror="noteMediaLoadError" class="material-thumb" src="{{item.local_path}}" poster="{{item.thumb_path || ''}}" controls="{{false}}" show-center-play-btn="{{true}}" object-fit="cover" data-id="{{item.media_id}}" bindtap="openNoteVideo" />
            <view wx:elif="{{item.preview_loading}}" class="material-thumb material-placeholder">素材加载中…</view>
            <view wx:else class="material-thumb material-placeholder">{{item.kind === 'private' ? '素材' : (item.kind === 'video' ? '视频' : '图片')}}</view>
            <view class="material-info"><text class="row-title">{{item.title || (item.kind === 'video' ? '项目视频' : item.kind === 'private' ? '私有素材' : '项目图片')}}</text><text wx:if="{{item.preview_error}}" class="media-error">{{item.preview_error}}</text><button wx:if="{{!item.local_path}}" class="text-button material-preview" bindtap="{{item.preview_error || item.kind !== 'private' ? 'retryNoteMediaPreview' : 'previewNote'}}" data-id="{{item.media_id}}" disabled="{{busy}}">{{item.preview_error || item.kind !== 'private' ? '重试' : '查看素材'}}</button></view>
            <button wx:if="{{!bodyReadOnly}}" class="danger-link material-remove" data-id="{{item.media_id}}" catchtap="removeNoteMedia">移除</button>
          </view>
          <view wx:if="{{mediaUploadFailures.length}}" class="material-empty"><text wx:for="{{mediaUploadFailures}}" wx:key="tempFilePath" class="media-failure-line">{{item.name}}：{{item.message}}</text></view>
          <view wx:if="{{!bodyReadOnly}}" class="material-tools"><button wx:if="{{mediaUploadFailures.length}}" class="text-button" bindtap="retryNoteMediaFailures" disabled="{{busy}}">{{mediaRetryLabel}}</button><button wx:if="{{mediaPermissionDenied}}" class="text-button" bindtap="openMediaSettings">去设置开启权限</button><button class="tool-button" bindtap="chooseNoteMedia" disabled="{{busy}}">＋ 添加图片或视频</button></view>
        </view>

        <view wx:if="{{note}}" class="card version-create-card"><view><text class="section-title">交付为固定版本</text><text class="project-meta">保存草稿后再生成，后续修改不会影响已经分享的版本。</text></view><button class="secondary" bindtap="freezeProjectNoteVersion" disabled="{{busy}}">生成方案版本</button></view>
        <view wx:if="{{note && versionChoices.length}}" class="card history-version-card"><text class="section-title">历史版本</text><button wx:for="{{versionChoices}}" wx:key="version_id" class="content-row" data-id="{{item.version_id}}" bindtap="selectVersion"><text>{{item.label}}</text><text class="arrow">›</text></button></view>
      </block>

      <block wx:else>
        <view class="preview-heading"><text class="preview-eyebrow">客户阅读效果</text><text class="preview-title">{{noteTitle}}</text><text class="project-meta">{{selectedProject.name}} · {{note ? '草稿修订 ' + (note.revision || 1) : '尚未保存'}}</text></view>
        <view wx:if="{{previewLoading}}" class="card preview-state">正在加载私有素材…</view>
        <view wx:elif="{{previewError}}" class="card preview-state preview-error"><text>{{previewError}}</text><button class="secondary" bindtap="previewNote" disabled="{{busy}}">重新预览</button></view>
        <view wx:else class="paper note-preview-paper"><template is="note-document" data="{{format: previewBodyFormat, body: previewBody, blocks: previewBlocks, media: previewMedia, groups: previewMediaGroups, galleryPositions: galleryPositions, allowAttachments: false}}" /></view>
      </block>

      <view wx:if="{{keyboardHeight === 0}}" class="editor-dock">
        <block wx:if="{{editorMode === 'edit'}}"><button class="secondary" bindtap="previewNote" disabled="{{busy || !noteTitle || (!bodyReadOnly && !noteBody)}}">预览</button><button wx:if="{{!note}}" class="primary" bindtap="createProjectNote" loading="{{busy}}" disabled="{{busy || !noteTitle || !noteBody}}">保存草稿</button><button wx:else class="primary" bindtap="saveProjectNote" loading="{{busy}}" disabled="{{busy || !noteTitle || (!bodyReadOnly && !noteBody)}}">保存草稿</button></block>
        <block wx:else><button class="secondary" bindtap="editNote" disabled="{{busy}}">返回编辑</button><button wx:if="{{!note}}" class="primary" bindtap="createProjectNote" loading="{{busy}}" disabled="{{busy || !noteTitle || !noteBody}}">保存草稿</button><button wx:else class="primary" bindtap="saveProjectNote" loading="{{busy}}" disabled="{{busy || !noteTitle || (!bodyReadOnly && !noteBody)}}">保存草稿</button></block>
      </view>
    </block>

    <block wx:elif="{{pageView === 'version' && selectedProject}}">
      <view wx:if="{{versionView}}" class="version-context"><text class="preview-eyebrow">{{selectedProject.name}}</text><view class="version-heading"><text class="version-title">{{versionView.title}}</text><text class="status">V{{versionView.revision}}</text></view><text class="project-meta">固定版本 · 后续草稿修改不会改变此内容</text></view>
      <view wx:if="{{versionView}}" class="paper fixed-preview"><template is="note-document" data="{{format: versionView.body_format, body: versionView.body, blocks: versionBlocks, media: versionMedia, groups: versionMediaGroups, galleryPositions: galleryPositions, allowAttachments: false}}" /></view>
      <view wx:if="{{frozenVersion}}" class="card action-card"><view class="share-members"><text wx:if="{{!activeMembers.length}}" class="share-warning">只有项目成员才能打开此链接，请先邀请对方成为项目成员</text><text wx:else class="project-meta">当前 {{activeMembers.length}} 位项目成员，成员登录后可打开此链接</text><text wx:if="{{joinRequests.length}}" class="project-meta">有 {{joinRequests.length}} 个待审批加入申请</text><button wx:if="{{!activeMembers.length}}" class="secondary" bindtap="createProjectInvitation" disabled="{{busy}}">一键邀请成员</button><button wx:if="{{memberInvitation}}" class="primary" open-type="share" data-kind="project-invitation">发送邀请链接</button></view><block wx:if="{{!activeShare}}"><button class="primary" bindtap="createProjectNoteShare" disabled="{{busy}}">创建分享</button></block><block wx:else><button wx:if="{{activeShare.share_token}}" class="primary" bindtap="openSharePreview">预览分享</button><button wx:if="{{activeShare.share_token}}" class="secondary" bindtap="copySharePath">复制路径</button><button class="danger" bindtap="revokeProjectNoteShare" disabled="{{busy}}">撤回分享</button></block><button class="secondary" bindtap="exportProjectNoteWord" disabled="{{busy}}" loading="{{busy}}">导出 Word</button></view>
      <view class="card feedback-card"><view class="card-head"><text class="section-title">业主反馈</text><text class="count subtle">{{feedbacks.length}} 条</text></view><text wx:if="{{!feedbacks.length}}" class="muted">暂无反馈</text><view wx:for="{{feedbacks}}" wx:key="feedback_id" class="feedback {{feedbackID === item.feedback_id ? 'selected' : ''}}"><text wx:if="{{item.satisfaction_label}}" class="rating-label">{{item.satisfaction_label}}</text><text class="feedback-text">{{item.text}}</text><text class="project-meta">{{item.resolved ? '已处理' : '待处理'}} · {{item.created_at}}</text><text wx:if="{{item.resolution_reply}}" class="feedback-reply">处理说明：{{item.resolution_reply}}</text><button wx:if="{{!item.resolved}}" class="secondary feedback-action" data-id="{{item.feedback_id}}" bindtap="selectFeedback">回复此反馈</button></view><view wx:if="{{selectedFeedback && !selectedFeedback.resolved}}" class="reply-form"><text class="field-label">处理说明</text><textarea value="{{feedbackReply}}" bindinput="setFeedbackReply" maxlength="500" placeholder="说明已经调整的内容或下一步安排" /><button class="primary" bindtap="resolveProjectNoteFeedback" disabled="{{busy || !feedbackID || !feedbackReply}}">提交并标记已处理</button></view></view>
      <view class="card"><text class="section-title">方案确认</text><text wx:if="{{!confirmations.length}}" class="muted">此版本待确认</text><view wx:for="{{confirmations}}" wx:key="confirmation_id" class="profile-row"><image wx:if="{{item.avatar}}" class="member-avatar" src="{{item.avatar}}" mode="aspectFill" /><view wx:else class="member-avatar avatar-placeholder">确</view><view><text class="row-title">{{item.display_name || '方案确认人'}}</text><text class="project-meta">{{item.confirmed_at}}</text></view></view></view>
      <button class="text-footer" bindtap="returnToDraft" disabled="{{busy}}">返回笔记编辑</button>
    </block>

    <block wx:elif="{{pageView === 'members' && selectedProject}}">
      <view class="card"><view class="card-head"><text class="section-title">{{activeMembers.length}} 位成员</text><button wx:if="{{activeMembers.length}}" class="text-button" bindtap="createProjectInvitation" disabled="{{busy}}">邀请成员</button></view><view wx:if="{{!activeMembers.length && !memberInvitation}}" class="empty compact"><button class="primary empty-action" bindtap="createProjectInvitation" disabled="{{busy}}">邀请成员</button></view><view wx:for="{{activeMembers}}" wx:key="member_id" class="member-row"><view class="member-profile"><image wx:if="{{item.avatar}}" class="member-avatar" src="{{item.avatar}}" mode="aspectFill" /><view wx:else class="member-avatar avatar-placeholder">员</view><text class="row-title">{{item.display_name || '项目成员'}}{{selectedProject.confirmer_id === item.actor_id ? ' · 确认人' : ''}}</text></view><button class="danger-link" data-account="{{item.actor_id}}" bindtap="revokeProjectNoteMember" disabled="{{busy}}">移除</button></view><view wx:if="{{memberInvitation}}" class="invite-actions"><button class="primary" open-type="share" data-kind="project-invitation">发送邀请</button></view><view wx:for="{{memberInvitations}}" wx:key="invitation_id" class="member-row"><view><text class="row-title">有效邀请</text><text class="project-meta">{{item.expiryLabel}}</text></view><button class="danger-link" data-id="{{item.invitation_id}}" bindtap="revokeProjectInvitation" disabled="{{busy}}">撤销</button></view></view>
      <view wx:if="{{requestsLoading || joinRequests.length}}" class="card"><text class="section-title">加入申请</text><text wx:if="{{requestsLoading}}" class="muted">正在加载…</text><view wx:for="{{joinRequests}}" wx:key="request_id" class="member-row"><view class="member-profile"><image wx:if="{{item.avatar}}" class="member-avatar" src="{{item.avatar}}" mode="aspectFill" /><view wx:else class="member-avatar avatar-placeholder">申</view><text class="row-title">{{item.display_name || '项目申请人'}}</text></view><button class="text-button" data-id="{{item.request_id}}" bindtap="approveProjectJoinRequest" disabled="{{busy}}">批准</button></view></view>
      <view wx:if="{{activeMembers.length}}" class="card"><text class="section-title">方案确认人</text><picker range="{{confirmerChoices}}" range-key="label" value="{{confirmerIndex}}" bindchange="setConfirmerChoice"><view class="picker">{{confirmerChoices[confirmerIndex].label}}</view></picker><button class="secondary" bindtap="setProjectNoteConfirmer" disabled="{{busy || !confirmerAccount}}">保存确认人</button></view>
    </block>

    <block wx:elif="{{pageView === 'history' && selectedProject}}">
      <view class="history-tabs"><picker range="{{historyTypes}}" range-key="label" value="{{historyIndex}}" bindchange="setHistoryType" disabled="{{busy}}"><view class="picker">{{historyTypes[historyIndex].label}}</view></picker></view>
      <view class="card history-card"><button wx:if="{{!historyLoaded}}" class="secondary" bindtap="loadHistory" loading="{{historyLoading}}">加载记录</button><view wx:if="{{historyLoaded && !historyItems.length}}" class="empty compact">暂无记录</view><view wx:for="{{historyItems}}" wx:key="key" class="history-row"><text class="row-title">{{item.displayTitle}}</text><text class="project-meta">{{item.displayText}}</text><text class="project-meta">{{item.displayTime}}</text><button wx:if="{{historyType === 'notes' || historyType === 'versions' || historyType === 'feedbacks'}}" class="text-button history-action" data-index="{{index}}" bindtap="openHistoryItem">{{historyType === 'notes' ? '编辑' : '查看'}}</button></view><view wx:if="{{historyLoaded}}" class="pager"><button class="text-button" data-direction="previous" bindtap="loadHistory" disabled="{{historyPage === 0 || historyLoading}}">上一页</button><text class="project-meta">{{historyPage + 1}}</text><button class="text-button" data-direction="next" bindtap="loadHistory" disabled="{{!historyNextCursor || historyLoading}}">下一页</button></view></view>
    </block>
  </block>
</view>
</block>
<view wx:if="{{aiPanelOpen && __profileAccessReady}}" class="ai-panel-mask" catchtap="closeNoteAI">
  <view class="ai-panel" catchtap="stopPropagation">
    <view class="ai-panel-head"><text class="section-title">AI 辅助</text><text class="text-button" bindtap="closeNoteAI">关闭</text></view>
    <text class="project-meta">只使用当前项目与笔记中已有的事实，不会虚构项目信息；结果可编辑后插入光标处。</text>
    <textarea class="ai-panel-input" value="{{aiPanelPrompt}}" bindinput="setNoteAIPrompt" maxlength="200" placeholder="可选：补充本次写作要求，例如按空间分段、更简洁" />
    <view class="ai-panel-actions"><button class="primary" bindtap="startNoteAI" loading="{{aiPanelStreaming}}" disabled="{{aiPanelStreaming}}">生成</button><button class="secondary" bindtap="insertNoteAI" disabled="{{!aiPanelText}}">插入到光标处</button><button class="text-button" bindtap="copyNoteAI" disabled="{{!aiPanelText}}">复制全文</button></view>
    <text wx:if="{{aiPanelError}}" class="ai-panel-error">{{aiPanelError}}</text>
    <text wx:if="{{aiPanelNotice}}" class="project-meta">{{aiPanelNotice}}</text>
    <textarea class="ai-panel-result" value="{{aiPanelText}}" bindinput="setNoteAIText" maxlength="8000" auto-height placeholder="生成结果会在这里出现，可先手工修改再插入。" />
  </view>
</view>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
