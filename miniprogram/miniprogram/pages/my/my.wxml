<block wx:if="{{__profileAccessMounted}}">
<!--pages/my/my.wxml-->
<view class="page">
  <!-- 统一导航栏（Tab页不显示返回按钮） -->
  <navigation-bar back="{{false}}" background="#fbfaf7" />

  <view class="page-content">
    <view class="page-title">我的</view>
    <view class="profile-section">
      <view class="user-profile" bindtap="onProfileTap">
        <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" catchtap="stopAvatarTap">
          <image class="avatar" src="{{userProfile.avatar || defaultAvatarImage}}" mode="aspectFill" />
        </button>
        <view class="user-info">
          <text class="nickname">{{userProfile.nickname || (userInfo ? userInfo.username : (hasLoginToken ? '加载中...' : '未登录'))}}</text>
          <view class="identity-line" wx:if="{{userProfile.identityType || certIdentityType || hasLoginToken}}">
            <view class="vip-tag vip-tag-light">
              <text>{{userProfile.identityType || certIdentityType || '普通用户'}}{{certStatus === 'approved' ? ' · 已认证' : ''}}</text>
            </view>
            <text class="organization-name" wx:if="{{hasLoginToken}}">{{brandOrganization}}</text>
          </view>
          <view class="login-hint" wx:if="{{!hasLoginToken}}">点击登录后查看完整信息</view>
        </view>
        <view class="profile-edit"><text>{{hasLoginToken ? '编辑资料' : '登录'}}</text><text class="profile-edit-arrow">›</text></view>
      </view>
    </view>

    <view class="content">
      <view class="menu-section-title">我的账户</view>
      <view class="account-card">
        <view class="account-summary">
          <view class="account-stat">
            <text class="account-value {{vipLevelIsFallback ? 'account-value-small' : ''}}">{{vipLevelText}}</text>
            <text class="account-label">会员等级</text>
          </view>
          <view class="account-divider"></view>
          <view class="account-stat" bindtap="goToWallet">
            <text class="account-value">{{stonesDisplay || 0}}</text>
            <text class="account-label">灵石余额</text>
          </view>
          <view class="account-divider"></view>
          <view class="account-recharge" bindtap="goToTopupCenter">充值中心 <text>›</text></view>
        </view>
        <view class="account-order" bindtap="onProjectMenuTap" data-action="orders">
          <view class="account-order-main"><mini-icon class="account-order-icon" name="order-list" size="22px" /><text class="account-order-title">我的订单</text><text class="account-order-meta">交易与服务记录</text></view>
          <text class="menu-list-arrow">›</text>
        </view>
      </view>

      <view class="login-prompt" wx:if="{{!hasLoginToken}}">
        <text class="prompt-text">请先登录后查看会员与账户信息</text>
      </view>

      <block wx:if="{{showWorkbenchSection}}">
      <view class="menu-section-title workbench-heading"><text>{{workbenchSectionTitle}}</text><button wx:if="{{hasContentWorkbenchAccess}}" class="workbench-more" bindtap="onWorkbenchMore">更多</button></view>
      <view class="workbench-card">
        <view class="workbench-grid workbench-grid-{{workbenchMenuItems.length}}">
          <view wx:for="{{workbenchMenuItems}}" wx:key="action" class="workbench-item {{item.available === false ? 'workbench-item-disabled' : ''}}" bindtap="onWorkbenchMenuTap" data-action="{{item.action}}">
            <mini-icon class="workbench-icon" name="{{item.icon}}" size="25px" />
            <text class="workbench-label">{{item.label}}</text>
          </view>
        </view>
      </view>
      </block>

      <view id="shareMaterialsPanel" wx:if="{{showShareMaterialsPanel && hasContentWorkbenchAccess && shareMaterialsState !== 'hidden'}}" class="share-materials-section">
        <view class="menu-section-title">可分享素材</view>
        <view class="menu-card share-materials-card">
          <view class="share-materials-head"><text class="share-materials-caption">仅展示已授权的已发布版本，打开后可原生分享。</text><text class="share-materials-close" bindtap="hideShareMaterialsPanel">收起</text></view>
          <view wx:if="{{shareMaterialsState === 'loading' && !shareMaterials.length}}" class="share-materials-state" role="status">正在加载素材…</view>
          <view wx:elif="{{shareMaterialsState === 'error'}}" class="share-materials-state">素材暂时加载失败，请重试。</view>
          <view wx:elif="{{shareMaterialsState === 'empty'}}" class="share-materials-state">暂无已发布的可分享素材。</view>
          <button wx:for="{{shareMaterials}}" wx:key="content_id" class="share-material-item" data-id="{{item.content_id}}" bindtap="openShareMaterial" disabled="{{!!shareMaterialOpening || shareMaterialsLoading}}" aria-label="{{'打开已发布素材：' + item.title}}">
            <image wx:if="{{item.coverURL}}" class="share-material-cover" src="{{item.coverURL}}" mode="aspectFit" />
            <view wx:else class="share-material-cover share-material-placeholder">文章</view>
            <view class="share-material-copy"><text class="share-material-title">{{item.title}}</text><text class="share-material-status">已发布 · 版本 {{item.content_version}}</text><text class="share-material-open">{{shareMaterialOpening === item.content_id ? '正在打开…' : '打开并分享 ›'}}</text></view>
          </button>
          <button class="share-material-refresh" bindtap="refreshShareMaterials" loading="{{shareMaterialsLoading}}" disabled="{{shareMaterialsLoading || !!shareMaterialOpening}}">{{shareMaterialsState === 'error' ? '重试加载' : '刷新素材'}}</button>
          <button wx:if="{{shareMaterialsCursor}}" class="share-material-refresh" bindtap="refreshShareMaterials" data-more="{{true}}" disabled="{{shareMaterialsLoading || !!shareMaterialOpening}}">加载更多</button>
        </view>
      </view>

      <view class="menu-section-title">我的资料</view>
      <view class="section-grid section-grid-two">
        <view wx:for="{{commonMenuItems}}" wx:key="action" class="section-grid-item" bindtap="onProjectMenuTap" data-action="{{item.action}}">
          <mini-icon class="section-grid-icon" name="{{item.icon}}" size="22px" />
          <view class="section-grid-copy"><text class="section-grid-label">{{item.label}}</text><text class="section-grid-meta">{{item.meta}}</text></view>
          <text class="menu-list-arrow">›</text>
        </view>
      </view>

      <view class="menu-section-title">账号与服务</view>
      <view class="section-grid section-grid-service">
        <view wx:for="{{serviceMenuItems}}" wx:key="action" class="section-grid-item" bindtap="onAccountMenuTap" data-action="{{item.action}}">
          <mini-icon class="section-grid-icon" name="{{item.icon}}" size="22px" />
          <view class="section-grid-copy"><text class="section-grid-label">{{item.label}}</text><text class="section-grid-meta">{{item.meta}}</text></view>
          <text class="menu-list-arrow">›</text>
        </view>
      </view>
      <view class="admin-entry" bindtap="onAccountMenuTap" data-action="adminLogin">
        <view><mini-icon class="section-grid-icon" name="user" size="22px" /><text class="admin-entry-title">管理员登录</text></view>
        <view><text class="admin-entry-meta">进入管理后台</text><text class="menu-list-arrow">›</text></view>
      </view>

      <view class="logout-btn" wx:if="{{hasLoginToken}}" bindtap="onLogoutTap">
        <mini-icon class="logout-icon" name="logout" size="20px" /><text>退出登录</text>
      </view>
    </view>
  </view>

  <!-- 存量用户昵称补检弹窗 -->
  <nickname-guard id="nicknameGuard" bind:completed="onNicknameGuardCompleted" />
</view>
</block>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
