<!--pages/my/my.wxml-->
<view class="page">
  <!-- 隐藏的canvas用于生成设备指纹 -->
  <canvas 
    id="device-fingerprint-canvas" 
    type="2d" 
    style="position: fixed; left: -9999px; width: 100px; height: 100px;"
  ></canvas>
  <image class="page-background" src="{{pageBgImage}}" mode="widthFix" lazy-load />

  <!-- 统一导航栏（Tab页不显示返回按钮） -->
  <navigation-bar back="{{false}}" background="#e6daca" />

  <!-- 用户资料区域 -->
  <view class="page-content">
    <view class="profile-section">
      <view class="user-profile" bindtap="onProfileTap">
        <image class="avatar" src="{{userProfile.avatar || defaultAvatarImage}}" mode="aspectFill" />
        <view class="user-info">
          <text class="nickname">{{userProfile.nickname || (userInfo ? userInfo.username : (hasLoginToken ? '加载中...' : '未登录'))}}</text>
          <view class="vip-tags">
            <view class="vip-tag vip-tag-dark">
              <text>会员等级</text>
            </view>
            <view class="vip-tag vip-tag-light">
              <text>{{vipLevelText}}</text>
            </view>
          </view>
          <view class="cert-info" wx:if="{{userProfile.identityType}}">
            <text class="cert-badge">身份</text>
            <text class="cert-text">{{userProfile.identityType}}</text>
          </view>
          <view class="cert-info" wx:elif="{{certStatus === 'approved'}}">
            <text class="cert-badge">已认证</text>
            <text class="cert-text">{{certRealName || certRealNameMasked}}{{certIdentityType ? ' · ' + certIdentityType : ''}}</text>
          </view>
          <view class="login-hint" wx:if="{{!hasLoginToken}}">点击登录后查看完整信息</view>
        </view>
      </view>
    </view>

    <view class="content">
      <!-- 数据展示区域 -->
      <view class="stats-card">
        <view class="stats-item">
          <text class="stats-value {{vipLevelIsFallback ? 'stats-value-muted' : ''}}">{{vipLevelShortDisplay}}</text>
          <text class="stats-label">会员等级</text>
        </view>
        <view class="stats-divider"></view>
        <view class="stats-item" bindtap="goToGenerateHistory">
          <text class="stats-value">{{taskCount || 0}}</text>
          <text class="stats-label">生成记录</text>
        </view>
        <view class="stats-divider"></view>
        <view class="stats-item" bindtap="goToWallet">
          <text class="stats-value">{{stonesDisplay || 0}}</text>
          <text class="stats-label">灵石余额</text>
        </view>
      </view>

      <!-- 未登录提示 -->
      <view class="login-prompt" wx:if="{{!hasLoginToken}}">
        <text class="prompt-text">请先登录后查看会员与账户信息</text>
      </view>

      <view class="menu-section-title">常用功能</view>
      <view class="menu-card menu-list-card project-card">
        <view
          wx:for="{{commonMenuItems}}"
          wx:key="action"
          wx:if="{{true}}"
          class="menu-list-item {{index === commonMenuItems.length - 1 ? 'menu-list-item-last' : ''}}"
          bindtap="onProjectMenuTap"
          data-action="{{item.action}}"
        >
          <view class="menu-list-main">
            <view class="menu-list-icon">
              <text>{{item.shortLabel}}</text>
            </view>
            <text class="menu-list-label">{{item.label}}</text>
          </view>
          <view class="menu-list-tail">
            <text class="menu-list-meta" wx:if="{{item.meta}}">{{item.meta}}</text>
            <text class="menu-list-arrow">›</text>
          </view>
        </view>
      </view>

      <view class="menu-section-title">设计师工作台</view>
      <view class="menu-card menu-list-card workbench-card">
        <view
          wx:for="{{workbenchMenuItems}}"
          wx:key="action"
          class="menu-list-item {{index === workbenchMenuItems.length - 1 ? 'menu-list-item-last' : ''}}"
          bindtap="onWorkbenchMenuTap"
          data-action="{{item.action}}"
        >
          <view class="menu-list-main">
            <view class="menu-list-icon menu-list-icon-secondary">
              <text>{{item.shortLabel}}</text>
            </view>
            <text class="menu-list-label">{{item.label}}</text>
          </view>
          <view class="menu-list-tail">
            <text class="menu-list-meta" wx:if="{{item.meta}}">{{item.meta}}</text>
            <text class="menu-list-arrow">›</text>
          </view>
        </view>
      </view>

      <view wx:if="{{hasLoginToken && shareMaterialsState !== 'hidden'}}" class="share-materials-section">
        <view class="menu-section-title">可分享素材</view>
        <view class="menu-card share-materials-card">
          <text class="share-materials-caption">仅展示已授权的已发布版本，打开后可原生分享。</text>
          <view wx:if="{{shareMaterialsState === 'loading' && !shareMaterials.length}}" class="share-materials-state" role="status">正在加载素材…</view>
          <view wx:elif="{{shareMaterialsState === 'error'}}" class="share-materials-state">素材暂时加载失败，请重试。</view>
          <view wx:elif="{{shareMaterialsState === 'empty'}}" class="share-materials-state">暂无已发布的可分享素材。</view>
          <button wx:for="{{shareMaterials}}" wx:key="content_id" class="share-material-item" data-id="{{item.content_id}}" bindtap="openShareMaterial" disabled="{{!!shareMaterialOpening || shareMaterialsLoading}}" aria-label="{{'打开已发布素材：' + item.title}}">
            <image wx:if="{{item.coverURL}}" class="share-material-cover" src="{{item.coverURL}}" mode="aspectFit" />
            <view wx:else class="share-material-cover share-material-placeholder">文章</view>
            <view class="share-material-copy"><text class="share-material-title">{{item.title}}</text><text class="share-material-status">已发布 · 版本 {{item.content_version}}</text><text class="share-material-open">{{shareMaterialOpening === item.content_id ? '正在打开…' : '打开并分享 ›'}}</text></view>
          </button>
          <button class="share-material-refresh" bindtap="refreshShareMaterials" loading="{{shareMaterialsLoading}}" disabled="{{shareMaterialsLoading || !!shareMaterialOpening}}">{{shareMaterialsState === 'error' ? '重试加载' : '刷新素材'}}</button>
          <button wx:if="{{shareMaterialsCursor}}" class="share-material-refresh" bindtap="refreshShareMaterials" data-more="{{true}}" disabled="{{shareMaterialsLoading || !!shareMaterialOpening}}">加载更多</button>
        </view>
      </view>

      <view class="menu-section-title">账户与工具</view>
      <view class="menu-card menu-list-card service-card">
        <view
          wx:for="{{serviceMenuItems}}"
          wx:key="action"
          class="menu-list-item {{index === serviceMenuItems.length - 1 ? 'menu-list-item-last' : ''}}"
          bindtap="onAccountMenuTap"
          data-action="{{item.action}}"
        >
          <view class="menu-list-main">
            <view class="menu-list-icon menu-list-icon-secondary">
              <text>{{item.shortLabel}}</text>
            </view>
            <text class="menu-list-label">{{item.label}}</text>
          </view>
          <view class="menu-list-tail">
            <text class="menu-list-meta" wx:if="{{item.meta}}">{{item.meta}}</text>
            <text class="menu-list-arrow">›</text>
          </view>
        </view>
      </view>

      <view class="logout-btn" wx:if="{{hasLoginToken}}" bindtap="onLogoutTap">退出登录</view>
    </view>
  </view>

  <!-- 存量用户昵称补检弹窗 -->
  <nickname-guard id="nicknameGuard" bind:completed="onNicknameGuardCompleted" />
</view>
