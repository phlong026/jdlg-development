.private-page{min-height:100vh;background:#f7f3ee;color:#29221d}.page-body{padding:96rpx 28rpx 48rpx}.intro{display:grid;gap:8rpx;margin-bottom:24rpx}.title{font-size:40rpx;font-weight:650}.hint,.meta{font-size:26rpx;color:#776d64;line-height:1.6}.state{margin:28rpx 0;padding:36rpx;border-radius:24rpx;background:#fff;text-align:center;display:grid;gap:20rpx}.primary{margin:0 0 24rpx;background:#8b5e3c;color:#fff}.card{width:100%;margin:16rpx 0;padding:26rpx;border:1rpx solid #eadfd4;border-radius:24rpx;background:#fff;display:flex;text-align:left;align-items:center;justify-content:space-between}.card-main{display:grid;gap:10rpx}.card-title{font-size:32rpx;font-weight:600}.arrow{font-size:44rpx;color:#8b5e3c}button{min-height:88rpx;border-radius:18rpx;font-size:28rpx}button::after{border:0}
.import-panel{margin:30rpx 0;padding:28rpx;border-radius:24rpx;background:#fff;display:grid;gap:20rpx}.section-heading,.field,.card-main{display:grid;gap:10rpx}.section-title{font-size:34rpx;font-weight:650}.capabilities{display:flex;flex-wrap:wrap;gap:10rpx}.capability{padding:8rpx 14rpx;border-radius:999rpx;background:#f2eeea;color:#8b8178;font-size:22rpx}.capability.available{background:#edf5ed;color:#436943}.import-gate,.import-error,.attention{padding:18rpx;border-radius:14rpx;font-size:25rpx;line-height:1.55}.import-gate{background:#f4f1ed;color:#776d64}.import-error,.attention{background:#fff0ec;color:#9a4b36}.field input,.picker-value{min-height:76rpx;padding:0 20rpx;border:1rpx solid #ded4ca;border-radius:14rpx;background:#fff;display:flex;align-items:center;font-size:27rpx}.rights{display:flex;gap:28rpx}.import-submit{background:#8b5e3c;color:#fff}.import-card{padding:22rpx;border:1rpx solid #eadfd4;border-radius:18rpx;display:flex;align-items:center;justify-content:space-between;gap:18rpx}.retry-button{min-width:116rpx;min-height:64rpx;margin:0;padding:0 18rpx;background:#f4ece5;color:#75482d;font-size:24rpx}
