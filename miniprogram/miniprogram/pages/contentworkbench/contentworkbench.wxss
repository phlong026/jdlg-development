page {
  background: #fbfaf7;
  color: #302316;
}

/* 统一按钮垂直居中基线：部分按钮类只设了 min-height/padding，
   依赖原生默认 line-height 会造成文字不居中。 */
button {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

.studio-page {
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.studio-body {
  padding: 24rpx 32rpx 180rpx;
}

button {
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  border-radius: 12rpx;
  line-height: 1.4;
  background: transparent;
  color: inherit;
}

button::after {
  border: 0;
}

.gold-button {
  min-height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #a87943;
  color: #fff;
  font-size: 30rpx;
  border: 1rpx solid #a87943;
  border-radius: 12rpx;
}

.gold-button[disabled] {
  opacity: 0.5;
  background: #bca486;
  color: #fff;
}

.outline-button {
  border: 1rpx solid #b58a57;
  color: #95632f;
  min-height: 80rpx;
  padding: 18rpx 48rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-box {
  min-width: 0;
  flex: 1;
  height: 82rpx;
  background: #f0efed;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  gap: 12rpx;
}

.search-box input {
  min-width: 0;
  flex: 1;
  font-size: 26rpx;
}

.search-symbol {
  font-size: 42rpx;
  color: #5a5148;
  line-height: 1;
}

.clear-search {
  width: 36rpx;
  color: #888;
  font-size: 32rpx;
}

.workspace-links {
  display: flex;
  gap: 28rpx;
  margin: 4rpx 0 20rpx;
}

.workspace-link {
  min-width: 0;
  min-height: 72rpx;
  gap: 10rpx;
  color: #73604e;
  font-size: 25rpx;
  white-space: nowrap;
}

.category-tabs {
  display: flex;
  justify-content: space-between;
  border-bottom: 1rpx solid #e6e1d9;
}

.category-tab {
  position: relative;
  min-height: 78rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #90877d;
  border-radius: 0;
}

.category-tab.active {
  color: #432b18;
  font-weight: 400;
}

.category-tab.active::after {
  display: block;
  position: absolute;
  bottom: 0;
  left: 12rpx;
  right: 12rpx;
  border-bottom: 5rpx solid #a87943;
  border-radius: 0;
}

.content-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eae5df;
}

.content-cover {
  width: 204rpx;
  height: 152rpx;
  position: relative;
  flex-shrink: 0;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f1ece4;
}

.content-cover image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #a48a6d;
  font-size: 22rpx;
}

.play-mark {
  position: absolute;
  top: 48rpx;
  left: 74rpx;
  color: #fff;
  font-size: 24rpx;
  line-height: 52rpx;
  text-align: center;
  height: 52rpx;
  width: 52rpx;
  border: 2rpx solid #fff;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.3333333333);
}

.content-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.content-title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 1.5;
}

.content-meta, .content-action {
  display: block;
  color: #968d83;
  font-size: 24rpx;
}

.content-action {
  color: #91622f;
  font-size: 23rpx;
}

.row-chevron {
  color: #a38e77;
  font-size: 36rpx;
}

.empty-state, .state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 70rpx 28rpx;
  text-align: center;
}

.state-card {
  min-height: 400rpx;
  justify-content: center;
}

.state-title {
  display: block;
  color: #51402e;
  font-size: 30rpx;
  font-weight: 400;
}

.muted {
  color: #a09589;
  font-size: 24rpx;
  line-height: 1.6;
}

.state-card button {
  margin-top: 16rpx;
  min-width: 240rpx;
}

.loading-mark {
  width: 42rpx;
  height: 42rpx;
  border: 4rpx solid #ebe2d5;
  border-top-color: #a87943;
  border-radius: 50%;
}

.pagination-note {
  display: block;
  text-align: center;
  color: #a09589;
  font-size: 22rpx;
  margin: 20rpx 0;
}

.load-more {
  color: #95632f;
  padding: 24rpx;
}

.filter-note {
  display: flex;
  justify-content: space-between;
  color: #8b7d6c;
  padding: 18rpx 0 0;
  font-size: 24rpx;
}

.text-button {
  font-size: 23rpx;
  color: #9b8976;
  line-height: 1.6;
}

.studio-footer .gold-button {
  width: 100%;
}

.studio-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #ebe5dc;
  background: #fbfaf7;
  z-index: 10;
}

.import-heading {
  display: block;
  font-size: 28rpx;
  font-weight: 400;
  margin: 12rpx 0 26rpx;
}

.link-input-box {
  position: relative;
  padding: 24rpx;
  border: 2rpx solid #d5cbbd;
  border-radius: 14rpx;
  background: #fff;
}

.link-input-box textarea {
  box-sizing: border-box;
  width: 100%;
  height: 200rpx;
  padding-bottom: 45rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.paste-button {
  position: absolute;
  bottom: 20rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #8d8174;
  font-size: 24rpx;
  padding: 8rpx;
}

.available-platforms {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0 8rpx;
}

.available-platforms text {
  border: 1rpx solid #e4ddd3;
  border-radius: 8rpx;
  padding: 8rpx 14rpx;
  color: #837361;
  font-size: 21rpx;
}

.import-options {
  background: #fff;
  padding: 0 0 12rpx;
  border-radius: 12rpx;
}

.form-row {
  min-height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-bottom: 1rpx solid #eee8df;
  padding: 8rpx 20rpx;
  font-size: 26rpx;
}

.form-row picker {
  min-width: 0;
  max-width: 64%;
  color: #8b7254;
  overflow: hidden;
}

.rights-row radio-group {
  display: flex;
  gap: 16rpx;
}

.rights-row label {
  display: flex;
  align-items: center;
  white-space: nowrap;
  font-size: 24rpx;
}

.rights-row radio {
  transform: scale(0.7);
  margin-left: -8rpx;
}

.import-submit {
  margin-top: 24rpx;
  width: 100%;
}

.import-gate, .inline-error {
  border-radius: 10rpx;
  background: #fbf0e5;
  color: #9a6835;
  padding: 22rpx;
  font-size: 24rpx;
  line-height: 1.7;
  margin: 20rpx 0;
}

.recent-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #e9e1d6;
  padding-top: 28rpx;
  font-size: 29rpx;
  font-weight: 400;
}

.import-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eee6dc;
}

.import-job-icon {
  flex-shrink: 0;
  color: #a9875d;
}

.import-job-icon.ready {
  color: #51a06c;
}

.import-job-icon.failed, .import-job-icon.blocked {
  color: #b86b50;
}

.import-job-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.job-state {
  font-size: 23rpx;
  color: #9e8b73;
}

.job-state.ready {
  color: #589671;
}

.job-error {
  color: #b17753;
  font-size: 23rpx;
  line-height: 1.6;
}

.retry-button {
  color: #a06c36;
  border: 1rpx solid #d7c4a9;
  padding: 12rpx 18rpx;
  font-size: 23rpx;
  flex-shrink: 0;
}

.compact {
  padding: 40rpx 20rpx;
}

.content-row-actions { display: flex; align-items: center; justify-content: space-between; }
.edit-link { padding: 12rpx 16rpx; color: #8d6238; font-size: 24rpx; }

.workspace-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.workspace-title {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #302316;
}

.workspace-destinations {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.workspace-destinations button.workspace-destination {
  width: auto;
  margin: 0;
  padding: 0;
  min-height: 76rpx;
  gap: 8rpx;
  font-size: 25rpx;
  color: #73604e;
  white-space: nowrap;
}

.destination-arrow {
  color: #a38e77;
  font-size: 30rpx;
}

.onboarding-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 26rpx;
  text-align: left;
}

.onboarding-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #eee8e1;
  border-radius: 16rpx;
  background: #fff;
}

.onboarding-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b211b;
}

.quota-strip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  justify-content: flex-end;
  margin: 22rpx 0 0;
  color: #817568;
  font-size: 23rpx;
}

.quota-divider {
  color: #c9b597;
}

.owner-tabs {
  display: flex;
  gap: 12rpx;
  margin: 0 4rpx 14rpx;
  overflow-x: auto;
}

.owner-tab {
  flex: 0 0 auto;
  min-height: 60rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid #eee8e1;
  border-radius: 999rpx;
  background: #fff;
  color: #65584e;
  font-size: 24rpx;
}

.owner-tab.active {
  border-color: #a87943;
  background: #f1e4d2;
  color: #8b5c2d;
}

.active-projects { display: flex; flex-direction: column; gap: 12rpx; margin: 0 0 16rpx; }
.proj-card { display: flex; flex-direction: column; gap: 6rpx; background: #fff; border: 1rpx solid #eee8e1; border-radius: 12rpx; padding: 18rpx 20rpx; }
.proj-head { display: flex; align-items: center; justify-content: space-between; }
.proj-name { font-size: 28rpx; font-weight: 600; color: #302316; }
.proj-stage { font-size: 21rpx; color: #91622f; background: #f8f0e2; border-radius: 6rpx; padding: 2rpx 10rpx; }
.proj-meta { font-size: 23rpx; color: #968d83; }
