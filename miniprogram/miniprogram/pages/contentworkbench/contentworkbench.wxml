<block wx:if="{{__profileAccessMounted}}">
<view class="studio-page">
  <navigation-bar title="{{view === 'import' ? '导入分享链接' : '内容创作'}}" back="{{true}}" background="#fbfaf7" />
  <view class="studio-body">
    <view wx:if="{{loginRequired}}" class="state-card"><text class="state-title">登录后开始创作</text><button class="gold-button" bindtap="goLogin">去登录</button></view>
    <view wx:elif="{{denied}}" class="state-card"><text class="state-title">暂未获得内容管理权限</text><text class="muted">请联系管理员开通</text><button class="outline-button" bindtap="retry">重新检查</button></view>
    <view wx:elif="{{disabled}}" class="state-card"><text class="state-title">内容创作暂未开通</text><button class="outline-button" bindtap="retry">重新检查</button></view>
    <view wx:elif="{{loading && !context}}" class="state-card" role="status"><view class="loading-mark"></view><text>正在加载…</text></view>
    <view wx:elif="{{error && !items.length}}" class="state-card"><text class="state-title">内容加载失败</text><text class="muted">{{error}}</text><button class="outline-button" bindtap="retry">重试</button></view>
    <block wx:else>
      <block wx:if="{{view === 'studio'}}">
        <view class="workspace-tabs" role="tablist"><text class="workspace-tab active" role="tab" aria-selected="{{true}}">作品</text><button class="workspace-tab" bindtap="openCollections">合集</button><button class="workspace-tab" bindtap="openExistingAssets">素材</button></view>
        <view wx:if="{{context.owner_choices.length > 1}}" class="owner-tabs" role="tablist">
          <button class="owner-tab {{ownerFilter === '' ? 'active' : ''}}" data-owner="" bindtap="selectOwnerTab" role="tab" aria-selected="{{ownerFilter === ''}}">全部</button>
          <button wx:for="{{context.owner_choices}}" wx:key="owner_id" class="owner-tab {{ownerFilter === item.owner_id ? 'active' : ''}}" data-owner="{{item.owner_id}}" bindtap="selectOwnerTab" role="tab" aria-selected="{{ownerFilter === item.owner_id}}">{{item.display_name}}</button>
        </view>
        <view class="search-row"><view class="search-box"><text class="search-symbol">⌕</text><input value="{{keyword}}" bindinput="setKeyword" bindconfirm="searchContents" confirm-type="search" maxlength="30" placeholder="搜索内容" aria-label="搜索内容标题" /><button wx:if="{{keyword}}" class="clear-search" bindtap="clearSearch" aria-label="清空搜索">×</button></view></view>
        <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="category-scroll"><view class="category-tabs" role="tablist"><button wx:for="{{categories}}" wx:key="key" class="category-tab {{category === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectCategory" role="tab" aria-selected="{{category === item.key}}">{{item.label}}</button></view></scroll-view>
        <view wx:if="{{searchTerm}}" class="filter-note">“{{searchTerm}}”<button class="text-button" bindtap="clearSearch">清空</button></view>
        <view class="content-list">
          <view wx:if="{{loading}}" class="state-card content-list-loading" role="status"><view class="loading-mark"></view><text>正在加载内容…</text></view>
          <block wx:elif="{{visibleItems.length > 0}}">
            <view wx:for="{{visibleItems}}" wx:key="content_id" class="content-row {{item.kind}}" data-id="{{item.content_id}}" data-status="{{item.status}}" data-version="{{item.version}}" data-read-only="{{item.read_only}}" data-route="{{item.route_key}}" bindtap="openContent" bindlongpress="deleteContentMenu" role="button" aria-label="{{item.title}}">
              <view class="content-cover {{item.kind}}"><image wx:if="{{item.cover_path}}" src="{{item.cover_path}}" mode="aspectFill" /><view wx:else class="cover-placeholder"><t-icon name="{{item.kind === 'video' ? 'video' : 'file'}}" size="30px" color="#b49a7e" /><text>{{item.kind_label}}</text></view><view wx:if="{{item.kind === 'video'}}" class="play-mark">▶</view></view>
              <view class="content-info"><view class="content-labels"><text class="kind-chip">{{item.kind_label}}</text><text wx:if="{{item.source_label}}" class="source-chip">{{item.source_label}}</text></view><text class="content-title">{{item.title || '未命名内容'}}</text><text class="content-meta">{{item.status_label}}{{item.date_label ? ' · ' + item.date_label : ''}}</text><text wx:if="{{item.status === 'published'}}" class="content-metrics">查看 {{item.view_count || 0}} · 转发 {{item.share_count || 0}}</text><view class="content-row-actions"><text class="content-action">{{item.action_label}}</text><button wx:if="{{!item.read_only}}" class="edit-link" catchtap="openContentMore" data-id="{{item.content_id}}">更多</button></view></view><text class="row-chevron">›</text>
            </view>
          </block>
          <view wx:else class="empty-state">
            <block wx:if="{{category === 'all' && !searchTerm && !next_cursor}}">
              <t-icon name="file" size="42px" color="#c9b597" /><text class="state-title">暂无内容</text>

            </block>
            <block wx:else><t-icon name="file" size="42px" color="#c9b597" /><text class="state-title">{{searchTerm ? '未找到相关内容' : '暂无这类内容'}}</text></block>
          </view>
        </view>
        <view wx:if="{{context.stones_balance >= 0}}" class="quota-strip"><text>灵石 {{context.stones_balance}}</text><text wx:if="{{context.month_generations >= 0}}" class="quota-divider">·</text><text wx:if="{{context.month_generations >= 0}}">本月生成 {{context.month_generations}}</text></view>
        <view wx:if="{{error}}" class="inline-error">{{error}}</view>
        <button wx:if="{{next_cursor}}" class="load-more" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
      </block>
      <block wx:else>
        <view wx:if="{{importCapabilityLoading}}" class="import-gate import-gate-loading" role="status"><view class="loading-mark"></view><text>正在确认导入能力…</text></view>
        <view wx:elif="{{!importEnabled}}" class="import-gate"><text>{{importCapabilityReason || '链接导入暂未开通'}}</text><button class="outline-button" bindtap="backToContent">返回内容创作</button></view>
        <view wx:else class="import-editor">
          <text class="import-heading">粘贴分享链接</text>
          <view class="link-input-box"><textarea value="{{importURL}}" bindinput="setImportURL" maxlength="4000" placeholder="粘贴完整链接或分享文字" auto-height="{{false}}" aria-label="分享链接" /><button class="paste-button" bindtap="pasteImportLink"><t-icon name="file-copy" size="17px" /> 粘贴</button></view>
          <view class="available-platforms"><block wx:for="{{importPlatforms}}" wx:key="platform"><text wx:if="{{item.available}}">{{item.label}}</text></block></view>
          <view class="import-options"><view wx:if="{{context.owner_choices.length > 1}}" class="form-row"><text>内容归属</text><picker mode="selector" range="{{context.owner_choices}}" range-key="display_name" value="{{importOwnerIndex}}" bindchange="setImportOwner"><view>{{context.owner_choices[importOwnerIndex].display_name || '请选择'}} <text class="row-chevron">›</text></view></picker></view><view class="form-row rights-row"><text>版权来源</text><radio-group bindchange="setImportRights"><label><radio value="own" color="#a87943" checked="{{importRights === 'own'}}" />自有素材</label><label><radio value="authorized" color="#a87943" checked="{{importRights === 'authorized'}}" />已获授权</label></radio-group></view><button class="gold-button import-submit" bindtap="submitImport" loading="{{importBusy}}" disabled="{{importBusy}}">{{importBusy ? '正在提交…' : '解析并导入'}}</button></view>
        </view>
        <view wx:if="{{importError}}" class="inline-error">{{importError}}</view>
        <view wx:if="{{importServiceEnabled}}" class="recent-imports">
          <view class="recent-heading"><text>最近导入</text><button class="text-button" bindtap="refreshImportList" disabled="{{importPolling}}">{{importPolling ? '刷新中' : '刷新'}} ↻</button></view>
          <view wx:if="{{!imports.length}}" class="empty-state compact"><text class="muted">暂无导入记录</text></view>
          <view wx:for="{{imports}}" wx:key="import_id" class="import-row" bindtap="openImport" data-id="{{item.import_id}}"><view class="import-job-icon {{item.status}}"><t-icon name="{{item.status === 'ready' ? 'check-circle' : item.status === 'failed' || item.status === 'blocked' ? 'error-circle' : 'time'}}" size="26px" /></view><view class="import-job-body"><text class="content-title">{{item.platform_text}}</text><text class="job-state {{item.status}}">{{item.status_text}}</text><text wx:if="{{item.status === 'uncertain' || item.error_text}}" class="job-error">{{item.status === 'uncertain' ? '本次结果需要人工核对，请勿重复提交' : item.error_text}}</text></view><view wx:if="{{item.status === 'failed' || item.status === 'blocked'}}" class="import-row-actions"><button class="manual-button" catchtap="manualImport" data-id="{{item.import_id}}">手动补传</button><button wx:if="{{item.error_code === 'media_source_expired' && !item.can_retry}}" class="retry-button" catchtap="prepareReimport" data-id="{{item.import_id}}">重新发起</button><button wx:elif="{{item.can_retry}}" class="retry-button" catchtap="retryImport" data-id="{{item.import_id}}" disabled="{{importBusy}}">重试</button></view><text wx:elif="{{item.status === 'ready'}}" class="row-chevron">›</text></view>
        </view>
      </block>
    </block>
  </view>
  <view wx:if="{{view === 'studio' && !loading && !loginRequired && !denied && !disabled}}" class="studio-footer"><button class="gold-button" bindtap="openCreateMenu">＋ 新建</button></view>
  <view wx:if="{{createMenuOpen}}" class="create-mask" catchtap="closeCreateMenu"><view class="create-sheet" catchtap="noop"><view class="create-sheet-head"><text>新建内容</text><button bindtap="closeCreateMenu" aria-label="关闭新建菜单">×</button></view><view class="create-primary"><button class="create-choice" data-route="/pages/contentedit/contentedit?kind=gallery" bindtap="chooseCreate"><t-icon name="image" size="30px" color="#6f4b27" /><text>图文笔记</text></button><button class="create-choice" data-route="/pages/contentedit/contentedit?kind=video" bindtap="chooseCreate"><t-icon name="video" size="30px" color="#6f4b27" /><text>视频笔记</text></button></view><button class="create-row" data-route="/pages/contentworkbench/contentworkbench?view=import" bindtap="chooseCreate"><text>导入链接</text><text>›</text></button><button class="create-row" bindtap="openMoreCreateMenu" aria-expanded="{{createMoreOpen}}"><text>更多创作</text><text>{{createMoreOpen ? '⌃' : '›'}}</text></button><view wx:if="{{createMoreOpen}}" class="create-more"><button data-route="/pages/contentedit/contentedit?kind=article" bindtap="chooseCreate">写文章</button><button data-route="/pages/contentedit/contentedit?action=document" bindtap="chooseCreate">上传文件</button></view></view></view>
</view>
</block>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
