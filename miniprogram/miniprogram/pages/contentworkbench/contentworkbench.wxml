<view class="studio-page">
  <navigation-bar title="{{view === 'import' ? '导入分享链接' : '内容制作'}}" back="{{true}}" background="#fbfaf7" />
  <view class="studio-body">
    <view wx:if="{{loginRequired}}" class="state-card"><text class="state-title">登录后开始创作</text><text class="muted">整理你的图文、视频和设计资料</text><button class="gold-button" bindtap="goLogin">去登录</button></view>
    <view wx:elif="{{denied}}" class="state-card"><text class="state-title">暂未获得内容管理权限</text><text class="muted">请联系管理员开通后再使用</text><button class="outline-button" bindtap="retry">重新检查</button></view>
    <view wx:elif="{{disabled}}" class="state-card"><text class="state-title">内容制作暂未开通</text><text class="muted">开通后可在手机上创建、导入与分享内容</text><button class="outline-button" bindtap="retry">重新检查</button></view>
    <view wx:elif="{{loading}}" class="state-card" role="status"><view class="loading-mark"></view><text>正在加载你的内容…</text></view>
    <view wx:elif="{{error &amp;&amp; !items.length}}" class="state-card"><text class="state-title">内容加载失败</text><text class="muted">{{error}}</text><button class="outline-button" bindtap="retry">重试</button></view>
    <block wx:else>
      <block wx:if="{{view === 'studio'}}">
        <view class="search-row"><view class="search-box"><text class="search-symbol">⌕</text><input value="{{keyword}}" bindinput="setKeyword" bindconfirm="searchContents" confirm-type="search" maxlength="30" placeholder="搜索资料、笔记或文案" aria-label="搜索内容标题" /><button wx:if="{{keyword}}" class="clear-search" bindtap="clearSearch" aria-label="清空搜索">×</button></view><button class="gold-button new-small" bindtap="createContent">＋ 新建</button></view>
        <view class="creation-tools">
          <button class="creation-tool" bindtap="openNotes"><t-icon name="file-copy" size="28px" color="#91622f" /><text>项目笔记</text></button>
          <button class="creation-tool" bindtap="openImportView"><t-icon name="link" size="28px" color="#91622f" /><text>链接导入</text></button>
          <button class="creation-tool" bindtap="createContent"><t-icon name="cloud-upload" size="28px" color="#91622f" /><text>上传资料</text></button>
          <button class="creation-tool" bindtap="openAIWriting"><t-icon name="edit-1" size="28px" color="#91622f" /><text>AI文案</text></button>
        </view>
        <view class="category-tabs" role="tablist"><button wx:for="{{categories}}" wx:key="key" class="category-tab {{category === item.key ? 'active' : ''}} {{item.unavailable ? 'unavailable' : ''}}" aria-disabled="{{item.unavailable}}" data-key="{{item.key}}" bindtap="selectCategory" role="tab" aria-selected="{{category === item.key}}">{{item.label}}</button></view>
        <view wx:if="{{searchTerm}}" class="filter-note">“{{searchTerm}}”的搜索结果<button class="text-button" bindtap="clearSearch">清空</button></view>
        <view class="content-list">
          <view wx:for="{{visibleItems}}" wx:key="content_id" class="content-row" data-id="{{item.content_id}}" bindtap="editContent" role="button" aria-label="{{item.title}}">
            <view class="content-cover"><image wx:if="{{item.cover_path}}" src="{{item.cover_path}}" mode="aspectFill" /><view wx:else class="cover-placeholder"><t-icon name="{{item.kind === 'video' ? 'video' : 'file'}}" size="32px" color="#b49a7e" /><text>{{item.kind_label}}</text></view><view wx:if="{{item.kind === 'video'}}" class="play-mark">▶</view></view>
            <view class="content-info"><text class="content-title">{{item.title || '未命名内容'}}</text><text class="content-meta">{{item.kind_label}} · {{item.status_label}}</text><text class="content-date">{{item.date_label || '打开查看详情'}}{{item.read_only ? ' · 仅查看' : ''}}</text></view><text class="row-chevron">›</text>
          </view>
          <view wx:if="{{!visibleItems.length}}" class="empty-state"><t-icon name="file" size="42px" color="#c9b597" /><text class="state-title">{{searchTerm ? '未找到相关内容' : category === 'all' ? '还没有创作内容' : '暂无这类资料'}}</text><text class="muted">{{category === 'note' ? '项目笔记协作尚未开通，普通图文可先新建保存' : next_cursor ? '当前已加载资料中没有匹配项，可继续加载' : '从一篇图文、一次上传或一条分享链接开始'}}</text></view>
        </view>
        <text wx:if="{{category !== 'all' &amp;&amp; next_cursor}}" class="pagination-note">分类显示已加载内容，可继续加载更多资料</text>
        <view wx:if="{{error}}" class="inline-error">{{error}}</view>
        <button wx:if="{{next_cursor}}" class="load-more" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
        <view class="existing-assets"><text class="divider-line"></text><button class="text-button" bindtap="openExistingAssets">已有生成记录、模板与作品可直接选用 ›</button><text class="divider-line"></text></view>
        <button class="visits-entry" bindtap="openShareVisits"><text>我的分享访问</text><text class="muted">查看本人分享的访问反馈 ›</text></button>
      </block>
      <block wx:else>
        <text class="import-heading">粘贴公众号、视频号或小红书链接</text>
        <view class="link-input-box"><textarea value="{{importURL}}" bindinput="setImportURL" maxlength="4000" placeholder="在这里粘贴完整分享链接或分享文字" auto-height="{{false}}" aria-label="分享链接" /><button class="paste-button" bindtap="pasteImportLink"><t-icon name="file-copy" size="17px" /> 粘贴</button></view>
        <view class="platforms"><view wx:for="{{importPlatforms}}" wx:key="platform" class="platform {{item.available ? 'available' : 'unavailable'}}"><view class="platform-heading"><text class="platform-symbol {{item.platform}}">{{item.platform === 'wechat_article' ? '微' : item.platform === 'xiaohongshu' ? '红' : item.platform === 'channels' ? '视' : '抖'}}</text><text>{{item.label}}</text></view><text class="platform-state">{{item.available ? '可导入' : '暂不可用'}}</text></view></view>
        <view wx:if="{{!importEnabled}}" class="import-gate">{{importCapabilityReason || '链接导入暂未开通，请先使用上传资料'}}</view>
        <view wx:else class="import-options"><view class="form-row"><text>内容归属</text><picker mode="selector" range="{{context.owners}}" value="{{importOwnerIndex}}" bindchange="setImportOwner"><view>{{importOwner || '请选择'}} <text class="row-chevron">›</text></view></picker></view><view class="form-row rights-row"><text>素材权属</text><radio-group bindchange="setImportRights"><label><radio value="own" color="#a87943" checked="{{importRights === 'own'}}" />自有</label><label><radio value="authorized" color="#a87943" checked="{{importRights === 'authorized'}}" />已获授权</label></radio-group></view><button class="gold-button import-submit" bindtap="submitImport" loading="{{importBusy}}" disabled="{{importBusy}}">{{importBusy ? '正在提交…' : '解析并导入内容'}}</button></view>
        <text class="import-caption">导入正文与图片，保留支持的原排版；生成草稿后可预览、编辑和发布</text>
        <view wx:if="{{importError}}" class="inline-error">{{importError}}</view>
        <view class="recent-heading"><text>最近导入</text><button class="text-button" bindtap="refreshImportList" disabled="{{importPolling}}">{{importPolling ? '刷新中' : '刷新记录'}} ↻</button></view>
        <view wx:if="{{!imports.length}}" class="empty-state compact"><text class="muted">暂无导入记录</text></view>
        <view wx:for="{{imports}}" wx:key="import_id" class="import-row" bindtap="openImport" data-id="{{item.import_id}}"><view class="import-job-icon {{item.status}}"><t-icon name="{{item.status === 'ready' ? 'check-circle' : item.status === 'failed' || item.status === 'blocked' ? 'error-circle' : 'time'}}" size="26px" /></view><view class="import-job-body"><text class="content-title">{{item.platform_text}}</text><text class="job-state {{item.status}}">{{item.status_text}}</text><text wx:if="{{item.status === 'uncertain' || item.error_text}}" class="job-error">{{item.status === 'uncertain' ? '本次结果需要人工核对，请勿重复提交' : item.error_text}}</text></view><button wx:if="{{(item.status === 'failed' || item.status === 'blocked') &amp;&amp; item.error_code === 'media_source_expired'}}" class="retry-button" catchtap="prepareReimport" data-id="{{item.import_id}}">重新发起</button><button wx:elif="{{item.can_retry &amp;&amp; item.status !== 'uncertain'}}" class="retry-button" catchtap="retryImport" data-id="{{item.import_id}}" disabled="{{importBusy}}">重试</button><text wx:elif="{{item.status === 'ready'}}" class="row-chevron">›</text></view>
      </block>
    </block>
  </view>
  <view wx:if="{{view === 'studio' &amp;&amp; !loading &amp;&amp; !loginRequired &amp;&amp; !denied &amp;&amp; !disabled}}" class="studio-footer"><button class="gold-button" bindtap="createContent">＋ 新建内容</button></view>
</view>
