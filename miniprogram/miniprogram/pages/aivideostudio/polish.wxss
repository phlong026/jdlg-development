@import "./common.wxss";

.polish-page { min-height:100vh; padding:20rpx 32rpx calc(150rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }
.status-row { display:flex; align-items:center; justify-content:space-between; min-height:68rpx; color:#5d4b3e; font-size:26rpx; }
.fee { color:#9b6a38; }
.error-message,.task-note { margin-top:18rpx; font-size:25rpx; line-height:1.65; }
.error-message { color:#a34c3f; }
.task-note { color:#806959; }
.original-card { margin-top:22rpx; padding:22rpx; border:1rpx solid #e5ddd5; border-radius:14rpx; background:#fffdfb; }
.original-title { display:flex; justify-content:space-between; color:#5c493c; font-size:26rpx; }
.original-title text:last-child { color:#a36d34; }
.original-text { display:block; margin-top:18rpx; color:#796653; font-size:26rpx; line-height:1.7; white-space:pre-wrap; word-break:break-all; }
.result-section { margin-top:28rpx; }
.section-title { display:block; margin-bottom:16rpx; font-size:32rpx; font-weight:600; }
.result-input { width:100%; height:420rpx; box-sizing:border-box; padding:22rpx; border:1rpx solid #d9cec4; border-radius:14rpx; background:#fffdfb; color:#30251c; font-size:28rpx; line-height:1.7; }
.result-input[disabled] { color:#8c7c70; background:#f6f2ed; }
.count { display:block; margin-top:10rpx; color:#9a8b7e; font-size:22rpx; text-align:right; }
.count-error { color:#a34c3f; }
.cancel-button { margin-top:24rpx; color:#a34c3f; background:transparent; font-size:26rpx; }
.cancel-button::after { border-color:#d8b8b0; }
.polish-bottom { position:fixed; z-index:20; left:0; right:0; bottom:0; display:flex; gap:18rpx; padding:16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e8e1d8; background:#fbfaf7; }
.keep-button,.adopt-button { flex:1; height:82rpx; margin:0; border-radius:12rpx; font-size:28rpx; line-height:82rpx; }
.keep-button { color:#814b22; background:#fff8ee; }
.adopt-button { color:#fff; background:#b98245; }
.keep-button::after,.adopt-button::after { border:0; }
.adopt-button[disabled] { color:#a99e94; background:#e9e4de; }
