@import "./common.wxss";
.prompt-form { padding:4rpx 0 30rpx; border-bottom:1rpx solid #e8e1d8; margin-bottom:28rpx; }
.prompt-form .textarea { margin-top:18rpx; height:230rpx; }
.prompt-copy { white-space:pre-wrap; word-break:break-all; }
.delete-button { margin-left:auto; color:#9e6755; }
.prompt-error { display:flex; align-items:center; gap:16rpx; font-size:25rpx; }
