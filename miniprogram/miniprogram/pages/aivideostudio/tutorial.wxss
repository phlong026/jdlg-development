@import "./common.wxss";

.lesson-tabs { display:flex; border-bottom:1rpx solid #e6dfd7; }
.lesson-tab { flex:1; padding:16rpx 4rpx 20rpx; text-align:center; color:#796653; font-size:27rpx; line-height:1.5; }
.lesson-tab-active { color:#30251c; font-weight:600; border-bottom:4rpx solid #b47f43; }
.lesson-summary { display:block; margin-top:22rpx; color:#796653; font-size:26rpx; line-height:1.7; }
.lesson-formula { display:block; color:#9b6a38; font-size:29rpx; line-height:1.8; }
.lesson-tips { margin-top:16rpx; }
.lesson-tips text { display:block; margin-top:8rpx; color:#796653; font-size:25rpx; line-height:1.7; }
.case-image-wrap { position:relative; overflow:hidden; border-radius:14rpx; }
.case-image-wrap::before { content:""; display:block; padding-top:56.25%; }
.case-image { position:absolute; inset:0; width:100%; height:100%; }
.case-image-label { position:absolute; bottom:14rpx; left:14rpx; padding:6rpx 12rpx; border-radius:6rpx; background:rgba(47,32,25,.76); color:#fff; font-size:23rpx; }
.case-note { display:block; margin-top:18rpx; color:#8b7565; font-size:24rpx; line-height:1.7; }
.case-prompt { display:block; margin-top:20rpx; color:#42352b; font-size:27rpx; line-height:1.8; white-space:pre-wrap; word-break:break-all; }
.copy-example { width:100%; margin-top:24rpx; }
.copy-error { display:block; margin-top:16rpx; font-size:25rpx; line-height:1.6; }

@media (max-width:350px) {
  .lesson-tab { font-size:25rpx; }
}
