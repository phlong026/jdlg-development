page { background: #fbfaf7; color: #30251c; }
.page { min-height: 100vh; padding: 20rpx 32rpx calc(80rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.hero { padding: 8rpx 0 20rpx; border-bottom: 1rpx solid #e8e1d8; }
.hero-title { display:block; font-size: 34rpx; font-weight: 700; }
.hero-copy,.muted { display:block; margin-top: 12rpx; color:#806959; font-size: 26rpx; line-height:1.55; }
.section { margin-top: 30rpx; }
.section-title { display:block; margin-bottom:16rpx; font-size:32rpx; font-weight:600; }
.card { background:#fffdfb; border:1rpx solid #e8e1d8; border-radius:14rpx; padding:24rpx; margin-bottom:20rpx; }
.row { display:flex; align-items:center; gap:16rpx; }
.grow { flex:1; min-width:0; }
.title { display:block; font-size:30rpx; font-weight:600; }
.title,.task-title { word-break:break-all; }
.meta { display:block; margin-top:8rpx; color:#8b7565; font-size:24rpx; line-height:1.45; }
.grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; }
.action { min-height:150rpx; display:flex; flex-direction:column; justify-content:center; }
.button,.button-secondary { margin:20rpx 0 0; min-height:80rpx; display:flex; align-items:center; justify-content:center; border-radius:12rpx; font-size:28rpx; line-height:1.4; }
.button { color:#fff; background:#a87943; }
.button[disabled] { color:#9d8f83; background:#eee7df; }
.button-secondary { color:#814b22; background:#fff8ee; border:1rpx solid #d8b48d; }
.state { padding:30rpx; text-align:center; color:#816d5d; }
.error { color:#ad3f31; }
.field { margin-top:22rpx; }
.label { display:block; margin-bottom:10rpx; color:#5b3a28; font-size:26rpx; }
.textarea,.picker { width:100%; box-sizing:border-box; border:1rpx solid #dfd1c4; background:#fff; border-radius:18rpx; padding:20rpx; font-size:28rpx; }
.textarea { min-height:190rpx; }
.chips { display:flex; flex-wrap:wrap; gap:12rpx; }
.chip { padding:12rpx 20rpx; border-radius:999rpx; background:#eee5db; color:#72523d; font-size:25rpx; }
.chip-active { background:#a66529; color:#fff; }
.badge { padding:6rpx 12rpx; border-radius:999rpx; background:#f5e4cf; color:#97571f; font-size:22rpx; }
.media-thumb { width:120rpx; height:90rpx; border-radius:14rpx; background:#eee5db; object-fit:cover; }
.safe-bottom { height:40rpx; }

.first-section { margin-top:6rpx; }
.section-heading { margin-bottom:16rpx; }
.section-heading .section-title { margin-bottom:0; }
.text-link { flex:none; padding:10rpx 0 10rpx 18rpx; color:#a36d34; font-size:25rpx; }
.text-button { flex:none; margin:0; padding:12rpx 0; color:#a36d34; background:transparent; font-size:26rpx; line-height:1.5; }
.text-button::after,.button::after,.button-secondary::after { border:0; }
.button-secondary[disabled] { color:#a99e94; border-color:#e6ded5; background:transparent; }
.danger { color:#a34c3f; }
.section-error { display:flex; align-items:center; justify-content:space-between; gap:16rpx; color:#a34c3f; font-size:25rpx; line-height:1.6; }

.studio-navigation { position:sticky; top:0; z-index:30; display:block; background:#fbfaf7; }

/* Native single-line inputs need an explicit height; vertical padding clips placeholders. */
.input { width:100%; height:88rpx; padding:0 20rpx; box-sizing:border-box; border:1rpx solid #dfd1c4; border-radius:14rpx; background:#fffdfb; font-size:28rpx; line-height:normal; }
