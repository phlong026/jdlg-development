<block wx:if="{{__profileAccessMounted}}">
<navigation-bar title="任务详情" back="{{true}}" background="#fbfaf7" /><view class="page"><view wx:if="{{loading}}" class="state">正在读取任务…</view><view wx:elif="{{error && !batch}}" class="card state error"><text>{{error}}</text><button class="button-secondary" bindtap="load">重试</button></view><block wx:else><view class="hero"><view class="row"><text class="hero-title grow">任务详情</text><text class="badge">{{statusLabel}}</text></view><text class="hero-copy">批次 {{batch.batch_id}}</text></view>
<view class="card section"><text class="title">输入快照</text><text class="meta">{{snapshot.mode_label}} · {{snapshot.resolution}} · {{snapshot.duration}} 秒 · {{snapshot.quantity}} 条</text><text class="meta">{{snapshot.prompt || snapshot.reference_prompt}}</text></view>
<view class="card"><text class="title">费用</text><text class="meta">报价 {{batch.charge.quoted_stones || 0}} 灵石 · 已结算 {{batch.charge.settled_stones || 0}} · 已释放 {{batch.charge.released_stones || 0}}</text></view>
<view class="section"><text class="section-title">生成结果</text><view wx:if="{{!results.length}}" class="card state">当前还没有可播放结果，可下拉刷新状态。</view><view wx:for="{{results}}" wx:key="result_id" class="card"><view class="row"><text class="title grow">结果 {{index+1}}</text><text class="badge">{{item.status_label}}</text></view><video wx:if="{{item.playback_url}}" class="video" src="{{item.playback_url}}" controls enable-progress-gesture></video><text wx:if="{{item.error_message}}" class="meta error">{{item.error_message}}</text><view class="row"><button wx:if="{{item.status==='completed'}}" class="button-secondary grow" data-index="{{index}}" bindtap="play">{{item.playback_url?'刷新播放地址':'播放'}}</button><button wx:if="{{item.playback_url}}" class="button-secondary grow" data-index="{{index}}" bindtap="download">保存相册</button></view><button wx:if="{{item.status==='completed' && !item.retained}}" class="button" data-index="{{index}}" bindtap="retain">保存到创作素材</button><block wx:if="{{item.retained}}"><text class="meta">已稳定留存，可长期使用。</text><button class="button" data-index="{{index}}" bindtap="adoptContent" loading="{{adoptingResultID===item.result_id}}" disabled="{{!!adoptingResultID}}">创建内容草稿</button><text class="meta">插入项目笔记需进入具体项目并选择笔记和位置，当前详情页不自动回填。</text></block></view></view><view wx:if="{{error}}" class="card error">{{error}}</view>
</block></view></block><login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
