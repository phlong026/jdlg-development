<block wx:if="{{__profileAccessMounted}}">
  <navigation-bar class="studio-navigation" title="AI 视频" variant="studio" back="{{true}}" background="#fbfaf7" />
  <view class="page">
    <view class="section first-section">
      <text class="section-title">新建创作</text>
      <view class="grid">
        <view class="card action" data-kind="standard" bindtap="newCreation"><text class="title">文 / 图生视频</text><text class="action-arrow">›</text></view>
        <view class="card action" data-kind="reference" bindtap="newCreation"><text class="title">参考生视频</text><text class="action-arrow">›</text></view>
      </view>
      <view class="workspace-tools">
        <text data-url="/pages/aivideostudio/materials" bindtap="navigate">我的素材</text>
        <view class="tool-divider" />
        <text data-url="/pages/aivideostudio/prompts" bindtap="navigate">我的提示词</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="state">加载中…</view>
    <view wx:elif="{{error}}" class="state error"><text>{{error}}</text><button class="button-secondary" bindtap="load">重试</button></view>
    <block wx:else>
      <text wx:if="{{!capabilities.enabled}}" class="availability-note">生成暂未开放，可继续编辑草稿</text>
      <view class="section">
        <view class="row section-heading"><text class="section-title grow">继续草稿</text><text class="text-link" data-url="/pages/aivideostudio/records?tab=drafts" bindtap="navigate">全部 ›</text></view>
        <view wx:if="{{draftsError}}" class="section-error"><text>{{draftsError}}</text><text class="text-link" bindtap="load">重试</text></view>
        <view wx:elif="{{!drafts.length}}" class="state">暂无草稿</view>
        <view wx:for="{{drafts}}" wx:key="draft_id" class="card" data-id="{{item.draft_id}}" bindtap="openDraft"><text class="title">{{item.name || '未命名创作'}}</text><text class="meta">{{item.mode_label}}</text></view>
      </view>
      <view class="section">
        <view class="row section-heading"><text class="section-title grow">最近任务</text><text class="text-link" data-url="/pages/aivideostudio/records" bindtap="navigate">全部 ›</text></view>
        <view wx:if="{{batchesError}}" class="section-error"><text>{{batchesError}}</text><text class="text-link" bindtap="load">重试</text></view>
        <view wx:elif="{{!batches.length}}" class="state">暂无任务</view>
        <view wx:for="{{batches}}" wx:key="batch_id" class="card" data-id="{{item.batch_id}}" bindtap="openBatch"><view class="row"><text class="title grow">{{item.name || 'AI 视频任务'}}</text><text class="badge">{{item.status_label}}</text></view><text class="meta">{{item.mode_label}} · {{item.created_at_label}}</text></view>
      </view>
    </block>
  </view>
</block>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
