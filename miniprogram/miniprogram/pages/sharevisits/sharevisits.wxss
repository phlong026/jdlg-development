.private-page{min-height:100vh;background:#f7f3ee;color:#30271f;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page-body{width:100%;padding:8rpx 28rpx calc(42rpx + env(safe-area-inset-bottom));box-sizing:border-box}button{margin:0;color:inherit}button::after{border:0}.page-back{width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center}.page-back view{width:24rpx;height:24rpx;border-left:4rpx solid #473720;border-bottom:4rpx solid #473720;transform:rotate(45deg);margin-left:12rpx}
.top-tabs{display:grid;grid-template-columns:repeat(3,1fr);margin-bottom:20rpx}.top-tab{position:relative;height:72rpx;display:flex;align-items:center;justify-content:center;color:#8f8174;font-size:28rpx}.top-tab.active{color:#30271f;font-weight:600}.top-tab.active::after{content:'';position:absolute;left:27%;right:27%;bottom:0;height:5rpx;border-radius:3rpx;background:#a87943}.customer-view-menu{width:48rpx;height:72rpx;margin-right:-20rpx;display:flex;align-items:center;justify-content:center}.down-icon{width:28rpx;height:28rpx;display:flex;align-items:center;justify-content:center;transform:rotate(-90deg);flex:none}
.range-pills{display:flex;justify-content:space-between;gap:8rpx;margin-bottom:16rpx}.range-pill{min-width:0;flex:1;height:56rpx;border:1rpx solid #ddd2c7;border-radius:999rpx;background:rgba(255,255,255,.55);display:flex;align-items:center;justify-content:center;color:#574b40;font-size:23rpx;box-sizing:border-box}.range-pill.active{border-color:#a87943;background:#f5eadc;color:#95612f;font-weight:600}.custom-range{display:flex;align-items:center;gap:8rpx;margin:-4rpx 0 14rpx;padding:10rpx;border:1rpx solid #e5d9cc;border-radius:14rpx;background:#fff;color:#6d5f52;font-size:23rpx}.custom-range picker{min-width:0;flex:1}.custom-range picker view{height:54rpx;border-radius:10rpx;background:#f7f3ee;display:flex;align-items:center;justify-content:center}.custom-range button{width:auto;padding:0 18rpx;background:#a87943;color:#fff;font-size:22rpx}
.customer-filters,.filter-row{display:flex;align-items:center;gap:12rpx;margin-bottom:12rpx}.customer-filters picker,.filter-row picker{flex:none}.intent-select,.range-select,.sort-select,.source-select{height:72rpx;padding:0 18rpx;border:1rpx solid #ded5cb;border-radius:16rpx;background:#fff;display:flex;align-items:center;justify-content:space-between;gap:12rpx;box-sizing:border-box;color:#55483b;font-size:23rpx;line-height:1}.intent-select,.source-select{width:160rpx;padding:0 12rpx;gap:6rpx;font-size:22rpx}.intent-select>text,.source-select>text,.range-select>text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.range-select{min-width:166rpx}.sort-select{min-width:166rpx;font-size:22rpx}.search-box{height:72rpx;min-width:0;flex:1;padding:0 16rpx;border:1rpx solid #ded5cb;border-radius:16rpx;background:#f4f1ed;display:flex;align-items:center;gap:10rpx;box-sizing:border-box}.search-box input{height:72rpx;min-width:0;flex:1;color:#302316;font-size:25rpx;line-height:72rpx}
.state{min-height:250rpx;padding:36rpx;border:1rpx solid #e8dfd3;border-radius:18rpx;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18rpx;color:#6f6255;font-size:27rpx;text-align:center}.state button,.primary{min-width:200rpx;min-height:72rpx;border-radius:12rpx;font-size:26rpx}.primary{background:#a87943;color:#fff}
.visit-card{margin-bottom:12rpx;padding:18rpx 20rpx;border:1rpx solid #eee5da;border-radius:20rpx;background:#fff;box-sizing:border-box}.visit-customer{display:flex;align-items:center;justify-content:space-between;margin-bottom:12rpx}.visit-customer-main{min-width:0;display:flex;align-items:center;gap:14rpx}.customer-avatar{width:68rpx;height:68rpx;border-radius:50%;flex:none}.avatar-fallback{background:#efe3d4;color:#855c34;display:flex;align-items:center;justify-content:center;font-size:26rpx;font-weight:600}.customer-name{max-width:300rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#34291f;font-size:29rpx;font-weight:600}.copy-name{position:relative;width:64rpx;height:64rpx;flex:none}.copy-name view{position:absolute;width:20rpx;height:25rpx;border:3rpx solid #76695c;border-radius:3rpx;box-sizing:border-box}.copy-name view:first-child{left:15rpx;top:12rpx}.copy-name view:last-child{left:23rpx;top:20rpx;background:#fff}.intent,.status{flex:none;padding:6rpx 14rpx;border-radius:12rpx;font-size:21rpx}.intent-high{color:#a35c3f;background:#f7e6de}.intent-medium,.intent-mid{color:#996329;background:#f6ead7}.intent-low{color:#827a72;background:#eeeae5}.status{background:#f3ece3;color:#84613e}
.visit-content{display:flex;align-items:center;gap:18rpx}.visit-cover{position:relative;width:146rpx;height:108rpx;overflow:hidden;border-radius:12rpx;background:#eee4d8;color:#8b6947;display:flex;align-items:center;justify-content:center;flex:none;font-size:22rpx}.visit-cover image{width:100%;height:100%}.media-kind{position:absolute;right:7rpx;bottom:7rpx;width:30rpx;height:30rpx;border-radius:8rpx;background:rgba(48,39,31,.7);color:#fff;display:flex;align-items:center;justify-content:center;font-size:16rpx}.visit-content-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:10rpx}.visit-title{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;color:#33291f;font-size:27rpx;font-weight:600;line-height:1.38}.visit-source{color:#8b7d70;font-size:22rpx}.visit-metrics{margin-top:12rpx;padding-top:12rpx;border-top:1rpx solid #eee6dc;display:flex;align-items:center;justify-content:space-between;gap:12rpx;color:#7d7063;font-size:22rpx}.visit-date{flex:none;color:#9b662f;font-weight:600}.visit-metrics view{min-width:0;text-align:right}.visit-metrics view text:nth-child(2),.visit-metrics view text:last-child{color:#81572f}
.feed-window-note{margin:8rpx 4rpx 14rpx;color:#9b8d80;font-size:20rpx;text-align:center}.feed-window-note view{display:flex;justify-content:center;gap:12rpx;margin-top:6rpx}.feed-window-note button{width:auto;min-height:48rpx;padding:0 14rpx;border:1rpx solid #ded2c5;background:#fff;color:#76593a;font-size:20rpx}
.filter-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin-bottom:14rpx}.filter-select{height:66rpx;padding:0 22rpx;border:1rpx solid #e4d8cb;border-radius:16rpx;background:#fff;display:flex;align-items:center;justify-content:space-between;color:#55483b;font-size:24rpx}.list-caption{display:block;margin:-2rpx 4rpx 18rpx;text-align:right;color:#8b7d6f;font-size:22rpx}.content-filter{margin-bottom:16rpx;padding:14rpx 18rpx;border-radius:12rpx;background:#f0e5d6;color:#76512f;display:flex;align-items:center;justify-content:space-between;font-size:23rpx}.content-filter button{width:auto;padding:4rpx 8rpx;background:transparent;color:#95632f;font-size:22rpx}
.list-card{width:auto;min-width:0;margin-bottom:2rpx;padding:24rpx 4rpx;border-bottom:1rpx solid #e6ddd3;display:flex;align-items:center;gap:18rpx;box-sizing:border-box}.card-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:8rpx}.customer-head,.card-heading{display:flex;align-items:center;gap:12rpx}.title{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#34291f;font-size:29rpx;font-weight:600}.meta,.visit-time{color:#887a6d;font-size:23rpx;line-height:1.5}.metrics{display:flex;gap:22rpx;flex-wrap:wrap;color:#81572f;font-size:25rpx}.chevron{flex:none;color:#a87943;font-size:42rpx}.material-cover,.share-cover{width:170rpx;height:116rpx;border-radius:14rpx;overflow:hidden;background:#eee4d8;color:#8b6947;display:flex;align-items:center;justify-content:center;position:relative;flex:none}.material-cover image,.share-cover image{width:100%;height:100%}.rank{position:absolute;left:0;top:0;min-width:40rpx;padding:4rpx 10rpx;border-radius:0 0 12rpx 0;background:#a87943;color:#fff;text-align:center;font-size:22rpx}.share-cover{width:138rpx;height:104rpx}.load-more{width:100%;min-height:78rpx;margin-top:18rpx;border:1rpx solid #dfd3c6;border-radius:12rpx;background:#fff;color:#76593a;font-size:25rpx}
