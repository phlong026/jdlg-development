.private-page{min-height:100vh;background:#f7f3ee;color:#30271f;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page-body{width:100%;padding:24rpx 28rpx calc(52rpx + env(safe-area-inset-bottom));box-sizing:border-box}button{margin:0;color:inherit}button::after{border:0}
.top-tabs{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1rpx solid #e3dbd1;margin-bottom:20rpx}.top-tab{position:relative;height:76rpx;display:flex;align-items:center;justify-content:center;color:#908277;font-size:28rpx}.top-tab.active{color:#432b18;font-weight:600}.top-tab.active::after{content:'';position:absolute;left:32%;right:32%;bottom:0;height:5rpx;border-radius:3rpx;background:#a87943}
.filter-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin-bottom:14rpx}.filter-row{display:flex;align-items:center;gap:14rpx;margin-bottom:18rpx}.filter-row picker{flex:none}.filter-select,.range-select,.sort-select{height:66rpx;padding:0 22rpx;border:1rpx solid #e4d8cb;border-radius:16rpx;background:#fff;display:flex;align-items:center;justify-content:space-between;gap:18rpx;box-sizing:border-box;color:#55483b;font-size:24rpx}.filter-select{width:100%}.range-select{min-width:156rpx}.sort-select{min-width:164rpx;font-size:22rpx}.search-box{height:66rpx;min-width:0;flex:1;padding:0 20rpx;border:1rpx solid #e4d8cb;border-radius:999rpx;background:#fff;display:flex;align-items:center;gap:10rpx;box-sizing:border-box}.search-box input{min-width:0;flex:1;color:#302316;font-size:25rpx}.search-symbol{color:#9a8d80;font-size:32rpx}.list-caption{display:block;margin:-2rpx 4rpx 18rpx;text-align:right;color:#8b7d6f;font-size:22rpx}.content-filter{margin-bottom:16rpx;padding:14rpx 18rpx;border-radius:12rpx;background:#f0e5d6;color:#76512f;display:flex;align-items:center;justify-content:space-between;font-size:23rpx}.content-filter button{width:auto;padding:4rpx 8rpx;background:transparent;color:#95632f;font-size:22rpx}
.state{min-height:250rpx;padding:36rpx;border:1rpx solid #e8dfd3;border-radius:16rpx;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18rpx;color:#6f6255;font-size:27rpx;text-align:center}.state button,.primary{min-width:200rpx;min-height:72rpx;border-radius:12rpx;font-size:26rpx}.primary{background:#a87943;color:#fff}
.list-card{width:auto;min-width:0;margin-bottom:2rpx;padding:24rpx 4rpx;border-bottom:1rpx solid #e6ddd3;display:flex;align-items:center;gap:18rpx;box-sizing:border-box}.card-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:8rpx}.customer-avatar{width:82rpx;height:82rpx;border-radius:50%;flex:none}.avatar-fallback{background:#efe3d4;color:#855c34;display:flex;align-items:center;justify-content:center;font-size:28rpx;font-weight:600}.customer-head,.card-heading{display:flex;align-items:center;gap:12rpx}.customer-name,.title{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#34291f;font-size:29rpx;font-weight:600}.intent,.status{flex:none;padding:5rpx 12rpx;border-radius:999rpx;font-size:20rpx}.intent-high{color:#a35c3f;background:#f7e6de}.intent-mid{color:#996329;background:#f6ead7}.intent-low{color:#827a72;background:#eeeae5}.status{background:#f3ece3;color:#84613e}.meta,.visit-time{color:#887a6d;font-size:23rpx;line-height:1.5}.metrics{display:flex;gap:22rpx;flex-wrap:wrap;color:#81572f;font-size:25rpx}.chevron{flex:none;color:#a87943;font-size:42rpx}.material-cover,.share-cover{width:170rpx;height:116rpx;border-radius:14rpx;overflow:hidden;background:#eee4d8;color:#8b6947;display:flex;align-items:center;justify-content:center;position:relative;flex:none}.material-cover image,.share-cover image{width:100%;height:100%}.rank{position:absolute;left:0;top:0;min-width:40rpx;padding:4rpx 10rpx;border-radius:0 0 12rpx 0;background:#a87943;color:#fff;text-align:center;font-size:22rpx}.share-cover{width:138rpx;height:104rpx}
.load-more{width:100%;min-height:78rpx;margin-top:18rpx;border:1rpx solid #dfd3c6;border-radius:12rpx;background:#fff;color:#76593a;font-size:25rpx}
