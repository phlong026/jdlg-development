.private-page{min-height:100vh;background:#faf7f5;color:#302316;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}
.page-body{padding:8rpx 30rpx calc(44rpx + env(safe-area-inset-bottom));box-sizing:border-box}
button{margin:0;color:inherit}button::after{border:0}
.page-back{width:72rpx;height:72rpx;margin-left:16rpx;border-radius:16rpx;background:linear-gradient(180deg,#b99065,#a77848);box-shadow:0 6rpx 14rpx #78553720;display:flex;align-items:center;justify-content:center}
.page-back view{width:19rpx;height:19rpx;border-left:4rpx solid #fffaf2;border-bottom:4rpx solid #fffaf2;transform:translateX(4rpx) rotate(45deg)}
.top-tabs{display:grid;grid-template-columns:repeat(3,1fr);margin-bottom:16rpx;border-bottom:1rpx solid #e8ded5}
.top-tab{position:relative;min-height:96rpx;display:flex;align-items:center;justify-content:center;color:#89796b;font-size:32rpx;font-weight:500}
.top-tab.active{color:#342518;font-weight:600}.top-tab.active::after{content:'';position:absolute;left:0;right:0;bottom:-1rpx;height:4rpx;background:#ac7a43}
.customer-view-menu{width:32rpx;height:72rpx;display:flex;align-items:center;justify-content:center}.down-icon{width:26rpx;height:26rpx;display:flex;align-items:center;justify-content:center;transform:rotate(-90deg);flex:none}
.range-pills{display:flex;justify-content:space-between;margin-bottom:28rpx;border-bottom:1rpx solid #e8ded5}
.range-pill{min-width:0;flex:1;min-height:86rpx;display:flex;align-items:center;justify-content:center;color:#786758;font-size:28rpx;border-bottom:3rpx solid transparent;box-sizing:border-box}
.range-pill.active{border-bottom-color:#ac7a43;color:#352518;font-weight:600}
.customer-filters,.filter-row{display:flex;align-items:center;gap:20rpx;margin-bottom:30rpx}.customer-filters picker,.filter-row picker{flex:none}
.intent-select,.range-select,.source-select{height:70rpx;padding:0 20rpx;border:1rpx solid #e0d7cf;border-radius:12rpx;display:flex;align-items:center;justify-content:space-between;gap:10rpx;box-sizing:border-box;font-size:28rpx;color:#746456}
.intent-select,.source-select{width:134rpx;padding:0 14rpx;font-size:26rpx}.intent-select>text,.source-select>text,.range-select>text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.range-select{min-width:178rpx}
.search-box{height:70rpx;min-width:0;flex:1;padding:0 18rpx;border-radius:12rpx;background:#efebe7;display:flex;align-items:center;gap:12rpx;box-sizing:border-box}.search-box input{height:70rpx;min-width:0;flex:1;color:#3b2b1d;font-size:27rpx;line-height:70rpx}
.custom-range{display:flex;align-items:center;gap:12rpx;margin:0 0 20rpx;color:#756456;font-size:25rpx}.custom-range picker{min-width:0;flex:1}.custom-range picker view{padding:12rpx;border:1rpx solid #e0d7cf;border-radius:8rpx}.custom-range button{width:auto;padding:0 18rpx;background:#ab7945;color:#fff;font-size:25rpx}
.state{min-height:250rpx;padding:36rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18rpx;color:#786b60;font-size:28rpx;text-align:center}.state button,.primary{min-width:200rpx;min-height:72rpx;border-radius:12rpx;font-size:28rpx}.primary{background:#ab7945;color:#fff}
.visit-card{padding:24rpx 0 28rpx;border-top:1rpx solid #e8ded5;box-sizing:border-box}.visit-card:first-child{margin-top:8rpx}
.visit-customer{display:flex;align-items:center;gap:20rpx;min-height:82rpx;margin-bottom:6rpx}.customer-avatar{width:84rpx;height:84rpx;flex:none;border-radius:50%}.avatar-fallback{background:#ece2d7;color:#8b735a;display:flex;align-items:center;justify-content:center;font-size:30rpx}
.customer-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#312216;font-size:32rpx;font-weight:600}.visit-customer .customer-name{flex:1}
.visit-content{display:flex;align-items:center;gap:20rpx;margin-left:108rpx}.visit-cover{position:relative;width:216rpx;height:146rpx;border-radius:10rpx;overflow:hidden;background:#eee5db;color:#94785c;display:flex;align-items:center;justify-content:center;flex:none;font-size:25rpx}.visit-cover image{width:100%;height:100%}.media-kind{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:52rpx;height:52rpx;border:2rpx solid #fff;border-radius:50%;background:#37291d55;color:#fff;display:flex;align-items:center;justify-content:center;font-size:26rpx}
.visit-content-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:9rpx}.visit-title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;color:#211a14;font-size:29rpx;font-weight:600;line-height:1.35}.visit-source,.visit-metrics{color:#82705f;font-size:25rpx;line-height:1.4}.visit-metrics{display:block}
.chevron{flex:none;color:#8a7562;font-size:38rpx;font-weight:400}.visit-content>.chevron{align-self:flex-start;line-height:1.1;padding-top:2rpx}
.list-card{display:flex;align-items:center;gap:22rpx;min-width:0;padding:28rpx 0;border-bottom:1rpx solid #e4d9cf;box-sizing:border-box}.card-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:12rpx}.customer-head,.card-heading{display:flex;align-items:center;gap:12rpx}.title{min-width:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;color:#302216;font-size:33rpx;font-weight:600;line-height:1.4}.meta,.visit-time{color:#8b7866;font-size:27rpx;line-height:1.45}
.material-cover{width:248rpx;height:172rpx;border-radius:12rpx;overflow:hidden;background:#eee4d8;color:#94785c;display:flex;align-items:center;justify-content:center;flex:none;font-size:25rpx}.material-cover image{width:100%;height:100%}.material-card{min-height:226rpx}.material-card .meta{white-space:nowrap;font-size:28rpx}.list-caption{display:block;margin:2rpx 0 14rpx;color:#8b7866;font-size:27rpx}
.share-cover{width:160rpx;height:116rpx;overflow:hidden;border-radius:10rpx;background:#eee4d8;flex:none}.share-cover image{width:100%;height:100%}.metrics{display:flex;flex-wrap:wrap;gap:16rpx;color:#806245;font-size:25rpx}.status,.intent{flex:none;padding:6rpx 12rpx;border-radius:8rpx;font-size:22rpx;background:#eee6dc;color:#846342}.intent-high{background:#f6e5dc;color:#a56442}.intent-mid{background:#f4e9d9;color:#996329}
.material-visitor-summary{display:flex;align-items:center;gap:24rpx;padding:28rpx 0 34rpx;border-bottom:1rpx solid #e4d9cf}.material-summary-cover{width:250rpx;height:170rpx;flex:none;border-radius:12rpx;overflow:hidden}.cover-fallback{background:#eee4d8;color:#94785c;display:flex;align-items:center;justify-content:center;font-size:27rpx}.material-summary-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:22rpx}.material-summary-copy .title{font-size:34rpx}.material-summary-copy .meta{font-size:28rpx}
.material-visitor-toolbar{display:flex;align-items:center;justify-content:space-between;padding:28rpx 0;border-bottom:1rpx solid #e4d9cf}.text-link{width:auto;padding:0;color:#a76b2f;background:transparent;font-size:28rpx;line-height:1.4}.material-viewer-row{padding:34rpx 0;min-height:204rpx;gap:24rpx}.material-viewer-row .customer-avatar{width:124rpx;height:124rpx}.material-viewer-row .customer-name{font-size:34rpx}.material-viewer-row .card-copy{gap:7rpx}.material-viewer-row .meta{font-size:28rpx}
.feed-window-note{margin:24rpx 0;color:#938271;font-size:24rpx;text-align:center}.feed-window-note view{display:flex;justify-content:center;gap:18rpx}.feed-window-note button{width:auto;min-height:54rpx;padding:0 14rpx;background:transparent;color:#9c6d3c;font-size:25rpx}
.content-filter{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:22rpx;padding:16rpx 0;border-bottom:1rpx solid #e4d9cf;color:#806245;font-size:25rpx}.content-filter button{width:auto;background:transparent;color:#a76b2f;font-size:25rpx}
.load-more{width:100%;min-height:78rpx;margin-top:26rpx;padding:10rpx 0;background:transparent;color:#8b7866;font-size:28rpx}.material-viewer-page .load-more{margin-top:140rpx}
