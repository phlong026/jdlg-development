.private-page{min-height:100vh;background:#f7f3ee;color:#29221d}.page-body{padding:96rpx 28rpx 52rpx}.intro,.state,.card{margin:18rpx 0;padding:26rpx;border-radius:22rpx;background:#fff}.intro,.meta{font-size:25rpx;color:#776d64;line-height:1.6}.state{text-align:center;display:grid;gap:18rpx}.card{width:100%;display:grid;gap:12rpx;text-align:left;border:1rpx solid #eadfd4}.title{font-size:32rpx;font-weight:650}.metrics{display:flex;gap:28rpx;color:#8b5e3c;font-size:28rpx}button{min-height:82rpx;border-radius:16rpx;font-size:27rpx}button::after{border:0}
