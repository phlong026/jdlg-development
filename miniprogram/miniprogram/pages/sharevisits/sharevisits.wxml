<block wx:if="{{__profileAccessMounted}}">
<view class="private-page">
 <navigation-bar title="{{navigationTitle}}" back="{{false}}" background="#f7f3ee"><view slot="left" class="page-back" bindtap="goBack" role="button" aria-label="返回"><view></view></view></navigation-bar>
 <view class="page-body">
  <view class="top-tabs" role="tablist">
   <view class="top-tab {{activeTab === 'customers' ? 'active' : ''}}" data-tab="customers" bindtap="switchTab" role="tab" aria-selected="{{activeTab === 'customers'}}">客户查看<view class="customer-view-menu" catchtap="chooseCustomerView" role="button" aria-label="切换客户查看方式"><view class="down-icon"><mini-icon name="chevron-left" size="26rpx" color="#a87943" /></view></view></view>
   <view class="top-tab {{activeTab === 'materials' ? 'active' : ''}}" data-tab="materials" bindtap="switchTab" role="tab" aria-selected="{{activeTab === 'materials'}}">素材跟踪</view>
   <view class="top-tab {{activeTab === 'shares' ? 'active' : ''}}" data-tab="shares" bindtap="switchTab" role="tab" aria-selected="{{activeTab === 'shares'}}">分享记录</view>
  </view>

  <block wx:if="{{activeTab === 'customers'}}"><text wx:if="{{projectActivitiesTruncated}}" class="muted">项目摘要按本人项目范围最多展示最近100条每类，完整记录请到项目查看。</text>
   <view class="range-pills"><view wx:for="{{rangeOptions}}" wx:key="*this" class="range-pill {{rangeIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectRange">{{item}}</view></view>
   <view wx:if="{{customRangeOpen}}" class="custom-range"><picker mode="date" value="{{customStartDate}}" bindchange="setCustomStart"><view>{{customStartDate || '开始日期'}}</view></picker><text>至</text><picker mode="date" value="{{customEndDate}}" bindchange="setCustomEnd"><view>{{customEndDate || '结束日期'}}</view></picker><button bindtap="applyCustomRange">应用</button></view>
   <view class="customer-filters"><view class="search-box"><mini-icon name="search" size="30rpx" color="#91877d" /><input value="{{customerQuery}}" bindinput="setCustomerQuery" bindconfirm="reloadCustomerView" confirm-type="search" placeholder="搜索客户名称" aria-label="搜索客户名称" /></view><picker range="{{intentOptions}}" value="{{intentIndex}}" bindchange="selectIntent"><view class="intent-select"><text>{{intentOptions[intentIndex]}}</text><view class="down-icon"><mini-icon name="chevron-left" size="24rpx" color="#8d8175" /></view></view></picker><picker wx:if="{{customerViewMode === 'visits'}}" range="{{sourceOptions}}" value="{{sourceIndex}}" bindchange="selectSource"><view class="source-select"><text>{{sourceOptions[sourceIndex]}}</text><view class="down-icon"><mini-icon name="chevron-left" size="24rpx" color="#8d8175" /></view></view></picker><picker wx:else range="{{sortOptions}}" value="{{sortIndex}}" bindchange="selectSort"><view class="source-select"><text>{{sortOptions[sortIndex]}}</text><view class="down-icon"><mini-icon name="chevron-left" size="24rpx" color="#8d8175" /></view></view></picker></view>
   <block wx:if="{{customerViewMode === 'visits'}}">
    <view class="state" wx:if="{{customerVisitLoading}}" role="status">正在加载查看记录…</view><view class="state" wx:elif="{{customerVisitError}}"><text>{{customerVisitError}}</text><button class="primary" bindtap="reloadCustomerVisits">重试</button></view><view class="state" wx:elif="{{!customerVisits.length}}">近段时间还没有客户查看记录</view>
    <block wx:else>
     <view wx:for="{{customerVisits}}" wx:key="visit_key" class="visit-card" data-index="{{index}}" bindtap="openVisitCustomer" role="button" aria-label="{{'查看客户 ' + item.nickname}}">
      <view class="visit-customer"><view class="visit-customer-main"><image wx:if="{{item.avatar}}" class="customer-avatar" src="{{item.avatar}}" mode="aspectFill" /><view wx:else class="customer-avatar avatar-fallback">客</view><text class="customer-name">{{item.nickname}}</text><view wx:if="{{item.can_copy_name}}" class="copy-name" data-index="{{index}}" catchtap="copyVisitCustomerName" aria-label="复制客户名称"><view></view><view></view></view></view><text wx:if="{{item.intent_text}}" class="intent intent-{{item.intent_level}}">{{item.intent_text}}</text></view>
      <view class="visit-content"><view class="visit-cover"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" data-key="{{item.visit_key}}" binderror="onVisitCoverError" /><text wx:else>内容</text><text wx:if="{{item.media_icon}}" class="media-kind media-kind-{{item.media_kind}}">{{item.media_icon}}</text></view><view class="visit-content-copy"><text class="visit-title">{{item.title}}</text><text class="visit-source">来源：{{item.source_text}}</text></view></view>
      <view class="visit-metrics"><text class="visit-date">{{item.occurred_text}}</text><view><text>{{item.duration_text}}</text><text wx:if="{{item.progress_text}}"> · {{item.progress_text}}</text><text> · {{item.views_text}}</text></view></view>
     </view>
     <button wx:if="{{customerVisitsCursor}}" class="load-more" bindtap="loadMoreCustomerVisits" loading="{{customerVisitLoadingMore}}" disabled="{{customerVisitLoadingMore}}">加载更多</button>
    </block>
   </block>
   <block wx:else>
    <view class="state" wx:if="{{customerLoading}}" role="status">正在加载客户…</view><view class="state" wx:elif="{{customerError}}"><text>{{customerError}}</text><button class="primary" bindtap="reloadCustomers">重试</button></view><view class="state" wx:elif="{{!customers.length}}">还没有客户访问或项目关联记录</view>
    <block wx:else>
     <view wx:for="{{customers}}" wx:key="visitor_key" class="list-card customer-card" data-index="{{index}}" bindtap="openCustomer" role="button" aria-label="{{'查看客户 ' + item.nickname}}"><image wx:if="{{item.avatar}}" class="customer-avatar" src="{{item.avatar}}" mode="aspectFill" /><view wx:else class="customer-avatar avatar-fallback">客</view><view class="card-copy"><view class="customer-head"><text class="customer-name">{{item.nickname || item.visitor_label}}</text><text wx:if="{{item.intent_level === 'high'}}" class="intent intent-high">高意向</text><text wx:elif="{{item.intent_level === 'medium'}}" class="intent intent-mid">中意向</text><text wx:elif="{{item.intent_level === 'low' && item.views}}" class="intent intent-low">低意向</text></view><text class="meta">最近 {{item.last_visit_text}} · {{item.views}} 次 · {{item.duration_text}}</text><text wx:if="{{item.project_activity_count}}" class="meta">{{item.project_activity_count}}条项目动态或关联</text></view><text class="chevron">›</text></view>
     <button wx:if="{{customers_cursor}}" class="load-more" bindtap="loadMoreCustomers" loading="{{customerLoadingMore}}" disabled="{{customerLoadingMore}}">加载更多</button>
    </block>
   </block>
   <view class="feed-window-note"><text>当前为第{{shareWindowIndex + 1}}段分享范围</text><view><button wx:if="{{shareWindowIndex > 0}}" bindtap="previousShareWindow">上一段</button><button wx:if="{{shareWindowNext}}" bindtap="nextShareWindow">更早记录</button><button wx:if="{{shareWindowIndex > 0}}" bindtap="resetShareWindow">返回最新</button></view></view>
  </block>

  <block wx:elif="{{activeTab === 'materials'}}">
   <view class="filter-row"><picker range="{{rangeOptions}}" value="{{rangeIndex}}" bindchange="selectRange"><view class="range-select"><text>{{rangeOptions[rangeIndex]}}</text><view class="down-icon"><mini-icon name="chevron-left" size="24rpx" color="#8d8175" /></view></view></picker><view class="search-box"><mini-icon name="search" size="30rpx" color="#91877d" /><input value="{{materialQuery}}" bindinput="setMaterialQuery" bindconfirm="reloadMaterials" confirm-type="search" placeholder="搜索素材标题" aria-label="搜索素材标题" /></view></view><text class="list-caption">按去重查看人数排序</text>
   <view class="state" wx:if="{{materialLoading}}" role="status">正在加载素材热度…</view><view class="state" wx:elif="{{materialError}}"><text>{{materialError}}</text><button class="primary" bindtap="reloadMaterials">重试</button></view><view class="state" wx:elif="{{!materials.length}}">还没有素材访问记录</view>
   <block wx:else>
    <view wx:for="{{materials}}" wx:key="content_key" class="list-card material-card" data-index="{{index}}" bindtap="openMaterial" role="button" aria-label="{{'查看素材 ' + item.title}}"><view class="material-cover"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" /><text wx:else>素材</text><text wx:if="{{index < 3}}" class="rank">{{index + 1}}</text></view><view class="card-copy"><text class="title">{{item.title || '未命名素材'}}</text><text class="meta">去重查看 {{item.visitor_count}} 人 · 查看 {{item.views}} 次</text><text wx:if="{{item.forwards}}" class="meta">被转发 {{item.forwards}} 次</text></view><text class="chevron">›</text></view>
    <button wx:if="{{materials_cursor}}" class="load-more" bindtap="loadMoreMaterials" loading="{{materialLoadingMore}}" disabled="{{materialLoadingMore}}">加载更多</button>
   </block>
  </block>

  <block wx:else>
   <view class="filter-row"><picker range="{{rangeOptions}}" value="{{rangeIndex}}" bindchange="selectRange"><view class="range-select"><text>{{rangeOptions[rangeIndex]}}</text><view class="down-icon"><mini-icon name="chevron-left" size="24rpx" color="#8d8175" /></view></view></picker><view class="search-box"><mini-icon name="search" size="30rpx" color="#91877d" /><input value="{{shareQuery}}" bindinput="setShareQuery" bindconfirm="reloadShares" confirm-type="search" placeholder="搜索分享标题" aria-label="搜索分享标题" /></view></view>
   <view wx:if="{{contentFilter}}" class="content-filter"><text>{{contentTitle || '已筛选指定素材'}}{{contentVersion ? ' · V' + contentVersion : ''}}</text><button bindtap="clearContentFilter">清除</button></view>
   <view class="state" wx:if="{{loading}}" role="status">正在加载分享记录…</view><view class="state" wx:elif="{{loginRequired}}"><text>登录后查看分享记录</text><button class="primary" bindtap="goLogin">登录</button></view><view class="state" wx:elif="{{denied}}"><text>当前账号无法查看分享记录</text><button bindtap="retry">重新检查</button></view><view class="state" wx:elif="{{error}}"><text>{{error}}</text><button bindtap="retry">重试</button></view><view class="state" wx:elif="{{!items.length}}">暂时没有分享记录</view>
   <block wx:else>
    <view wx:for="{{items}}" wx:key="share_id" class="list-card share-card" data-index="{{index}}" bindtap="openVisits" role="button" aria-label="{{'查看分享记录 ' + item.title}}"><view class="share-cover"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" /><text wx:else>分享</text></view><view class="card-copy"><view class="card-heading"><text class="title">{{item.title || '分享内容'}}</text><text class="status">{{item.status_text}}</text></view><text class="meta">{{item.channel_text}} · {{item.created_at_text}}</text><view class="metrics"><text>{{item.visitor_count}} 位访客</text><block wx:if="{{item.is_collection}}"><text>目录 {{item.directory_views}} 次</text><text>作品 {{item.content_views}} 次</text></block><text wx:else>{{item.page_views}} 次浏览</text></view><text class="visit-time">{{item.has_visits ? '最近访问 ' + item.last_visit_text : '暂无访问'}}</text></view><text class="chevron">›</text></view>
    <button wx:if="{{next_cursor}}" class="load-more" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
   </block>
  </block>
 </view>
</view>
</block>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
