<block wx:if="{{__profileAccessMounted}}">
<view class="page">
  <navigation-bar title="公开造价报告" background="#e6daca" />
  <scroll-view class="public-report" scroll-y>
    <view class="report-card" wx:if="{{loading}}">正在读取分享人公开的报告…</view>
    <view class="report-card" wx:elif="{{error}}">
      <text>{{error}}</text><button bindtap="retry">重试</button>
    </view>
    <block wx:elif="{{result}}">
      <view class="report-card">
        <text class="heading">{{result.totalLabel}}</text><text class="amount">{{result.estimatedTotalCost}}</text>
        <text>{{result.unitLabel}}：{{result.estimatedUnitCost}}</text>
        <text class="notice">分享人已主动公开这份固定快照，链接持有人可查看。有效期30天，内容以本次公开时为准。</text>
      </view>
      <view class="report-card">
        <text class="heading">公开基础信息</text>
        <view class="row" wx:for="{{result.basicInfo}}" wx:key="label"><text>{{item.label}}</text><text>{{item.value}}</text></view>
      </view>
      <view class="report-card">
        <text class="heading">费用参考</text>
        <view wx:for="{{result.costBreakdown}}" wx:key="name">
          <view class="row"><text>{{item.name}}</text><text>{{item.amountText}}</text></view>
          <text class="notice">{{item.estimable ? item.percent + '%' : '需结合图纸核算'}} · {{item.note}}</text>
        </view>
        <text class="notice" wx:for="{{result.dynamicNotes}}" wx:key="*this">{{item}}</text>
        <text class="notice">以上为快速参考估算，最终价格需结合图纸、现场条件和施工范围确认。</text>
      </view>
    </block>
    <button class="start" bindtap="startOwnEstimate">我也测算自己的方案</button>
  </scroll-view>
  <nickname-guard id="nicknameGuard" />
</view>
</block>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
