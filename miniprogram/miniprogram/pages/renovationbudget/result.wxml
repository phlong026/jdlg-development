<block wx:if="{{__profileAccessMounted}}">
<view class="page">
  <navigation-bar title="报价报告" background="#e6daca" custom-back="{{true}}" bind:back="onReturnModify" />
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="context-bar" wx:if="{{report}}"><view class="context-info"><text>{{record.input.province}} / {{record.input.city}} · {{record.input.area}}㎡</text><text>{{record.input.houseType === 'new' ? '新房' : '旧房'}}</text><picker mode="selector" range="{{standardOptions}}" range-key="name" value="{{record.input.standard === 'economy' ? 0 : record.input.standard === 'quality' ? 2 : 1}}" disabled="{{saving}}" bindchange="onStandardChange"><text>{{record.input.standard === 'economy' ? '经济型' : record.input.standard === 'quality' ? '品质型' : '标准型'}}⌄</text></picker></view><quote-type-switch kind="renovation" /></view>
    <view class="state-card" wx:if="{{loading}}"><text class="state-title">正在读取报价</text></view>
    <view class="state-card" wx:elif="{{error}}"><text class="state-title">报价暂时无法打开</text><text class="state-copy">{{error}}</text><view class="state-actions"><button class="secondary" bindtap="onRetry">重试</button><button class="primary" bindtap="onReturnModify">返回修改</button></view></view>
    <block wx:elif="{{report}}">
      <renovation-report report="{{report}}" readonly="{{false}}" details-expanded="{{showCostDetails}}" bind:itemedit="onItemEdit" bind:feesedit="onFeesEdit" bind:parametersedit="onParametersEdit" />
      <view class="bottom-actions"><button class="secondary" bindtap="toggleCostDetails">{{showCostDetails ? '收起费用明细' : '查看费用明细'}}</button><button class="primary" bindtap="onContactDesigner">联系设计师</button></view>
      <button class="share-button" loading="{{sharing}}" disabled="{{sharing}}" bindtap="onShareReport">⇧ 分享报告</button>
      <view class="hint">参考估算，以实际方案为准</view>
    </block>
    <view class="bottom-space"></view>
  </scroll-view>

  <view class="mask" wx:if="{{itemDrawerVisible}}" bindtap="closeDrawers"><view class="drawer" catchtap="stopPropagation">
    <view class="drawer-head"><view><text class="drawer-title">{{editingItem.name}}</text></view><text bindtap="closeDrawers">×</text></view>
    <checkbox-group bindchange="onItemIncludedChange"><label class="include-row"><checkbox value="included" checked="{{editingIncluded}}" color="#b98f5c"/><text>计入报价</text></label></checkbox-group>
    <text class="field-label">工程量</text><view class="input-field"><input type="digit" value="{{editingQuantity}}" bindinput="onItemQuantityInput"/><text>{{editingItem.unit}}</text></view>
    <view class="readonly-row"><text>主材单价</text><text>{{editingItem.materialUnitPrice}} 元/{{editingItem.unit}}</text></view><view class="readonly-row"><text>人工/辅材单价</text><text>{{editingItem.laborAuxUnitPrice}} 元/{{editingItem.unit}}</text></view>
    <view class="drawer-actions"><button class="secondary" bindtap="closeDrawers">取消</button><button class="primary" loading="{{saving}}" bindtap="confirmItemEdit">确认</button></view>
  </view></view>

  <view class="mask" wx:if="{{feeDrawerVisible}}" bindtap="closeDrawers"><view class="drawer" catchtap="stopPropagation">
    <view class="drawer-head"><text class="drawer-title">附加费用</text><text bindtap="closeDrawers">×</text></view>
    <checkbox-group bindchange="onFeeChange"><label class="fee-option" wx:for="{{feeRows}}" wx:key="id"><view><checkbox value="{{item.id}}" checked="{{item.included}}" color="#b98f5c"/><text>{{item.name}} {{item.rate}}</text></view><text>{{item.included ? '已计入' : '未计入'}}</text></label></checkbox-group>
    <button class="primary wide" loading="{{saving}}" bindtap="confirmFees">确认</button>
  </view></view>

  <view class="mask" wx:if="{{parameterDrawerVisible}}" bindtap="closeDrawers"><view class="drawer" catchtap="stopPropagation">
    <view class="drawer-head"><text class="drawer-title">调整房屋参数</text><text bindtap="closeDrawers">×</text></view>
    <view class="parameter-grid"><view wx:for="{{parameterFields}}" wx:key="field"><text class="field-label">{{item.label}}</text><view class="input-field"><input type="digit" value="{{parameterDraft[item.field]}}" data-field="{{item.field}}" bindinput="onParameterInput"/><text>{{item.unit}}</text></view></view></view>
    <view class="drawer-actions"><button class="secondary" bindtap="closeDrawers">取消</button><button class="primary" loading="{{saving}}" bindtap="confirmParameters">重新测算</button></view>
  </view></view>
</view>
</block>
<login-guard id="profileAccessGuard" bind:authenticated="onProfileAccessGranted" bind:gated="onProfileAccessBlocked" />
