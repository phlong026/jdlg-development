<view class="tabbar-shell">
  <view class="tabbar">
    <image class="tabbar-background {{current == 0 ? 'tabbar-background--active' : ''}}" src="{{homeTabbarImage}}" mode="scaleToFill" />
    <image class="tabbar-background {{current == 1 ? 'tabbar-background--active' : ''}}" src="{{templateTabbarImage}}" mode="scaleToFill" />
    <image class="tabbar-background {{current == 2 ? 'tabbar-background--active' : ''}}" src="{{designerTabbarImage}}" mode="scaleToFill" />
    <image class="tabbar-background {{current == 3 ? 'tabbar-background--active' : ''}}" src="{{myTabbarImage}}" mode="scaleToFill" />

    <view class="tabbar-hitbox-layer">
      <view
        class="tabbar-hitbox"
        wx:for="{{tabs}}"
        wx:key="index"
        bindtap="switchTab"
        data-index="{{item.index}}"
        role="button"
        aria-label="{{item.index === 3 ? '我的' : item.text}}"
      ></view>
    </view>
  </view>
</view>
