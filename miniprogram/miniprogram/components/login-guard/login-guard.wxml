<import src="/templates/auth-welcome.wxml" />
<scroll-view hidden="{{!loggingIn && !completingProfile && (!visible || checking)}}" class="login-guard-panel" scroll-y="{{true}}">
  <template is="auth-backdrop" />
  <view class="aw-content">
    <template is="auth-intro" />
    <view wx:if="{{!completingProfile}}" class="login-guard aw-card" catchtap="stopPropagation">
      <text class="lg-title">{{needsLogin ? '登录后查看完整内容' : '重新连接，继续发现好设计'}}</text>
      <text class="lg-sub">发现户型、案例、报价与设计灵感</text>
      <template is="auth-avatars" />
      <text wx:if="{{error}}" class="lg-error">{{error}}</text>
      <button wx:if="{{!checking && needsLogin}}" class="lg-login {{loggingIn ? 'lg-login-disabled' : ''}}" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="onWxLogin">
        <view class="lg-login-inner">
          <image class="lg-wx-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
          <text>{{loggingIn ? '登录中...' : '微信一键登录'}}</text>
        </view>
      </button>
      <button wx:if="{{!checking && !needsLogin}}" class="lg-login lg-login-plain" bindtap="onRetry">重新检查资料</button>
      <view wx:if="{{needsLogin && !checking}}" class="lg-agreement">
        <view class="lg-check {{agreedPrivacy ? 'lg-check-on' : ''}}" catchtap="onTogglePrivacy" catchtouchmove="true">
          <text wx:if="{{agreedPrivacy}}" class="lg-check-mark">✓</text>
        </view>
        <text class="lg-agreement-text">我已阅读并同意</text>
        <text class="lg-link" catchtap="onOpenPrivacy">《用户协议与隐私政策》</text>
      </view>
    </view>
    <view class="lg-profile-card" hidden="{{!completingProfile}}">
      <nickname-guard id="nicknameGuard" embedded="{{true}}" bind:completed="onProfileCompleted" bind:authrequired="onProfileAuthRequired" />
    </view>
  </view>
</scroll-view>
