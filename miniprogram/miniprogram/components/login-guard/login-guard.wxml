<import src="/templates/auth-welcome.wxml" />
<!-- 资料核验沿用业务页底色与导航尺寸，避免先闪现完整登录品牌画面。 -->
<view wx:if="{{checking}}" class="profile-loading-shell">
  <navigation-bar background="#fbfaf7" back="{{false}}" />
  <view class="profile-loading-body" role="status"><view class="lg-spinner"></view><text>正在加载…</text></view>
</view>
<scroll-view hidden="{{!visible && !loggingIn && !completingProfile}}" class="login-guard-panel" scroll-y="{{true}}">
  <template is="auth-backdrop" />
  <view class="aw-content">
    <template is="auth-intro" data="{{motto: '乡村住宅AI设计与协作平台', headline: '建别墅'}}" />
    <view wx:if="{{!completingProfile}}" class="login-guard aw-card" catchtap="stopPropagation">
      <!-- 审核要求：登录环节提供显著的可取消/拒绝按钮 -->
      <view class="lg-close" catchtap="onDismiss" hover-class="lg-close-active">
        <text class="lg-close-icon">✕</text>
      </view>
      <text class="lg-title">{{needsLogin ? '免费开启您的理想家' : '重新连接，继续发现好设计'}}</text>
      <text class="lg-sub">海量乡墅案例 · AI设计体验 · 建房造价测算</text>
      <text wx:if="{{error}}" class="lg-error">{{error}}</text>
      <button wx:if="{{!checking && needsLogin}}" class="lg-login {{loggingIn ? 'lg-login-disabled' : ''}}" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="onWxLogin">
        <view class="lg-login-inner">
          <image class="lg-wx-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
          <text>{{loggingIn ? '登录中...' : '微信一键登录'}}</text>
        </view>
      </button>
      <button wx:if="{{!checking && !needsLogin}}" class="lg-login lg-login-plain" bindtap="onRetry">重新检查资料</button>
      <template is="auth-avatars" data="{{communityCopy: '一起开启理想家的设计之旅'}}" />
      <view wx:if="{{needsLogin && !checking}}" class="lg-agreement">
        <view class="lg-check {{agreedPrivacy ? 'lg-check-on' : ''}}" catchtap="onTogglePrivacy" catchtouchmove="true">
          <text wx:if="{{agreedPrivacy}}" class="lg-check-mark">✓</text>
        </view>
        <text class="lg-agreement-text">我已阅读并同意</text>
        <text class="lg-link" catchtap="onOpenPrivacy">《用户协议与隐私政策》</text>
      </view>
      <!-- 暂不登录：公开页关闭浮层继续浏览，功能页返回上一页 -->
      <view wx:if="{{!loggingIn}}" class="lg-skip" catchtap="onDismiss" hover-class="lg-skip-active">
        <text>暂不登录，先逛逛</text>
      </view>
    </view>
    <view class="lg-profile-card" hidden="{{!completingProfile}}">
      <view class="lg-profile-head">
        <text class="lg-title">{{nicknameOnly ? '补充昵称后继续' : '补充头像和昵称后继续'}}</text>
        <text class="lg-sub">{{nicknameOnly ? '账号仍在登录状态，填好昵称即可返回当前页面继续使用' : '账号仍在登录状态，完善资料即可返回当前页面继续使用'}}</text>
      </view>
      <view class="lg-later" catchtap="onDismiss" hover-class="lg-skip-active">
        <text>稍后补充，继续浏览</text>
      </view>
      <nickname-guard id="nicknameGuard" embedded="{{true}}" bind:completed="onProfileCompleted" bind:authrequired="onProfileAuthRequired" />
    </view>
  </view>
</scroll-view>
