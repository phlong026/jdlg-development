<view wx:if="{{visible && !completingProfile}}" class="login-guard-panel" catchtouchmove="stopPropagation">
  <view class="lg-fade"></view>
  <view class="login-guard" catchtap="stopPropagation">
    <view class="lg-grip"></view>
    <view class="lg-brand"><text class="lg-brand-name">甲第灵光</text><text class="lg-brand-badge">乡建智能体</text></view>
    <text class="lg-title">登录后查看完整内容</text>
    <text class="lg-sub">已登录用户可查看户型、案例、报价、设计方案等全部内容</text>
    <text wx:if="{{error}}" class="lg-error">{{error}}</text>
    <button wx:if="{{!checking && needsLogin}}" class="lg-login" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="onWxLogin">
      <view class="lg-login-inner">
        <image class="lg-wx-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
        <text>{{loggingIn ? '登录中...' : '微信一键登录'}}</text>
      </view>
    </button>
    <button wx:if="{{!checking && !needsLogin}}" class="lg-login lg-login-plain" bindtap="onRetry">重新检查资料</button>
    <view wx:if="{{needsLogin && !checking}}" class="lg-agreement">
      <view class="lg-check {{agreedPrivacy ? 'lg-check-on' : ''}}" catchtap="onTogglePrivacy" catchtouchmove="true">
        <text wx:if="{{agreedPrivacy}}" class="lg-check-mark">✓</text>
      </view>
      <text class="lg-agreement-text">我已阅读并同意</text>
      <text class="lg-link" catchtap="onOpenPrivacy">《用户协议与隐私政策》</text>
    </view>
  </view>
</view>

<nickname-guard id="nicknameGuard" bind:completed="onProfileCompleted" bind:authrequired="onProfileAuthRequired" />
