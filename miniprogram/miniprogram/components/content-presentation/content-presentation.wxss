.content-presentation {
  color: #2c2723;
}

.presentation-media {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #f1efec;
}

.presentation-gallery,
.presentation-video-shell {
  display: flex;
  align-items: center;
  justify-content: center;
}

.content-video {
  overflow: hidden;
  border-radius: 14px;
  background: #fff;
}

.presentation-video-brand {
  display: flex;
  min-height: 46px;
  align-items: center;
  gap: 8px;
  padding: 0 14px;
  color: #332a24;
  font-size: 13px;
  font-weight: 600;
}

.presentation-video-brand-mark {
  display: flex;
  width: 25px;
  height: 25px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #a87943;
  color: #fff;
  font-family: serif;
  font-size: 12px;
}

.presentation-video-brand-type {
  margin-left: auto;
  color: #968a7e;
  font-size: 11px;
  font-weight: 400;
}

.presentation-video-shell {
  background: #111;
}

.presentation-video-poster {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111;
}

.presentation-video-poster image {
  width: 100%;
  height: 100%;
}

.presentation-video-play {
  position: absolute;
  display: flex;
  width: 52px;
  height: 52px;
  align-items: center;
  justify-content: center;
  padding-left: 3px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.58);
  color: #fff;
  font-size: 22px;
}

.presentation-gallery swiper {
  width: 100%;
}

.presentation-gallery-slide {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
}

.presentation-gallery-image,
.presentation-video,
.presentation-article-image,
.presentation-article-video {
  display: block;
  background: #f1efec;
}

.presentation-gallery-count {
  position: absolute;
  z-index: 2;
  top: 12px;
  right: 12px;
  min-width: 38px;
  padding: 4px 9px;
  border-radius: 999px;
  background: rgba(29, 26, 24, .68);
  color: #fff;
  font-size: 12px;
  line-height: 18px;
  text-align: center;
}

.presentation-note-copy {
  padding: 20px 2px 4px;
}

.presentation-video-copy {
  padding: 18px 16px 16px;
}

.content-video-douyin {
  background: #111;
  color: #fff;
}

.content-video-douyin .presentation-video-brand {
  color: #fff;
}

.content-video-douyin .presentation-video-brand-type,
.content-video-douyin .presentation-meta {
  color: rgba(255, 255, 255, .62);
}

.content-video-douyin .presentation-video-copy {
  border-top: 1px solid rgba(255, 255, 255, .08);
}

.presentation-article-header {
  padding: 24px 0 12px;
}

.presentation-title {
  font-size: 23px;
  font-weight: 700;
  line-height: 1.42;
}

.presentation-body {
  display: block;
  margin-top: 12px;
  white-space: pre-wrap;
  font-size: 16px;
  line-height: 1.75;
}

.content-video .presentation-body {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.content-video .presentation-body.is-expanded {
  display: block;
  overflow: visible;
}

.presentation-copy-toggle {
  width: auto;
  min-height: 32px;
  margin: 8px 0 0;
  padding: 0;
  background: transparent;
  color: #8c5e32;
  font-size: 13px;
  line-height: 32px;
}

.content-video-douyin .presentation-copy-toggle {
  color: #e4c7a7;
}

.presentation-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 10px;
  margin-top: 12px;
  color: #92877d;
  font-size: 12px;
  line-height: 1.6;
}

.presentation-media-caption {
  display: block;
  padding: 9px 2px 0;
  color: #756e67;
  font-size: 13px;
  line-height: 1.6;
  text-align: center;
}

.presentation-article-media {
  max-width: 100%;
  margin: 20px 0;
}

.presentation-article-image,
.presentation-article-video {
  width: 100%;
}

.presentation-media-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px;
  background: #fff2f0;
  color: #a83227;
  font-size: 13px;
}

.presentation-media-error button {
  width: auto;
  min-height: 32px;
  flex: none;
  margin: 0;
  padding: 0 12px;
  border: 1px solid #d7c0a5;
  background: #fff;
  color: #8c5e32;
  font-size: 12px;
}
