.content-presentation {
  color: #2c2723;
}

.presentation-media {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #f1efec;
}

.presentation-gallery,
.presentation-video-shell {
  display: flex;
  align-items: center;
  justify-content: center;
}

.presentation-gallery swiper {
  width: 100%;
}

.presentation-gallery-slide {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
}

.presentation-gallery-image,
.presentation-video,
.presentation-article-image,
.presentation-article-video {
  display: block;
  background: #f1efec;
}

.presentation-gallery-count {
  position: absolute;
  z-index: 2;
  top: 12px;
  right: 12px;
  min-width: 38px;
  padding: 4px 9px;
  border-radius: 999px;
  background: rgba(29, 26, 24, .68);
  color: #fff;
  font-size: 12px;
  line-height: 18px;
  text-align: center;
}

.presentation-note-copy {
  padding: 20px 2px 4px;
}

.presentation-article-header {
  padding: 24px 0 12px;
}

.presentation-title {
  font-size: 23px;
  font-weight: 700;
  line-height: 1.42;
}

.presentation-body {
  display: block;
  margin-top: 12px;
  white-space: pre-wrap;
  font-size: 16px;
  line-height: 1.75;
}

.presentation-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 10px;
  margin-top: 12px;
  color: #92877d;
  font-size: 12px;
  line-height: 1.6;
}

.presentation-media-caption {
  display: block;
  padding: 9px 2px 0;
  color: #756e67;
  font-size: 13px;
  line-height: 1.6;
  text-align: center;
}

.presentation-article-media {
  max-width: 100%;
  margin: 20px 0;
}

.presentation-article-image,
.presentation-article-video {
  width: 100%;
}

.presentation-media-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px;
  background: #fff2f0;
  color: #a83227;
  font-size: 13px;
}

.presentation-media-error button {
  width: auto;
  min-height: 32px;
  flex: none;
  margin: 0;
  padding: 0 12px;
  border: 1px solid #d7c0a5;
  background: #fff;
  color: #8c5e32;
  font-size: 12px;
}
