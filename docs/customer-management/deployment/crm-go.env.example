# Merge into the existing Go configuration. Do not replace original settings.
# Go and Java run on the same host in this example.
CRM_BRIDGE_URL=http://127.0.0.1:18087
CRM_BRIDGE_KEY=REPLACE_WITH_SAME_RANDOM_KEY_AS_JAVA_AT_LEAST_32_CHARACTERS
CRM_BRIDGE_KEY_ID=v1
CRM_BRIDGE_AUDIENCE=jd-crm-production
CRM_ALLOWED_ORIGINS=https://REPLACE_ACTUAL_ADMIN_DOMAIN

# 2026-09-16 新增：后台 CORS 白名单（跨源携带凭据只回显白名单内 Origin）。
# 同源部署时浏览器不带 Origin，本项可不配置；分域部署时与 CRM_ALLOWED_ORIGINS 合并生效。
ADMIN_ALLOWED_ORIGINS=https://REPLACE_ACTUAL_ADMIN_DOMAIN
# 企微事件转发 CRM 的开关（转发目标取 CRM_BRIDGE_URL + /iycallback/handle）；
# 仅在报告企微交付与 CRM 不再共用同一回调入口时才设为 false。
CRM_EVENT_FORWARD_ENABLED=true

# Production uses HTTPS and secure HttpOnly cookies when the bridge is enabled.
# 2026-09-16 起：非 development 环境若 SESSION_SECRET 少于 32 字符，Go 将拒绝启动。
SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
# Only needed when the platform database has no admin account yet.
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_INDEPENDENT_PASSWORD_12_TO_72_BYTES
