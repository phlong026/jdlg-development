# Example only. Replace placeholders before configuring the BaoTa Java project.
# A plain java -jar command does NOT automatically load this file.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18087
CRM_DB_URL=jdbc:mysql://127.0.0.1:3306/REPLACE_CRM_DATABASE?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
CRM_DB_USER=REPLACE_CRM_DATABASE_USER
CRM_DB_PASSWORD=REPLACE_DATABASE_PASSWORD
CRM_DEMO=false
CRM_STANDALONE_ENABLED=false
CRM_SECURE_COOKIE=true
CRM_ADMIN_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_PASSWORD
CRM_BRIDGE_KEY=REPLACE_WITH_SAME_RANDOM_KEY_AS_GO_AT_LEAST_32_CHARACTERS
CRM_BRIDGE_KEY_ID=v1
CRM_BRIDGE_AUDIENCE=jd-crm-production
# false during migration checks; set true and restart BEFORE initial sync.
CRM_JOBS_ENABLED=false
WECOM_CORP_ID=REPLACE_REAL_CORP_ID
WECOM_CONTACT_SECRET=REPLACE_CUSTOMER_CONTACT_SECRET
WECOM_CALLBACK_TOKEN=REPLACE_CALLBACK_TOKEN
WECOM_CALLBACK_AES_KEY=REPLACE_WITH_43_CHARACTER_ENCODING_AES_KEY

# Optional app messages. Keep disabled until real-app receipt verification.
WECOM_NOTIFY_ENABLED=false
WECOM_NOTIFY_AGENT_ID=0
WECOM_NOTIFY_SECRET=
