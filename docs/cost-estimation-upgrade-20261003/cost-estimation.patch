+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+const path = require('node:path');
+const source = fs.readFileSync(path.join(__dirname, '../miniprogram/pages/aicost/aicost.js'), 'utf8');
+function form(overrides = {}, storageFails = false) {
+  let config, saved, toast, route;
+  vm.runInNewContext(source, { Page: p => { config = p; }, wx: {
+    showToast: p => { toast = p.title; },
+    setStorageSync: (key, value) => { if (storageFails) throw new Error('storage full'); saved = value; },
+    navigateTo: p => { route = p.url; },
+  }, console: { error() {} } });
+  const page = { ...config, data: { ...config.data, footprintArea: '120', buildingArea: '320', ...overrides },
+    setData(values) { Object.assign(this.data, values); } };
+  page.onEstimateCost();
+  return { page, saved, toast, route };
+}
+const normal = form();
+assert.equal(normal.saved.version, 2);
+assert.equal(normal.saved.estimatedTotalCost, '58.36万元');
+assert.equal(normal.saved.estimatedUnitCost, '1823.75元/㎡');
+assert.deepEqual(Array.from(normal.saved.costBreakdown, i => i.amount), [78000, 235200, 59200, 60800, 137600, 12800]);
+assert.equal(normal.saved.basicInfo.length, 14);
+assert.equal(normal.route, '/pages/aicostresult/aicostresult');
+normal.page.data.buildingArea = '999';
+assert.equal(normal.saved.basicInfo.find(i => i.label === '总建筑面积').value, '320㎡');
+assert.equal(form({ foundationType: '条形基础' }).saved.costBreakdown[0].amount, 130000);
+assert.equal(form({ foundationType: '筏板基础' }).saved.costBreakdown[0].amount, 78000);
+assert.equal(form({ roofType: '燕尾脊' }).saved.costBreakdown[2].amount, 64838);
+for (const [structureType, price] of [['砖混结构',685], ['框架结构',735], ['钢结构',830]]) {
+  assert.equal(form({ structureType }).saved.costBreakdown[1].amount, 320 * price);
+}
+for (const [roofType, price] of [['平屋顶',105], ['组合屋顶',145], ['坡屋顶',185]]) {
+  assert.equal(form({ roofType }).saved.costBreakdown[2].amount, 320 * price);
+}
+for (const [facadeStyle, price] of [['涂料外墙',430], ['真石漆',430], ['陶瓷砖外墙',450], ['石材外墙',750], ['铝板/金属外立面',750]]) {
+  assert.equal(form({ facadeStyle }).saved.costBreakdown[4].amount, 320 * price);
+}
+assert.equal(form({ windowStandard: '系统窗高档' }).saved.costBreakdown[3].amount, 80000);
+assert.equal(form({ city: '上海', buildingStyle: '欧式', basementType: '全地下室', decorationStyle: '品质型' }).saved.estimatedTotalCost, normal.saved.estimatedTotalCost);
+const pile = form({ foundationType: '桩基础' }).saved;
+assert.equal(pile.totalLabel, '已测算部分合计');
