# 仅本地 Docker 联调使用，不含任何线上凭据。
# dev.sh 通过 JDLG_LOCAL_ENV_FILE 指向本文件，因此 service/.env.local（可能含真实密钥）不会被加载。
# 微信支付、虚拟支付、COS、AI 供应商、企微等一律不配置：相关功能在本地走"未配置"分支，不会产生任何线上副作用。
MYSQL_DSN=root:jdlg_local_only@tcp(127.0.0.1:13306)/jiadilinguang?charset=utf8mb4&parseTime=True&loc=Local
REDIS_ADDR=127.0.0.1:16379
SESSION_SECRET=local-dev-only-session-secret-0123456789abcdef
ENV=development
HTTP_ADDR=127.0.0.1:28180
