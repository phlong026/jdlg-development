# 环境变量示例：复制后填入实际值（服务从环境变量读取）
# 部署时在系统/容器中设置以下变量即可
# 本地启动自动读取 service 工作目录或可执行文件目录的 .env.local。
# 可通过 JDLG_LOCAL_ENV_FILE 指定文件；已有进程环境变量优先，文件不支持 shell 展开。
# .env.local 不入库，应设置为仅当前用户可读写（chmod 600）。

# ----- 微信小程序（登录、邀请海报小程序码） -----
WECHAT_APPID=
WECHAT_APPSECRET=

# ----- 企业微信高清图下载配置 -----
ENTERPRISE_WECHAT_DOWNLOAD_4K_QRCODE_URL=
ENTERPRISE_WECHAT_DOWNLOAD_4K_TIP=完成手机号授权验证后，可下载保存高清原图。
# 继续沿用线上现有二维码配置，如需替换再填写新的二维码图片地址
ENTERPRISE_WECHAT_SERVICE_PHONE=13959877676
ENTERPRISE_WECHAT_CUSTOMER_SERVICE_CORP_ID=ww673b3a4edf114110
ENTERPRISE_WECHAT_CUSTOMER_SERVICE_URL=https://work.weixin.qq.com/kfid/kfccb23bfff32bc9c6f

# ----- AI 接口密钥配置 -----
LAOZHANG_API_KEY=
# 主生图网关和模型；默认使用 GPT-Image-2 VIP
LAOZHANG_IMAGE_BASE_URL=https://api2.laozhang.ai
LAOZHANG_IMAGE_MODEL=gpt-image-2-vip
ARK_API_KEY=
# 视频生成默认走火山引擎方舟（豆包 Seedance 1.5 Pro）
# 如需切回老张平台 Veo，将 PROVIDER 改为 laozhang，并对应调整 BASE_URL 与 MODEL
AI_VIDEO_PROVIDER=ark_seedance
AI_VIDEO_API_BASE_URL=https://ark.cn-beijing.volces.com
AI_VIDEO_MODEL=doubao-seedance-1-5-pro-251215

# ----- FastGPT 建规快查配置 -----
# FastGPT 服务地址（宝塔 Docker 部署默认 http://127.0.0.1:3000）
FASTGPT_BASE_URL=http://127.0.0.1:3000
# FastGPT 应用 API Key（在 FastGPT 后台 → 应用 → API访问 中创建）
FASTGPT_API_KEY=
# FastGPT 知识库 ID（在 FastGPT 后台 → 知识库 → URL 中获取）
FASTGPT_DATASET_ID=
# 会话 ID 前缀，用于区分不同业务场景，默认 building-code
FASTGPT_CHAT_ID_PREFIX=building-code

# ----- 其他常用配置 -----
# MYSQL_DSN=root:@tcp(127.0.0.1:3306)/jiadilinguang?charset=utf8mb4&parseTime=True&loc=Local
# REDIS_ADDR=127.0.0.1:6379
# REDIS_PASSWORD=
# HTTP_ADDR=:8080
# 管理端会话签名密钥：非开发环境必须配置，至少 32 字符的独立强随机值（否则服务拒绝启动）
# SESSION_SECRET=
# 环境标识：生产必须显式设置为 production（影响会话密钥强校验与安全警告级别）
# ENV=production

# ----- 端侧加密密钥（重要：与小程序端共享，切换必须双端同步发版） -----
# 未配置时服务使用代码内置默认密钥，token 加解密与请求验签可被公开代码推导；服务器部署前必须完成配置。
# SM4_KEY 需 16 字节（或其 Base64 编码）；SM2_PRIVATE_KEY 为十六进制私钥。
# 生产切换步骤：1) 生成新密钥 2) 服务端配置 3) 小程序端同步更新并发版 4) 观察旧版本小程序衰减为零
# SM4_KEY=
# SM2_PRIVATE_KEY=
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_REGION=ap-chongqing
# COS_BUCKET=
# COS_PREFIX=ai_assets/

# ----- 腾讯云短信（手机号注册/登录验证码） -----
# 以下 5 项均为必填，留空则退化为开发模式（只在日志打印验证码，不发真实短信）
# TENCENT_SMS_SECRET_ID=        # 腾讯云 API SecretId
# TENCENT_SMS_SECRET_KEY=       # 腾讯云 API SecretKey
# TENCENT_SMS_SDK_APP_ID=       # 短信应用 SdkAppId（14 开头的数字串）
# TENCENT_SMS_SIGN_NAME=        # 已审核通过的短信签名，如：甲第灵光
# TENCENT_SMS_TEMPLATE_ID=      # 已审核通过的模板 ID，模板需含 2 个占位符：{1}=验证码 {2}=有效分钟数
# TENCENT_SMS_EXPIRE_MINUTES=5  # 验证码有效期（分钟），默认 5
