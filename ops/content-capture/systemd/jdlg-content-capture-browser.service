[Unit]
Description=JDLG isolated content capture browser
Requires=jdlg-content-capture-network.service
After=jdlg-content-capture-network.service
Before=jdlg-content-capture-worker.service

[Service]
Type=simple
User=jdlgcap-browser
Group=jdlgcap-browser
RuntimeDirectory=jdlg-content-capture-browser
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
Environment=HOME=/run/jdlg-content-capture-browser
Environment=XDG_CONFIG_HOME=/run/jdlg-content-capture-browser
NetworkNamespacePath=/run/netns/jdlg-content-capture
BindReadOnlyPaths=/etc/netns/jdlg-content-capture/resolv.conf:/etc/resolv.conf
ExecStart=/opt/jdlg-content-capture/browser/chrome-headless-shell-linux64/chrome-headless-shell --headless --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 --remote-allow-origins=http://localhost/ --user-data-dir=/run/jdlg-content-capture-browser/profile --no-first-run --no-default-browser-check --disable-background-networking --disable-sync --metrics-recording-only
Restart=on-failure
RestartSec=2s
TimeoutStartSec=20s
TimeoutStopSec=10s
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
InaccessiblePaths=/www
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
NoNewPrivileges=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=768M
TasksMax=256
CPUQuota=150%
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
